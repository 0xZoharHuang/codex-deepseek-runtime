+        .is_some_and(|ext| ext.eq_ignore_ascii_case("exe"));
+    if path.is_absolute() && is_exe {
+        let mut units = wide(program)?;
+        units.push(0);
+        return Ok(units);
+    }
+    // These callers use only native images. In particular, never apply shell
+    // or PATHEXT lookup rules to the marketplace's bare `git` program name.
+    if path.file_name() != Some(program)
