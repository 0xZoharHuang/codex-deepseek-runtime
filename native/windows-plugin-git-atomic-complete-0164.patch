+fn system_directory(get: unsafe extern "system" fn(*mut u16, u32) -> u32) -> Option<PathBuf> {
+    let mut units = vec![0; 260];
+    loop {
+        // SAFETY: The buffer is writable for the supplied capacity.
+        let size = unsafe { get(units.as_mut_ptr(), units.len() as u32) } as usize;
+        if size == 0 || size > 32768 {
+            return None;
+        }
+        if size < units.len() {
+            return Some(PathBuf::from(OsString::from_wide(&units[..size])));
+        }
+        units.resize(size.saturating_add(1), 0);
+    }
+}
