+        })
+        .or_else(|| {
+            system_directory(GetSystemDirectoryW).and_then(|path| lookup_candidate(&path, &image))
+        })
+        .or_else(|| {
+            system_directory(GetWindowsDirectoryW).and_then(|path| lookup_candidate(&path, &image))
+        })
+        .or_else(|| std::env::var_os("PATH").and_then(|paths| search_path(&paths, &image)))
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "program not found"))
+}
