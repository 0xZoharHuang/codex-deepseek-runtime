+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn junction_uses_supplied_private_sandbox_and_preserves_target() {
+        let root = std::env::temp_dir().join(format!(
+            "codex-junction-root-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        let target = root.join("workspace with spaces");
+        let sandbox = root.join("private home").join(".sandbox");
+        std::fs::create_dir_all(&target).unwrap();
+        std::fs::create_dir_all(&sandbox).unwrap();
+        let marker = target.join("marker.txt");
+        std::fs::write(&marker, "actual target").unwrap();
+        let junction = create_cwd_junction(&target, &sandbox, None)
+            .expect("create junction in explicit sandbox directory");
+        assert_eq!(junction.parent(), Some(sandbox.join("cwd").as_path()));
+        assert_eq!(
+            std::fs::read_to_string(junction.join("marker.txt")).unwrap(),
+            "actual target"
+        );
+        std::fs::write(junction.join("via-junction.txt"), "native alias write").unwrap();
+        assert_eq!(
+            std::fs::read_to_string(target.join("via-junction.txt")).unwrap(),
+            "native alias write"
+        );
+        let reused = create_cwd_junction(&target, &sandbox, None).unwrap();
+        assert_eq!(junction, reused);
+        std::fs::remove_dir(&junction).unwrap();
+        assert_eq!(std::fs::read_to_string(&marker).unwrap(), "actual target");
+        std::fs::remove_dir_all(&root).unwrap();
+    }
