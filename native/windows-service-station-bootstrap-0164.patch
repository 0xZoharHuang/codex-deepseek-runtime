+//! Native access required when an alternate-user runner joins a caller-owned
+//! noninteractive service window station. No desktop, station binding, or agent
+//! execution policy is changed here.
+use super::station_name_for_handle;
+use crate::private_acl_lock::PrivateLockDirectory;
+use crate::token::{get_current_token_for_restriction, get_user_sid_bytes};
+use crate::winutil::sid_bytes_from_string;
+use anyhow::{Context, Result, ensure};
+use sha2::{Digest, Sha256};
+use std::{ffi::c_void, fs::File, mem::size_of, ptr};
+use windows_sys::Win32::Foundation::{
+    CloseHandle, ERROR_SUCCESS, GetLastError, HANDLE, HLOCAL, LocalFree,
+};
+use windows_sys::Win32::Security::Authorization::{
+    EXPLICIT_ACCESS_W, GRANT_ACCESS, GetSecurityInfo, SE_WINDOW_OBJECT, SetEntriesInAclW,
+    SetSecurityInfo, TRUSTEE_IS_SID, TRUSTEE_IS_USER, TRUSTEE_W,
+};
+use windows_sys::Win32::Security::{
+    ACCESS_ALLOWED_ACE, ACE_HEADER, ACL, DACL_SECURITY_INFORMATION, EqualSid, GENERIC_MAPPING,
+    GetAce, GetLengthSid, GetTokenInformation, IsValidSid, MapGenericMask,
+    OWNER_SECURITY_INFORMATION, PSECURITY_DESCRIPTOR, TOKEN_STATISTICS, TokenSessionId,
+    TokenStatistics,
+};
+use windows_sys::Win32::System::StationsAndDesktops::{
+    GetProcessWindowStation, GetUserObjectInformationW, UOI_FLAGS, USEROBJECTFLAGS,
+};
+
+// GENERIC_EXECUTE for a noninteractive station, plus READATTRIBUTES for the
+// existing runner's station-name query. Actual Session0/alternate-token tests
+// prove every component; no clipboard, desktop creation, or ACL-management rights.
+const REQUIRED_ACCESS: u32 = 0x0002_0062;
+const INHERIT_ONLY: u8 = 0x08;
+
+struct LocalMemory(*mut c_void);
+impl Drop for LocalMemory {
+    fn drop(&mut self) {
+        unsafe {
+            LocalFree(self.0 as HLOCAL);
+        }
+    }
+}
+// Keep this zero-byte coordination inode. Per-operation deletion would race a
+// new opener after unlock; the file stores no lease or application state.
+struct StationLock {
+    _file: File,
+    _directory: PrivateLockDirectory,
+    _leaf: String,
+}
+fn lock_station(session: u32, station: &[u16], owner: &[u8]) -> Result<StationLock> {
+    let mut hash = Sha256::new();
+    hash.update(b"native-service-window-station\0");
+    hash.update(session.to_le_bytes());
+    for unit in station {
+        hash.update(unit.to_le_bytes());
+    }
+    hash.update(owner);
+    let leaf = format!("station-{:x}.lock", hash.finalize());
+    // Known-folder caller-owned location shared across homes, versions, CDS and
+    // CADSG. Never derive the lock root/key from a provider or CODEX_HOME.
+    let directory = PrivateLockDirectory::open()?;
+    let file = directory.open_leaf(&leaf)?;
+    file.lock()
+        .context("lock current service window station ACL")?;
+    Ok(StationLock {
+        _file: file,
+        _directory: directory,
+        _leaf: leaf,
+    })
+}
+fn caller_identity() -> Result<(Vec<u8>, u32, TOKEN_STATISTICS)> {
+    let token = unsafe { get_current_token_for_restriction()? };
+    let result = (|| {
+        let user = unsafe { get_user_sid_bytes(token)? };
+        let mut session = 0_u32;
+        let mut stats: TOKEN_STATISTICS = unsafe { std::mem::zeroed() };
+        let mut returned = 0;
+        ensure!(
+            unsafe {
+                GetTokenInformation(
+                    token,
+                    TokenSessionId,
+                    (&mut session as *mut u32).cast(),
+                    size_of::<u32>() as u32,
+                    &mut returned,
+                )
+            } != 0,
+            "query caller session: {}",
+            unsafe { GetLastError() }
+        );
+        ensure!(
+            returned as usize == size_of::<u32>(),
+            "invalid caller session size"
+        );
+        ensure!(
+            unsafe {
+                GetTokenInformation(
+                    token,
+                    TokenStatistics,
+                    (&mut stats as *mut TOKEN_STATISTICS).cast(),
+                    size_of::<TOKEN_STATISTICS>() as u32,
+                    &mut returned,
+                )
+            } != 0,
+            "query caller logon identity: {}",
+            unsafe { GetLastError() }
+        );
+        ensure!(
+            returned as usize == size_of::<TOKEN_STATISTICS>(),
+            "invalid caller statistics size"
+        );
+        Ok((user, session, stats))
+    })();
+    unsafe {
+        CloseHandle(token);
+    }
+    result
+}
+fn station_security(station: HANDLE) -> Result<(LocalMemory, *mut c_void, *mut ACL)> {
+    let mut owner = ptr::null_mut();
+    let mut acl = ptr::null_mut();
+    let mut sd: PSECURITY_DESCRIPTOR = ptr::null_mut();
+    let error = unsafe {
+        GetSecurityInfo(
+            station,
+            SE_WINDOW_OBJECT,
+            OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+            &mut owner,
+            ptr::null_mut(),
+            &mut acl,
+            ptr::null_mut(),
+            &mut sd,
+        )
+    };
+    ensure!(
+        error == ERROR_SUCCESS,
+        "read current service station ACL: {error}"
+    );
+    let allocation = LocalMemory(sd);
+    ensure!(
+        !sd.is_null() && !owner.is_null(),
+        "missing current service station owner"
+    );
+    Ok((allocation, owner, acl))
+}
+fn map_station_mask(mut mask: u32) -> u32 {
+    // Microsoft WinSta generic mappings; retain all pre-existing generic grants.
+    let mapping = GENERIC_MAPPING {
+        GenericRead: 0x0002_0103,
+        GenericWrite: 0x0002_000c,
+        GenericExecute: 0x0002_0060,
+        GenericAll: 0x000f_037f,
+    };
+    unsafe {
+        MapGenericMask(&mut mask, &mapping);
+    }
+    mask
+}
+fn target_masks(acl: *const ACL, target: &[u8]) -> Result<(u32, u32)> {
+    let mut allowed = 0;
+    let mut denied = 0;
+    for index in 0..unsafe { (*acl).AceCount } {
+        let mut raw = ptr::null_mut();
+        ensure!(
+            unsafe { GetAce(acl, index as u32, &mut raw) } != 0,
+            "read service station ACE: {}",
+            unsafe { GetLastError() }
+        );
+        let header = unsafe { &*raw.cast::<ACE_HEADER>() };
+        if !matches!(header.AceType, 0 | 1) || header.AceFlags & INHERIT_ONLY != 0 {
+            continue;
+        }
+        ensure!(
+            header.AceSize as usize >= 16,
+            "truncated station access ACE"
+        );
+        let ace = unsafe { &*raw.cast::<ACCESS_ALLOWED_ACE>() };
+        let sid = ptr::addr_of!(ace.SidStart).cast_mut().cast();
+        let size = unsafe { GetLengthSid(sid) } as usize;
+        ensure!(
+            size >= 8 && size <= header.AceSize as usize - 8 && unsafe { IsValidSid(sid) } != 0,
+            "invalid station ACE SID"
+        );
+        if unsafe { EqualSid(sid, target.as_ptr().cast_mut().cast()) } == 0 {
+            continue;
+        }
+        if header.AceType == 0 {
+            allowed |= map_station_mask(ace.Mask);
+        } else {
+            denied |= map_station_mask(ace.Mask);
+        }
+    }
+    Ok((allowed, denied))
+}
+pub(super) fn ensure_access(target_sid: &str) -> Result<()> {
+    // Scope this additive compatibility grant to the exact held current object.
+    // Outside that scope, preserve the existing native launch path unchanged.
+    let station = unsafe { GetProcessWindowStation() };
+    if station.is_null() {
+        return Ok(());
+    }
+    let Ok(name) = station_name_for_handle(station) else {
+        return Ok(());
+    };
+    let mut flags: USEROBJECTFLAGS = unsafe { std::mem::zeroed() };
+    let mut returned = 0;
+    if unsafe {
+        GetUserObjectInformationW(
+            station,
+            UOI_FLAGS,
+            (&mut flags as *mut USEROBJECTFLAGS).cast(),
+            size_of::<USEROBJECTFLAGS>() as u32,
+            &mut returned,
+        )
+    } == 0
+        || returned as usize != size_of::<USEROBJECTFLAGS>()
+        || flags.dwFlags & 1 != 0
+    {
+        return Ok(());
+    }
+    let Ok(station_name) = String::from_utf16(&name) else {
+        return Ok(());
+    };
+    if !station_name.to_ascii_lowercase().starts_with("service-0x") || !station_name.ends_with('$')
+    {
+        return Ok(());
+    }
+    let Ok((caller, session, statistics)) = caller_identity() else {
+        return Ok(());
+    };
+    let expected = format!(
+        "Service-0x{:x}-{:x}$",
+        statistics.AuthenticationId.HighPart as u32, statistics.AuthenticationId.LowPart
+    );
+    if !station_name.eq_ignore_ascii_case(&expected) {
+        return Ok(());
+    }
+    let Ok((_scope_sd, owner, _)) = station_security(station) else {
+        return Ok(());
+    };
+    if unsafe { EqualSid(owner, caller.as_ptr().cast_mut().cast()) } == 0 {
+        return Ok(());
+    }
+    let target = sid_bytes_from_string(target_sid)?;
+    let _lock = lock_station(session, &name, &caller)?;
+    // Read the latest descriptor only after the cross-process lock. All original
+    // deny/allow/inheritance entries are retained by the native GRANT merge.
+    let (_old_sd, owner, acl) = station_security(station)?;
+    if unsafe { EqualSid(owner, caller.as_ptr().cast_mut().cast()) } == 0 {
+        return Ok(());
+    }
+    // A pre-existing NULL DACL grants all access. Do not replace it with a more
+    // restrictive DACL or pretend ownership of pre-existing authorization.
+    if acl.is_null() {
+        return Ok(());
+    }
+    let (existing, denied) = target_masks(acl, &target)?;
+    ensure!(
+        denied & REQUIRED_ACCESS == 0,
+        "current service station explicitly denies runner startup access"
+    );
+    let missing = REQUIRED_ACCESS & !existing;
+    if missing == 0 {
+        return Ok(());
+    }
+    let entry = EXPLICIT_ACCESS_W {
+        grfAccessPermissions: missing,
+        grfAccessMode: GRANT_ACCESS,
+        grfInheritance: 0,
+        Trustee: TRUSTEE_W {
+            pMultipleTrustee: ptr::null_mut(),
+            MultipleTrusteeOperation: 0,
+            TrusteeForm: TRUSTEE_IS_SID,
+            TrusteeType: TRUSTEE_IS_USER,
+            ptstrName: target.as_ptr().cast_mut().cast(),
+        },
+    };
+    let mut updated = ptr::null_mut();
+    let error = unsafe { SetEntriesInAclW(1, &entry, acl, &mut updated) };
+    ensure!(
+        error == ERROR_SUCCESS,
+        "merge native service station startup grant: {error}"
+    );
+    let _updated = LocalMemory(updated.cast());
+    let error = unsafe {
+        SetSecurityInfo(
+            station,
+            SE_WINDOW_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            updated,
+            ptr::null_mut(),
+        )
+    };
+    ensure!(
+        error == ERROR_SUCCESS,
+        "authorize native service station startup: {error}"
+    );
+    let (_readback_sd, owner, readback_acl) = station_security(station)?;
+    ensure!(
+        unsafe { EqualSid(owner, caller.as_ptr().cast_mut().cast()) } != 0
+            && !readback_acl.is_null(),
+        "service station owner/DACL changed during grant"
+    );
+    let (actual, denied) = target_masks(readback_acl, &target)?;
+    ensure!(
+        actual & REQUIRED_ACCESS == REQUIRED_ACCESS && denied & REQUIRED_ACCESS == 0,
+        "native service station startup grant did not persist"
+    );
+    // Add-only for this ephemeral object lifetime, like the existing private
+    // desktop cache. Per-run revoke/whole-SD restore would race other runners and
+    // erase pre-existing grants; the OS retires this station with its logon.
+    Ok(())
+}
