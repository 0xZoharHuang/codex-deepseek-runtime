+    let original_other = other_aces(acl, std::slice::from_ref(&target_bytes))?;
+    // First prove automatic admission from a fresh station with ZERO target ACE.
+    std::fs::write(
+        cwd.join("native-station-input.txt"),
+        b"CDS_NATIVE_READ_ALLOWED\r\n",
+    )?;
+    let mut captures = vec![native_readonly(&home, &cwd, "freshzero", &target)?];
+    let (fresh_sd, _, fresh_acl) = station_security(station)?;
+    ensure!(
+        target_masks(fresh_acl, &target_bytes)? == (REQUIRED_ACCESS, 0),
+        "fresh automatic startup grant is incomplete or excessive"
+    );
+    ensure!(
+        other_aces(fresh_acl, std::slice::from_ref(&target_bytes))? == original_other,
+        "fresh grant changed other original ACEs"
+    );
+    let cache_names = super::super::SHARED_PRIVATE_DESKTOPS
+        .get()
+        .context("native private desktop cache was not populated")?
+        .lock()
+        .map_err(|_| anyhow::anyhow!("desktop cache poisoned"))?
+        .values()
+        .map(|d| d.name.clone())
+        .collect::<std::collections::BTreeSet<_>>();
+    ensure!(
+        !cache_names.is_empty(),
+        "native private desktop cache is empty"
+    );
+    // Exclusive TEST fixture reset only: retain the live private desktop cache,
+    // remove the earlier station grant, then require real cache-hit reauthorization.
+    let error = unsafe {
+        SetSecurityInfo(
+            station,
+            SE_WINDOW_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            restore.acl,
+            ptr::null_mut(),
+        )
+    };
+    ensure!(
+        error == ERROR_SUCCESS,
+        "exclusive cache-hit fixture reset failed: {error}"
+    );
+    let (reset_sd, _, reset_acl) = station_security(station)?;
+    ensure!(
+        sd_bytes(&reset_sd) == sd_bytes(&restore.original)
+            && target_masks(reset_acl, &target_bytes)? == (0, 0),
+        "cache-hit fixture reset is incomplete"
+    );
+    drop(fresh_sd);
+    // A pre-existing partial allow, extra unrelated right, and deny must survive.
+    fixture_merge(station, &target, 0x20100, false)?;
+    fixture_merge(station, &target, 0x8, true)?;
+    captures.push(native_readonly(
+        &home,
+        &cwd,
+        "cachehit_reauthorize",
+        &target,
+    )?);
+    let after_cache_names = super::super::SHARED_PRIVATE_DESKTOPS
+        .get()
+        .context("native desktop cache disappeared")?
+        .lock()
+        .map_err(|_| anyhow::anyhow!("desktop cache poisoned"))?
+        .values()
+        .map(|d| d.name.clone())
+        .collect::<std::collections::BTreeSet<_>>();
+    ensure!(
+        cache_names == after_cache_names,
+        "test did not exercise the same native private desktop cache"
+    );
+    let (first, _, first_acl) = station_security(station)?;
+    ensure!(
+        target_masks(first_acl, &target_bytes)? == (0x20162, 0x8),
+        "pre-existing target permissions lost or overgranted"
+    );
+    ensure!(
+        other_aces(first_acl, std::slice::from_ref(&target_bytes))? == original_other,
+        "other original ACEs changed"
+    );
+    captures.push(native_readonly(&home, &cwd, "idempotent", &target)?);
+    let (second, _, _) = station_security(station)?;
+    ensure!(
+        sd_bytes(&first) == sd_bytes(&second),
+        "cache hit must be idempotent"
+    );
+    let mut threads = vec![];
+    for n in 0..2 {
+        let h = home.clone();
+        let w = cwd.clone();
+        let t = target.clone();
+        threads.push(std::thread::spawn(move || {
+            native_readonly(&h, &w, &format!("parallel{n}"), &t)
+        }));
+    }
+    let joined = threads.into_iter().map(|t| t.join()).collect::<Vec<_>>();
+    for result in joined {
+        captures.push(result.map_err(|_| anyhow::anyhow!("native parallel thread panicked"))??);
+    }
+    // Separate process/home values still take the same caller/session/station lock.
+    let prefix = target
+        .rsplit_once('-')
+        .context("local account SID required")?
+        .0;
+    let synthetic = [
+        format!("{prefix}-4294967293"),
+        format!("{prefix}-4294967294"),
+    ];
+    let mut children = vec![];
+    for (n, sid) in synthetic.iter().enumerate() {
+        let child_home = out.join(format!("child-home-{n}"));
+        std::fs::create_dir(&child_home)?;
+        children.push(Command::new(std::env::current_exe()?).args(["--exact","desktop::service_station::tests::actual_owned_service_station_concurrent_child","--ignored","--show-output","--test-threads=1"]).env("CDS_OWN_STATION_CHILD_SID",sid).env("CODEX_HOME",child_home).stdout(Stdio::piped()).stderr(Stdio::piped()).spawn()?);
+    }
+    let joined = children
+        .into_iter()
+        .map(|c| c.wait_with_output())
+        .collect::<Vec<_>>();
+    let mut child_outputs = vec![];
+    let expected_key = {
+        let name = current_window_station_name()?;
+        let lock = lock_station(session, &name, &caller)?;
+        lock._leaf.clone()
+    };
+    for child in joined {
+        let r = child?;
+        let text = String::from_utf8_lossy(&r.stdout).into_owned();
+        ensure!(
+            r.status.success()
+                && text.contains(&format!("OWN_STATION_CHILD_ACTUAL_GRANT {expected_key}"))
+                && text.contains("1 passed; 0 failed; 0 ignored"),
+            "child did not actually execute native grant: {} {text}",
+            r.status
+        );
+        child_outputs.push(text);
+    }
+    let (_current_sd, _, current_acl) = station_security(station)?;
+    for sid in &synthetic {
+        ensure!(
+            target_masks(current_acl, &sid_bytes_from_string(sid)?)?.0 == REQUIRED_ACCESS,
+            "concurrent distinct SID grant lost"
+        );
+    }
+    ensure!(
+        target_masks(current_acl, &target_bytes)? == (0x20162, 0x8),
+        "concurrent grant lost existing target rights"
+    );
+    let mut excluded = vec![target_bytes.clone()];
+    for sid in &synthetic {
+        excluded.push(sid_bytes_from_string(sid)?);
+    }
+    ensure!(
+        other_aces(current_acl, &excluded)? == original_other,
+        "concurrent grant changed other original ACEs"
+    );
+    let (before_invalid, _, _) = station_security(station)?;
+    ensure!(ensure_access("not-a-sid").is_err(), "invalid SID accepted");
+    let (after_invalid, _, _) = station_security(station)?;
+    ensure!(
+        sd_bytes(&before_invalid) == sd_bytes(&after_invalid),
+        "invalid SID mutated ACL"
+    );
+    fixture_merge(station, &target, 0x20, true)?;
+    let (before_deny, _, _) = station_security(station)?;
+    ensure!(
+        ensure_access(&target).is_err(),
+        "explicit target deny was overridden"
+    );
+    let (after_deny, _, _) = station_security(station)?;
+    ensure!(
+        sd_bytes(&before_deny) == sd_bytes(&after_deny),
+        "denied startup changed ACL"
+    );
+    let report = json!({"status":"ACTUAL_NATIVE_AUTOMATIC_STATION_GRANT_AND_READONLY_PASSED","production_required_mask":"0x20062","external_pregrant":false,"fresh_zero_target_ACE_native_passed":true,"same_private_desktop_cache_reauthorized_after_fixture_reset":true,"preexisting_allow_and_deny_preserved":true,"other_original_aces_preserved":true,"cache_hit_SD_byte_equal":true,"native_readonly_captures":captures,"distinct_process_different_home_same_station_key":expected_key,"concurrent_child_outputs":child_outputs,"invalid_sid_failed_without_mutation":true,"required_target_deny_failed_without_mutation":true,"no_CREATE_SUSPENDED_or_admin_token_hook":true});
+    std::fs::write(
+        out.join("native-station-result.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    restore.restore()?;
+    Ok(())
+}
