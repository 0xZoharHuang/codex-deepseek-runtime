+// Metadata grants and the existing asynchronous read-ACL refresh can share a
+// private ancestor. Serialize only real-owner updates, after proving work exists.
+fn lock_owned_metadata_update(
+    target: &std::fs::File,
+) -> Result<Option<(crate::setup_mutex::SandboxSetupLock, Vec<u8>)>> {
+    use std::os::windows::io::{FromRawHandle, OwnedHandle};
+    use windows_sys::Win32::Security::TOKEN_QUERY;
+    use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+    let mut token = std::ptr::null_mut();
+    ensure!(
+        unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } != 0,
+        "read real owner for metadata ACL lock"
+    );
+    let token = unsafe { OwnedHandle::from_raw_handle(token) };
+    let user = unsafe { crate::token::get_user_sid_bytes(token.as_raw_handle() as _) }?;
+    let (mut owner, mut descriptor) = (std::ptr::null_mut(), std::ptr::null_mut());
+    let status = unsafe {
+        GetSecurityInfo(
+            target.as_raw_handle() as _,
+            1,
+            OWNER_SECURITY_INFORMATION,
+            &mut owner,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    let is_owner = status == ERROR_SUCCESS
+        && !owner.is_null()
+        && unsafe { EqualSid(owner, user.as_ptr() as *mut c_void) } != 0;
+    if !descriptor.is_null() {
+        unsafe {
+            LocalFree(descriptor as HLOCAL);
+        }
+    }
+    ensure!(
+        status == ERROR_SUCCESS,
+        "inspect target owner for metadata ACL update: {status}"
+    );
+    if !is_owner {
+        return Ok(None);
+    }
+    let owner = crate::winutil::string_from_sid_bytes(&user).map_err(anyhow::Error::msg)?;
+    let guard = crate::setup_mutex::acquire_metadata_acl_lock(&owner, 5_000)?;
+    Ok(Some((guard, user)))
+}
