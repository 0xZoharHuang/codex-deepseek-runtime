+//! Namespace-owned, non-inheriting directory metadata for CODEX_HOME ancestors.
+//! PowerShell resolves ancestor attributes before selecting its initial location.
+//! Never grant directory enumeration, file data access, or descendant inheritance.
+use anyhow::{Context, Result, bail, ensure};
+use serde::{Deserialize, Serialize};
+use std::ffi::c_void;
+use std::fs::OpenOptions;
+use std::io::Read;
+use std::os::windows::fs::OpenOptionsExt;
+use std::os::windows::io::{AsRawHandle, OwnedHandle};
+use std::path::{Path, PathBuf};
+use windows_sys::Win32::Foundation::{HANDLE, LocalFree};
+use windows_sys::Win32::Security::Authorization::{GetSecurityInfo, SE_FILE_OBJECT};
+use windows_sys::Win32::Security::{
+    ACE_HEADER, ACL, AddAce, DACL_SECURITY_INFORMATION, EqualSid, GetAce, GetLengthSid,
+    INHERIT_ONLY_ACE, INHERITED_ACE, InitializeAcl, IsValidAcl, IsValidSid,
+    OWNER_SECURITY_INFORMATION,
+};
+use windows_sys::Win32::Storage::FileSystem as fs;
+
+use crate::deny_read_state::{lock_private_state_transaction, validate_state_file};
+use crate::namespace::SandboxNamespace;
+use crate::no_reparse_dir::{DirectoryOpenDisposition, open_directory_no_reparse};
+
+const STATE: &str = "ancestor_metadata_acl_state.json";
+const LOCK: &str = "ancestor_metadata_acl_state.lock";
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct DirectoryId {
+    volume: u64,
+    file_id: [u8; 16],
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Grant {
+    path: PathBuf,
+    identity: DirectoryId,
+    ace: Vec<u8>,
+    #[serde(default)]
+    revoking: bool,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Ledger {
+    schema: u32,
+    namespace: String,
+    owner_sid: String,
+    group_sid: String,
+    grants: Vec<Grant>,
+}
+
+struct PinnedDirectory {
+    path: PathBuf,
+    handle: OwnedHandle,
+    identity: DirectoryId,
+}
+
+impl PinnedDirectory {
+    fn open(path: &Path) -> Result<Self> {
+        // FILE_TRAVERSE participates in sharing checks; no SHARE_DELETE pins the name.
+        let handle = open_directory_no_reparse(
+            path,
+            fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            DirectoryOpenDisposition::OpenExisting,
+        )?;
+        let identity = directory_id(handle.as_raw_handle() as _)?;
+        Ok(Self {
+            path: path.to_owned(),
+            handle,
+            identity,
+        })
+    }
+
+    fn write_handle(&self) -> Result<OwnedHandle> {
+        let handle = open_directory_no_reparse(
+            &self.path,
+            fs::READ_CONTROL | fs::WRITE_DAC | fs::FILE_READ_ATTRIBUTES,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            DirectoryOpenDisposition::OpenExisting,
+        )?;
+        ensure!(
+            directory_id(handle.as_raw_handle() as _)? == self.identity,
+            "metadata target changed before its ACL update"
+        );
+        Ok(handle)
+    }
+}
+
+fn directory_id(handle: HANDLE) -> Result<DirectoryId> {
+    let mut info = fs::FILE_ID_INFO::default();
+    ensure!(
+        unsafe {
+            fs::GetFileInformationByHandleEx(
+                handle,
+                fs::FileIdInfo,
+                (&mut info as *mut fs::FILE_ID_INFO).cast(),
+                size_of::<fs::FILE_ID_INFO>() as u32,
+            )
+        } != 0,
+        "read metadata directory identity: {}",
+        std::io::Error::last_os_error()
+    );
+    ensure!(
+        info.FileId.Identifier != [0; 16],
+        "metadata directory has no stable identity"
+    );
+    Ok(DirectoryId {
+        volume: info.VolumeSerialNumber,
+        file_id: info.FileId.Identifier,
+    })
+}
+
+fn pin_ancestors(namespace: &SandboxNamespace) -> Result<Vec<PinnedDirectory>> {
+    let mut paths = namespace.home.ancestors().collect::<Vec<_>>();
+    paths.reverse();
+    let pinned = paths
+        .into_iter()
+        .map(PinnedDirectory::open)
+        .collect::<Result<Vec<_>>>()?;
+    let home = pinned.last().context("metadata home is missing")?;
+    let actual = crate::namespace_key::NamespaceKey::for_directory(
+        &namespace.home.to_string_lossy().to_lowercase(),
+        &namespace.owner_sid,
+        home.identity.volume,
+        home.identity.file_id,
+    );
+    ensure!(
+        actual.id() == namespace.key.id(),
+        "metadata home identity changed"
+    );
+    namespace.validate_existing_state()?;
+    Ok(pinned)
+}
