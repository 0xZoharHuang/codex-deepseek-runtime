+        for i in 0..(*updated).AceCount as u32 {
+            let mut current = std::ptr::null_mut();
+            ensure!(
+                GetAce(updated, i, &mut current) != 0,
+                "read updated metadata ACE"
+            );
+            let size = (*current.cast::<ACE_HEADER>()).AceSize as usize;
+            if size == bytes.len()
+                && std::slice::from_raw_parts(current.cast::<u8>(), size) == bytes
+            {
