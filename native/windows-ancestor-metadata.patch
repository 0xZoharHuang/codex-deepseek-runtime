+        }
+        if !exists {
+            additional.push(bytes.to_vec());
+        }
+    }
+    if additional.is_empty() {
+        return Ok(None);
+    }
+    let old_size = (*updated).AclSize as usize;
+    let size = old_size + additional.iter().map(Vec::len).sum::<usize>();
+    ensure!(
+        size <= u16::MAX as usize,
+        "metadata-preserving ACL is too large"
+    );
