+fn capacity_test_image_count(value: &serde_json::Value) -> usize {
+    match value {
+        serde_json::Value::Object(fields) => {
+            usize::from(fields.get("type").and_then(|v| v.as_str()) == Some("input_image"))
+                + fields
+                    .values()
+                    .map(capacity_test_image_count)
+                    .sum::<usize>()
+        }
+        serde_json::Value::Array(items) => items.iter().map(capacity_test_image_count).sum(),
+        _ => 0,
+    }
+}
