+/// Native ordinary Responses transport probe, with genuine Completed admission.
+/// The public CLI fixture separately covers the complete agent-turn lifecycle.
+async fn capacity_test_ordinary_request(
+    session: &Session,
+    turn: &TurnContext,
+    step: &StepContext,
+) -> CodexResult<String> {
+    let snapshot = session.capture_capacity_send().await;
+    let input = snapshot
+        .history
+        .clone()
+        .for_prompt(&turn.model_info().input_modalities);
+    let base_instructions = if input
+        .iter()
+        .any(|item| BaseInstructionsFragment::text_from_item(item).is_some())
+    {
+        BaseInstructions {
+            text: String::new(),
+            provenance: None,
+        }
+    } else {
+        session.get_prompt_base_instructions().await
+    };
+    let prompt = Prompt {
+        input,
+        base_instructions,
+        ..Default::default()
+    };
+    let metadata = session
+        .responses_metadata(
+            step,
+            crate::responses_metadata::CodexResponsesRequestKind::Turn,
+        )
+        .await;
+    let mut client = session.services.model_client.new_session();
+    let mut stream = client
+        .stream(
+            &prompt,
+            turn.model_info(),
+            &turn.session_telemetry,
+            None,
+            turn.reasoning_summary(),
+            turn.config.service_tier.clone(),
+            &metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await?;
+    while let Some(event) = stream.next().await {
+        if let ResponseEvent::Completed {
+            response_id,
+            token_usage,
+            usage_metadata,
+            ..
+        } = event?
+        {
+            session
+                .record_observed_response_completed(
+                    turn,
+                    &response_id,
+                    token_usage.as_ref(),
+                    usage_metadata.as_ref(),
+                )
+                .await;
+            session
+                .confirm_capacity_completion(turn, &turn.model_info().slug, snapshot, &response_id)
+                .await;
+            return Ok(response_id);
+        }
+    }
+    Err(CodexErr::Stream(
+        "ordinary capacity probe ended without Completed".to_owned(),
+    ))
+}
