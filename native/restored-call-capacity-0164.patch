+    )?);
+    let mut restored = vec![ResponseItemEnvelope::new(orphan)];
+    crate::context_manager::ContextManager::ensure_restored_call_outputs(&mut restored);
+    let mut historical = restored
+        .into_iter()
+        .map(|item| mark_old(item.item))
+        .collect::<Vec<_>>();
