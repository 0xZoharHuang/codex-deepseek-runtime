+#[test]
+fn request_capacity_fresh_summary_requires_current_turn_and_stops_before_ambiguous_input() {
+    let mut history = ContextManager::new();
+    let mut current = user_msg("current");
+    current.set_turn_id_if_missing("current-turn");
+    history.replace_annotated(vec![
+        ResponseItemEnvelope::new(capacity_old_turn_item(user_msg("confirmed"))),
+        ResponseItemEnvelope::new(capacity_old_turn_item(user_msg("historical"))),
+        ResponseItemEnvelope::new(user_msg("ambiguous may be unconsumed")),
+        ResponseItemEnvelope::new(current),
+    ]);
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(1, "current-turn"),
+        Some(2)
+    );
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(1, "missing-turn"),
+        None
+    );
+    assert_eq!(history.fresh_capacity_summary_prefix_len(1, ""), None);
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(4, "current-turn"),
+        None
+    );
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(5, "current-turn"),
+        None
+    );
+
+    // Native compaction rebuilds initial context using the current turn stamp.
+    // Confirmed items must not hide the later old-turn expansion boundary.
+    let stamped_current = |text: &str| {
+        let mut item = user_msg(text);
+        item.set_turn_id_if_missing("current-turn");
+        ResponseItemEnvelope::new(item)
+    };
+    let mut rebuilt = (0..6)
+        .map(|index| stamped_current(&format!("confirmed context {index}")))
+        .collect::<Vec<_>>();
+    rebuilt.push(ResponseItemEnvelope::new(capacity_old_turn_item(user_msg(
+        "old observation A",
+    ))));
+    rebuilt.push(ResponseItemEnvelope::new(capacity_old_turn_item(user_msg(
+        "old observation B",
+    ))));
+    rebuilt.push(stamped_current("actual unconsumed current input"));
+    history.replace_annotated(rebuilt);
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(6, "current-turn"),
+        Some(8),
+        "current stamps in the confirmed six cannot block fresh reading of old suffix input"
+    );
+    assert_eq!(
+        history.fresh_capacity_summary_prefix_len(8, "current-turn"),
+        None,
+        "the first not-yet-confirmed current item remains protected"
+    );
+}
