+#[test]
+fn request_capacity_byte_prefix_bounds_dense_data_instead_of_counting_small_notes() {
+    let mut items = vec![ResponseItemEnvelope::new(user_message(
+        "Engineering repair task",
+    ))];
+    for index in 0..100 {
+        items.push(ResponseItemEnvelope::new(user_message(&format!(
+            "Small context note {index}"
+        ))));
+    }
+    for index in 0..4 {
+        let call_id = format!("byte-prefix-{index}");
+        items.push(ResponseItemEnvelope::new(ResponseItem::FunctionCall {
+            status: None,
+            encrypted_content: None,
+            id: None,
+            name: "inspect".to_string(),
+            namespace: None,
+            arguments: "{}".to_string(),
+            encrypted_function_args: None,
+            call_id: call_id.clone(),
+            internal_chat_message_metadata_passthrough: None,
+        }));
+        items.push(ResponseItemEnvelope::new(
+            ResponseItem::FunctionCallOutput {
+                id: None,
+                call_id: Some(call_id),
+                name: None,
+                namespace: None,
+                output: FunctionCallOutputPayload::from_text("data".repeat(8192)),
+                internal_chat_message_metadata_passthrough: None,
+            },
+        ));
+    }
+    let original = items.clone();
+    let mut history = ContextManager::new();
+    history.replace_annotated(items);
+    let selected = smaller_request_byte_prefix(&history, original.len()).expect("byte prefix");
+    assert!(
+        selected > 101,
+        "byte partition must include the dominant tool data"
+    );
+    assert!(selected < original.len());
+    assert_eq!(history.pair_safe_prefix_len(selected), selected);
+    assert_eq!(history.annotated_items(), original.as_slice());
+}
