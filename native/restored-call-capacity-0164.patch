+// This is local compaction input/coverage state, not an agent or tool executor.
+// A capacity claim remains fenced while all chunks are read. Nothing is installed
+// until the final fresh summary transitively covers the complete captured target.
+pub(crate) struct CapacitySummaryCoverage {
+    target: crate::context_manager::ContextManager,
+    segments: Vec<CapacitySummarySegment>,
+    covered: usize,
+    carry_summary: Option<String>,
+}
+
+struct CapacitySummarySegment {
+    start: usize,
+    end: usize,
+    response_id: String,
+    carried_response_id: Option<String>,
+}
+
+impl CapacitySummaryCoverage {
+    fn prompt_carry(&self, input: &[ResponseItem]) -> CodexResult<Option<String>> {
+        let Some(summary) = &self.carry_summary else {
+            return Ok(None);
+        };
+        let carried = input.iter().any(|item| matches!(item,
+            ResponseItem::Message {content, internal_chat_message_metadata_passthrough: Some(metadata), ..}
+            if metadata.content_item_kinds.as_ref().is_some_and(|kinds| kinds.iter().any(|kind| kind.0 == CompactionSummary::KIND))
+                && content.iter().any(|part| matches!(part, ContentItem::InputText {text} if text == summary))
+        ));
+        if !carried {
+            return Err(CodexErr::InvalidRequest(
+                "Capacity partition lost its exact fresh summary carry".to_owned(),
+            ));
+        }
+        Ok(self
+            .segments
+            .last()
+            .map(|segment| segment.response_id.clone()))
+    }
+
+    pub(crate) fn matches_target(
+        &self,
+        target: &crate::context_manager::ContextManager,
+        final_response_id: &str,
+    ) -> bool {
+        if self.target.annotated_items() != target.annotated_items()
+            || self.covered != target.annotated_items().len()
+            || self.segments.is_empty()
+        {
+            return false;
+        }
+        let mut covered = 0;
+        let mut previous = None;
+        for segment in &self.segments {
+            if segment.start != covered
+                || segment.end <= segment.start
+                || segment.end > self.covered
+                || segment.response_id.is_empty()
+                || segment.carried_response_id.as_deref() != previous
+                || target.pair_safe_prefix_len(segment.end) != segment.end
+            {
+                return false;
+            }
+            covered = segment.end;
+            previous = Some(segment.response_id.as_str());
+        }
+        covered == self.covered && previous == Some(final_response_id)
+    }
+}
+
+struct CapacitySummaryWork {
+    coverage: CapacitySummaryCoverage,
+    working_history: crate::context_manager::ContextManager,
+    carry_len: usize,
+    selected_len: usize,
+}
+
+impl CapacitySummaryWork {
+    fn new(target: crate::context_manager::ContextManager) -> Self {
+        Self {
+            selected_len: target.annotated_items().len(),
+            working_history: target.clone(),
+            carry_len: 0,
+            coverage: CapacitySummaryCoverage {
+                target,
+                segments: Vec::new(),
+                covered: 0,
+                carry_summary: None,
+            },
+        }
+    }
+
+    fn smaller_prefix(&self, context_capacity: bool) -> Option<usize> {
+        let proposed = if context_capacity {
+            self.selected_len / 2
+        } else {
+            request_byte_midpoint(&self.working_history, self.selected_len)?
+        };
+        // Only this transaction's actual fresh carry is already summarized.
+        // Old summaries in the unread original target are still original input.
+        let candidate = |proposed| {
+            let len = self.working_history.pair_safe_prefix_len(proposed);
+            let added = len.checked_sub(self.carry_len)?;
+            let end = self.coverage.covered.checked_add(added)?;
+            (added > 0
+                && len < self.selected_len
+                && end <= self.coverage.target.annotated_items().len()
+                && self.coverage.target.pair_safe_prefix_len(end) == end)
+                .then_some(len)
+        };
+        if let Some(len) = candidate(proposed) {
+            return Some(len);
+        }
+        candidate(self.selected_len.checked_sub(1)?)?;
+        let mut lower = self.carry_len;
+        let mut upper = self.selected_len - 1;
+        while lower < upper {
+            let middle = lower + (upper - lower) / 2;
+            if candidate(middle).is_some() {
+                upper = middle;
+            } else {
+                lower = middle + 1;
+            }
+        }
+        candidate(lower)
+    }
+
+    fn selected_history(&self) -> crate::context_manager::ContextManager {
+        let mut history = self.working_history.clone();
+        history.replace_annotated(
+            self.working_history.annotated_items()[..self.selected_len].to_vec(),
+        );
+        history
+    }
+
+    fn complete_selected(
+        &mut self,
+        response: &CompactionResponse,
+        carried_response_id: Option<String>,
+    ) -> CodexResult<bool> {
+        let summary = response
+            .summary
+            .as_deref()
+            .filter(|summary| !summary.trim().is_empty())
+            .ok_or_else(|| {
+                CodexErr::Stream(
+                    "Local capacity partition completed without a fresh non-empty summary"
+                        .to_owned(),
+                )
+            })?;
+        let added = self
+            .selected_len
+            .checked_sub(self.carry_len)
+            .filter(|added| *added > 0)
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest(
+                    "Capacity partition made no original-input progress".to_owned(),
+                )
+            })?;
+        let end = self
+            .coverage
+            .covered
+            .checked_add(added)
+            .filter(|end| *end <= self.coverage.target.annotated_items().len())
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest(
+                    "Capacity partition exceeded its captured original target".to_owned(),
+                )
+            })?;
+        if self.coverage.target.pair_safe_prefix_len(end) != end
+            || carried_response_id.as_deref()
+                != self
+                    .coverage
+                    .segments
+                    .last()
+                    .map(|segment| segment.response_id.as_str())
+            || response.response_id.is_empty()
+        {
+            return Err(CodexErr::InvalidRequest(
+                "Capacity partition has invalid pair or carry lineage".to_owned(),
+            ));
+        }
+        self.coverage.segments.push(CapacitySummarySegment {
+            start: self.coverage.covered,
+            end,
+            response_id: response.response_id.clone(),
+            carried_response_id,
+        });
+        self.coverage.covered = end;
+        self.coverage.carry_summary = Some(format!("{SUMMARY_PREFIX}\n{summary}"));
+        Ok(end == self.coverage.target.annotated_items().len())
+    }
+
+    fn advance(&mut self, carry: Vec<ResponseItemEnvelope>) -> CodexResult<()> {
+        self.carry_len = carry.len();
+        let mut next = carry;
+        next.extend_from_slice(&self.coverage.target.annotated_items()[self.coverage.covered..]);
+        self.working_history.replace_annotated(next);
+        self.selected_len = self.working_history.annotated_items().len();
+        if self.selected_len <= self.carry_len {
+            return Err(CodexErr::InvalidRequest(
+                "Capacity partition has no remaining original input".to_owned(),
+            ));
+        }
+        Ok(())
+    }
+}
