+        ResponseItemEnvelope::new(ContextualUserFragment::into(CompactionSummary::new(
+            "already covered",
+        ))),
+        ResponseItemEnvelope::new(user_message("new real task")),
+        ResponseItemEnvelope::new(user_message(&"data".repeat(262144))),
+        ResponseItemEnvelope::new(user_message("tail")),
+    ]);
+    let prefix = smaller_request_byte_prefix(&history, 4).expect("strict useful prefix");
+    assert_eq!(prefix, 2);
+    assert_eq!(smaller_request_byte_prefix(&history, 2), None);
+    assert_eq!(smaller_manual_prefix(&history, 4), Some(2));
