+//! File-object coordination for cooperating native DACL writers.
+//! The target is exclusive; inherited ancestors are shared through the nearest
+//! protected boundary. Thus sibling updates proceed while parent propagation
+//! and a child's read/modify/write cannot overwrite one another.
+use crate::no_reparse_dir::{DirectoryOpenDisposition, open_directory_no_reparse};
+use crate::private_acl_lock::PrivateLockDirectory;
+use anyhow::{Context, Result, bail, ensure};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fs::{File, OpenOptions};
+use std::os::windows::ffi::OsStringExt;
+use std::os::windows::fs::OpenOptionsExt;
+use std::os::windows::io::{AsRawHandle, OwnedHandle};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+use windows_sys::Win32::Foundation::{ERROR_HANDLE_EOF, HANDLE, INVALID_HANDLE_VALUE, LocalFree};
+use windows_sys::Win32::Security::Authorization::GetSecurityInfo;
+use windows_sys::Win32::Security::{
+    DACL_SECURITY_INFORMATION, GetSecurityDescriptorControl, SE_DACL_PROTECTED,
+};
+use windows_sys::Win32::Storage::FileSystem as fs;
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct Identity {
+    volume: u64,
+    id: [u8; 16],
+}
+impl Identity {
+    fn read(handle: HANDLE) -> Result<Self> {
+        let mut info = fs::FILE_ID_INFO::default();
+        ensure!(
+            unsafe {
+                fs::GetFileInformationByHandleEx(
+                    handle,
+                    fs::FileIdInfo,
+                    (&mut info as *mut fs::FILE_ID_INFO).cast(),
+                    size_of::<fs::FILE_ID_INFO>() as u32,
+                )
+            } != 0,
+            "read ACL file identity: {}",
+            std::io::Error::last_os_error()
+        );
+        ensure!(
+            info.FileId.Identifier != [0; 16],
+            "ACL target has no stable file identity"
+        );
+        Ok(Self {
+            volume: info.VolumeSerialNumber,
+            id: info.FileId.Identifier,
+        })
+    }
+    fn leaf(&self) -> String {
+        format!(
+            "{:016x}-{}.lock",
+            self.volume,
+            self.id
+                .iter()
+                .map(|b| format!("{b:02x}"))
+                .collect::<String>()
+        )
+    }
+}
+fn physical_path(handle: HANDLE) -> Result<PathBuf> {
+    let mut buffer = vec![0u16; 32768];
+    let length = unsafe {
+        fs::GetFinalPathNameByHandleW(handle, buffer.as_mut_ptr(), buffer.len() as u32, 0)
+    };
+    ensure!(
+        length != 0 && (length as usize) < buffer.len(),
+        "resolve ACL file path: {}",
+        std::io::Error::last_os_error()
+    );
+    buffer.truncate(length as usize);
+    Ok(PathBuf::from(std::ffi::OsString::from_wide(&buffer)))
+}
+fn protected(handle: HANDLE) -> Result<bool> {
+    let mut sd = std::ptr::null_mut();
+    let status = unsafe {
+        GetSecurityInfo(
+            handle,
+            1,
+            DACL_SECURITY_INFORMATION,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            &mut sd,
+        )
+    };
+    let result = (|| {
+        ensure!(status == 0, "read ACL inheritance boundary: {status}");
+        let (mut control, mut revision) = (0, 0);
+        ensure!(
+            unsafe { GetSecurityDescriptorControl(sd, &mut control, &mut revision) } != 0,
+            "read ACL inheritance flags"
+        );
+        Ok(control & SE_DACL_PROTECTED != 0)
+    })();
+    if !sd.is_null() {
+        unsafe {
+            LocalFree(sd);
+        }
+    }
+    result
+}
+struct Pin {
+    handle: OwnedHandle,
+    protected: bool,
+}
+struct Plan {
+    modes: BTreeMap<Identity, bool>, // true = exclusive
+    pins: BTreeMap<Identity, Pin>,
+    links: BTreeMap<Identity, BTreeSet<PathBuf>>,
+}
+impl Plan {
+    fn new() -> Self {
+        Self {
+            modes: BTreeMap::new(),
+            pins: BTreeMap::new(),
+            links: BTreeMap::new(),
+        }
+    }
+    fn add_mode(&mut self, id: Identity, exclusive: bool) {
+        self.modes
+            .entry(id)
+            .and_modify(|mode| *mode |= exclusive)
+            .or_insert(exclusive);
+    }
+    fn ancestors(&mut self, path: &Path) -> Result<()> {
+        for path in path.ancestors() {
+            let handle = open_directory_no_reparse(
+                path,
+                fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+                DirectoryOpenDisposition::OpenExisting,
+            )?;
+            let id = Identity::read(handle.as_raw_handle() as _)?;
+            let boundary = protected(handle.as_raw_handle() as _)?;
+            self.add_mode(id.clone(), false);
+            self.pins.entry(id).or_insert(Pin {
+                handle,
+                protected: boundary,
+            });
+            if boundary {
+                break;
+            }
+        }
+        Ok(())
+    }
+    fn target(&mut self, target: HANDLE) -> Result<()> {
+        let path = physical_path(target)?;
+        let id = Identity::read(target)?;
+        let file = OpenOptions::new()
+            .access_mode(fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES)
+            .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE)
+            .custom_flags(fs::FILE_FLAG_BACKUP_SEMANTICS | fs::FILE_FLAG_OPEN_REPARSE_POINT)
+            .open(&path)?;
+        ensure!(
+            Identity::read(file.as_raw_handle() as _)? == id,
+            "ACL target identity changed"
+        );
+        let mut basic = fs::BY_HANDLE_FILE_INFORMATION::default();
+        ensure!(
+            unsafe { fs::GetFileInformationByHandle(file.as_raw_handle() as _, &mut basic) } != 0,
+            "inspect ACL target: {}",
+            std::io::Error::last_os_error()
+        );
+        ensure!(
+            basic.dwFileAttributes & fs::FILE_ATTRIBUTE_REPARSE_POINT == 0,
+            "resolved ACL target is a reparse point"
+        );
+        let is_dir = basic.dwFileAttributes & fs::FILE_ATTRIBUTE_DIRECTORY != 0;
+        let boundary = protected(file.as_raw_handle() as _)?;
+        let links = if !is_dir && basic.nNumberOfLinks > 1 {
+            hardlink_paths(&path)?
+        } else {
+            BTreeSet::from([path.clone()])
+        };
+        // Every hard-link parent can propagate onto this same file object.
+        if !boundary {
+            for link in &links {
+                if let Some(parent) = link.parent() {
+                    self.ancestors(parent)?;
+                }
+            }
+        }
+        self.links.insert(id.clone(), links);
+        self.add_mode(id.clone(), true);
+        let handle = if is_dir {
+            open_directory_no_reparse(
+                &path,
+                fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+                DirectoryOpenDisposition::OpenExisting,
+            )?
+        } else {
+            file.into()
+        };
+        ensure!(
+            Identity::read(handle.as_raw_handle() as _)? == id,
+            "ACL target changed while pinning"
+        );
+        self.pins.insert(
+            id,
+            Pin {
+                handle,
+                protected: boundary,
+            },
+        );
+        Ok(())
+    }
+    fn signature(
+        &self,
+    ) -> (
+        BTreeMap<Identity, bool>,
+        BTreeMap<Identity, bool>,
+        BTreeMap<Identity, BTreeSet<PathBuf>>,
+    ) {
+        (
+            self.modes.clone(),
+            self.pins
+                .iter()
+                .map(|(id, p)| (id.clone(), p.protected))
+                .collect(),
+            self.links.clone(),
+        )
+    }
+    fn validate(&self) -> Result<()> {
+        for (id, pin) in &self.pins {
+            ensure!(
+                Identity::read(pin.handle.as_raw_handle() as _)? == *id
+                    && protected(pin.handle.as_raw_handle() as _)? == pin.protected,
+                "ACL identity or inheritance boundary changed"
+            );
+        }
+        Ok(())
+    }
+}
+fn hardlink_paths(path: &Path) -> Result<BTreeSet<PathBuf>> {
+    let mut root = path.to_path_buf();
+    while root.parent().is_some() {
+        root.pop();
+    }
+    let mut buffer = vec![0u16; 32768];
+    let mut length = buffer.len() as u32;
+    let raw = unsafe {
+        fs::FindFirstFileNameW(
+            crate::winutil::to_wide(path).as_ptr(),
+            0,
+            &mut length,
+            buffer.as_mut_ptr(),
+        )
+    };
+    ensure!(
+        raw != INVALID_HANDLE_VALUE,
+        "enumerate ACL hard links: {}",
+        std::io::Error::last_os_error()
+    );
+    struct Search(HANDLE);
+    impl Drop for Search {
+        fn drop(&mut self) {
+            unsafe {
+                fs::FindClose(self.0);
+            }
+        }
+    }
+    let search = Search(raw);
+    let mut links = BTreeSet::new();
+    loop {
+        let end = buffer
+            .iter()
+            .position(|u| *u == 0)
+            .context("unterminated ACL hard-link path")?;
+        let relative = std::ffi::OsString::from_wide(&buffer[1..end]);
+        links.insert(root.join(relative));
+        buffer.fill(0);
+        length = buffer.len() as u32;
+        if unsafe { fs::FindNextFileNameW(search.0, &mut length, buffer.as_mut_ptr()) } == 0 {
+            let error = std::io::Error::last_os_error();
+            ensure!(
+                error.raw_os_error() == Some(ERROR_HANDLE_EOF as i32),
+                "enumerate next ACL hard link: {error}"
+            );
+            break;
+        }
+    }
+    Ok(links)
+}
+#[must_use]
+pub(crate) struct AclScope {
+    files: Vec<(String, File)>,
+    directory: PrivateLockDirectory,
+    _plan: Plan,
+}
+impl Drop for AclScope {
+    fn drop(&mut self) {
+        // Unlock/close before attempting exclusive DELETE open. Waiting users
+        // retain their own non-delete-shared handles, so their generation wins.
+        let leaves = self
+            .files
+            .drain(..)
+            .map(|(leaf, file)| {
+                drop(file);
+                leaf
+            })
+            .collect::<Vec<_>>();
+        for leaf in leaves {
+            // A cleanup failure never invalidates a completed ACL operation.
+            // The empty file remains safe and is retried by the next user.
+            let _ = self.directory.try_cleanup(&leaf);
+        }
+    }
+}
+pub(crate) fn acquire(target: HANDLE, deadline: Option<Instant>) -> Result<AclScope> {
+    acquire_many(&[target], deadline)
+}
+pub(crate) fn acquire_path(path: &Path, deadline: Option<Instant>) -> Result<(File, AclScope)> {
+    let file = OpenOptions::new()
+        .access_mode(fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES)
+        .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE)
+        .custom_flags(fs::FILE_FLAG_BACKUP_SEMANTICS)
+        .open(path)?;
+    let scope = acquire(file.as_raw_handle() as _, deadline)?;
+    Ok((file, scope))
+}
+/// Native setup has no independent five-second lifecycle limit. Cancellation
+/// ends its existing process/operation; the OS releases every held file lock.
+pub(crate) fn deadline() -> Option<Instant> {
+    None
+}
+fn before_deadline(deadline: Option<Instant>) -> bool {
+    deadline.is_none_or(|end| Instant::now() < end)
+}
+/// Open only the pinned object's physical name and verify its identity before
+/// mutation. The original caller's alias never participates in this write.
+pub(crate) fn write_handle(target: &File) -> Result<File> {
+    let file = OpenOptions::new()
+        .access_mode(fs::READ_CONTROL | fs::WRITE_DAC)
+        .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE)
+        .custom_flags(fs::FILE_FLAG_BACKUP_SEMANTICS | fs::FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(physical_path(target.as_raw_handle() as _)?)?;
+    ensure!(
+        Identity::read(file.as_raw_handle() as _)? == Identity::read(target.as_raw_handle() as _)?,
+        "locked ACL target identity changed before write"
+    );
+    Ok(file)
+}
+fn acquire_many(targets: &[HANDLE], deadline: Option<Instant>) -> Result<AclScope> {
+    loop {
+        let mut plan = Plan::new();
+        for target in targets {
+            plan.target(*target)?;
+        }
+        let directory = PrivateLockDirectory::open()?;
+        let mut scope = AclScope {
+            files: Vec::new(),
+            directory,
+            _plan: plan,
+        };
+        for (id, exclusive) in &scope._plan.modes {
+            let leaf = id.leaf();
+            let file = loop {
+                match scope.directory.open_leaf(&leaf) {
+                    Ok(file) => break file,
+                    Err(error)
+                        if before_deadline(deadline)
+                            && error
+                                .chain()
+                                .filter_map(|e| e.downcast_ref::<std::io::Error>())
+                                .any(|e| matches!(e.raw_os_error(), Some(32 | 303))) =>
+                    {
+                        std::thread::sleep(Duration::from_millis(5))
+                    }
+                    Err(error) => return Err(error).context("open ACL inheritance lock"),
+                }
+            };
+            loop {
+                let result = if *exclusive {
+                    file.try_lock()
+                } else {
+                    file.try_lock_shared()
+                };
+                match result {
+                    Ok(()) => break,
+                    Err(std::fs::TryLockError::WouldBlock) if before_deadline(deadline) => {
+                        std::thread::sleep(Duration::from_millis(5))
+                    }
+                    Err(std::fs::TryLockError::WouldBlock) => {
+                        bail!("timed out waiting for ACL inheritance domain ({leaf})")
+                    }
+                    Err(std::fs::TryLockError::Error(error)) => {
+                        return Err(error).context("lock ACL inheritance domain");
+                    }
+                }
+            }
+            // Retain the same file across every wait, hold and unlock.
+            scope.files.push((leaf, file));
+        }
+        let mut fresh = Plan::new();
+        for target in targets {
+            fresh.target(*target)?;
+        }
+        if scope._plan.signature() == fresh.signature() {
+            scope._plan.validate()?;
+            return Ok(scope);
+        }
+        drop(scope);
+        ensure!(
+            before_deadline(deadline),
+            "ACL inheritance domain changed while locking"
+        );
+    }
+}
