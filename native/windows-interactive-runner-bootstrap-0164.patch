+/// The trusted runner keeps the official NULL startup desktop on the actual
+/// interactive WinSta0. Its later restricted tool still opens the private desktop.
+/// Query one held current object; never rebind it or change its authorization.
+pub(crate) fn current_station_is_interactive_winsta0() -> Result<bool> {
+    let station = unsafe { GetProcessWindowStation() };
+    let name = station_name_for_handle(station)?;
+    let mut flags: windows_sys::Win32::System::StationsAndDesktops::USEROBJECTFLAGS =
+        unsafe { std::mem::zeroed() };
+    let mut returned = 0_u32;
+    anyhow::ensure!(
+        unsafe {
+            GetUserObjectInformationW(
+                station,
+                windows_sys::Win32::System::StationsAndDesktops::UOI_FLAGS,
+                (&mut flags
+                    as *mut windows_sys::Win32::System::StationsAndDesktops::USEROBJECTFLAGS)
+                    .cast(),
+                std::mem::size_of_val(&flags) as u32,
+                &mut returned,
+            )
+        } != 0
+            && returned as usize == std::mem::size_of_val(&flags),
+        "query held startup station flags failed: {}",
+        unsafe { GetLastError() }
+    );
+    Ok(flags.dwFlags & 1 != 0
+        && name.as_slice() == "WinSta0".encode_utf16().collect::<Vec<_>>().as_slice())
+}
