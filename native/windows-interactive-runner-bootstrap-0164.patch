+#[test]
+#[ignore = "requires own Limited Admin interactive WinSta0 and existing dedicated native home"]
+fn actual_interactive_native_null_bootstrap_readonly_without_station_grant() -> Result<()> {
+    let home = PathBuf::from(std::env::var_os("CDS_OWN_HOST_HOME").context("own home required")?);
+    let cwd = PathBuf::from(std::env::var_os("CDS_OWN_HOST_WORK").context("own work required")?);
+    let out = PathBuf::from(
+        std::env::var_os("CDS_OWN_NATIVE_STATION_OUT").context("own output required")?,
+    );
+    let target = std::env::var("CDS_OWN_EXPECTED_TARGET_SID")?;
+    let (caller, session, _) = caller_identity()?;
+    ensure!(
+        session > 0
+            && string_from_sid_bytes(&caller).map_err(anyhow::Error::msg)?
+                == std::env::var("CDS_OWN_EXPECTED_USER_SID")?,
+        "wrong own interactive caller/session"
+    );
+    ensure!(
+        crate::desktop::current_station_is_interactive_winsta0()?,
+        "test requires actual visible current WinSta0"
+    );
+    let station = unsafe { GetProcessWindowStation() };
+    let target_bytes = sid_bytes_from_string(&target)?;
+    let (_before, _, acl) = station_security(station)?;
+    ensure!(
+        target_masks(acl, &target_bytes)? == (0, 0),
+        "must begin without target station pregrant or deny"
+    );
+    let captured = native_readonly(&home, &cwd, "interactive-official-null-bootstrap", &target);
+    let (_after, _, actual) = station_security(station)?;
+    ensure!(
+        target_masks(actual, &target_bytes)? == (0, 0),
+        "native source must not add target WinSta0 rights"
+    );
+    let capture = captured?;
+    std::fs::write(
+        out.join("native-interactive-station-result.json"),
+        serde_json::to_vec_pretty(
+            &json!({"status":"ACTUAL_NATIVE_INTERACTIVE_NULL_BOOTSTRAP_READONLY_PASSED","trusted_runner_lpDesktop":"official NULL","restricted_tool_private_desktop_unchanged":true,"target_WinSta0_added_mask":0,"EXITWINDOWS_granted":false,"Default_desktop_granted":false,"external_pregrant":false,"production_function_invoked":true,"capture":capture}),
+        )?,
+    )?;
+    Ok(())
+}
