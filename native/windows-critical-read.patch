+fn grant_critical_read_acls(
+    payload: &Payload,
+    artifact_roots: &[PathBuf],
+    sandbox_group_psid: *mut c_void,
+    log: &mut dyn Write,
+) -> Result<Vec<PathBuf>> {
+    let mut critical_roots = artifact_roots
+        .iter()
+        .map(dunce::canonicalize)
+        .collect::<std::io::Result<Vec<_>>>()?;
+    for root in &payload.critical_read_roots {
+        let physical = dunce::canonicalize(root)
+            .with_context(|| format!("resolve critical read root {}", root.display()))?;
+        anyhow::ensure!(
+            payload.read_roots.iter().any(|allowed| {
+                dunce::canonicalize(allowed).is_ok_and(|allowed| allowed == physical)
+            }),
+            "critical read root is outside the authorized payload"
+        );
+        if !critical_roots.contains(&physical) {
+            critical_roots.push(physical);
+        }
+    }
+    for root in &critical_roots {
+        let inheritance = if root.is_dir() {
+            OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE
+        } else {
+            0
+        };
+        unsafe { crate::acl::grant_read_execute_aces(root, &[sandbox_group_psid], inheritance) }
+            .with_context(|| format!("apply critical read ACL to {}", root.display()))?;
+        anyhow::ensure!(
+            path_mask_allows(
+                root,
+                &[sandbox_group_psid],
+                FILE_GENERIC_READ | FILE_GENERIC_EXECUTE,
+                true,
+            )?,
+            "critical read root remains denied: {}",
+            root.display()
+        );
+        log_line(log, &format!("critical read ACL ready: {}", root.display()))?;
+    }
+    Ok(critical_roots)
+}
