+// Daemon prepare_install validates and publishes a complete immutable copy;
+// only that running CLI's own canonical release may become a sandbox read root.
+fn managed_package_read_root(
+    codex_home: &Path,
+    executable: &Path,
+    permissions: &ResolvedWindowsSandboxPermissions,
+    cwd: &Path,
+) -> Result<Option<PathBuf>> {
+    use std::os::windows::fs::MetadataExt;
+
+    let executable = dunce::canonicalize(executable)?;
+    let Some(bin) = executable.parent() else {
+        return Ok(None);
+    };
+    let Some(root) = bin.parent() else {
+        return Ok(None);
+    };
+    let expected = dunce::canonicalize(codex_home)?.join("packages/app-server-daemon/releases");
+    if bin.file_name() != Some(std::ffi::OsStr::new("bin"))
+        || root.parent() != Some(expected.as_path())
+    {
+        return Ok(None);
+    }
+    if !permissions.can_read_artifact_root(root, cwd) {
+        return Ok(None);
+    }
+    anyhow::ensure!(
+        executable == root.join("bin/codex.exe"),
+        "managed daemon read root does not contain the running CLI"
+    );
+    let manifest: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(root.join("codex-package.json"))?)?;
+    anyhow::ensure!(
+        manifest["layoutVersion"] == 1
+            && manifest["variant"] == "codex"
+            && manifest["target"] == "x86_64-pc-windows-msvc"
+            && manifest["entrypoint"] == "bin/codex.exe"
+            && manifest["pathDir"] == "codex-path"
+            && manifest["resourcesDir"] == "codex-resources",
+        "managed daemon read root has an incompatible package layout"
+    );
+    for name in [
+        "bin/codex.exe",
+        "bin/codex-code-mode-host.exe",
+        "codex-path/rg.exe",
+        "codex-resources/codex-command-runner.exe",
+        "codex-resources/codex-windows-sandbox-setup.exe",
+    ] {
+        anyhow::ensure!(
+            root.join(name).is_file(),
+            "managed daemon package is missing {name}"
+        );
+    }
+    let mut pending = vec![root.to_owned()];
+    while let Some(path) = pending.pop() {
+        let metadata = std::fs::symlink_metadata(&path)?;
+        anyhow::ensure!(
+            metadata.file_attributes()
+                & windows_sys::Win32::Storage::FileSystem::FILE_ATTRIBUTE_REPARSE_POINT
+                == 0,
+            "managed daemon read root contains a reparse point"
+        );
+        if metadata.is_dir() {
+            for entry in std::fs::read_dir(path)? {
+                pending.push(entry?.path());
+            }
+        } else {
+            anyhow::ensure!(
+                metadata.is_file(),
+                "managed daemon read root contains a special file"
+            );
+        }
+    }
+    Ok(Some(root.to_owned()))
+}
