+// Only concrete requested reads are launch-critical. Broad platform/profile
+// discovery remains background work; the final payload read set has already
+// applied explicit overrides, write-root separation and denied-read filtering.
+fn build_critical_read_roots(
+    request: &SandboxSetupRequest<'_>,
+    read_roots: &[PathBuf],
+    extra_read_roots: &[PathBuf],
+) -> Vec<PathBuf> {
+    let mut requested = request
+        .permissions
+        .readable_roots_for_cwd(request.command_cwd);
+    if request
+        .permissions
+        .can_read_artifact_root(request.command_cwd, request.command_cwd)
+    {
+        requested.push(request.command_cwd.to_owned());
+    }
+    requested.extend(extra_read_roots.iter().cloned());
+    let allowed: HashSet<_> = read_roots
+        .iter()
+        .map(|path| canonical_path_key(path))
+        .collect();
+    let mut seen = HashSet::new();
+    canonical_existing(&requested)
+        .into_iter()
+        .filter(|path| path.parent().is_some())
+        .filter(|path| {
+            let key = canonical_path_key(path);
+            allowed.contains(&key) && seen.insert(key)
+        })
+        .collect()
 }
 
