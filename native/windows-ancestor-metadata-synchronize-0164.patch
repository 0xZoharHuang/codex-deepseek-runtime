-fn metadata_mask(mask: u32) -> bool {
-    mask & (fs::FILE_READ_ATTRIBUTES | 0x8000_0000 | 0x2000_0000 | 0x1000_0000) != 0
+// CreateFileW attribute handles also request SYNCHRONIZE. Attributes alone
+// can pass GetFileAttributesW yet fail Node/libuv lstat on private ancestors.
+// Neither bit grants directory listing, data access, traversal or inheritance.
+const METADATA_ACCESS: u32 = fs::FILE_READ_ATTRIBUTES | fs::SYNCHRONIZE;
+
+fn metadata_rights(mask: u32) -> u32 {
+    let mut rights = mask & METADATA_ACCESS;
+    // File generic read/execute/all include both required rights; write only
+    // includes synchronize, and must not alone count as readable metadata.
+    if mask & (0x8000_0000 | 0x2000_0000 | 0x1000_0000) != 0 {
+        rights |= METADATA_ACCESS;
+    }
+    if mask & 0x4000_0000 != 0 {
+        rights |= fs::SYNCHRONIZE;
+    }
+    rights
 }
 
