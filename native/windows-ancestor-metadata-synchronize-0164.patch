     #[test]
+    fn metadata_handle_requires_both_rights_and_never_unions_distinct_users() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let directory = PinnedDirectory::open(root.path())?;
+        let dacl = Dacl::read(&directory)?;
+        let group = sid(1101);
+        let users = [sid(1103), sid(1104)];
+        let make = |who: &[u8], mask: u32, deny: bool| -> Result<Vec<u8>> {
+            let mut ace = metadata_ace(who)?;
+            ace[4..8].copy_from_slice(&mask.to_le_bytes());
+            ace[0] = u8::from(deny);
+            Ok(ace)
+        };
+        let common = [group.clone()];
+        let legacy = make(&group, fs::FILE_READ_ATTRIBUTES, false)?;
+        assert!(!readable_for_users(
+            &dacl,
+            &[legacy.clone()],
+            &common,
+            &users
+        )?);
+        assert!(readable_for_users(
+            &dacl,
+            &[legacy.clone(), metadata_ace(&group)?],
+            &common,
+            &users
+        )?);
+        let split = [
+            make(&users[0], fs::FILE_READ_ATTRIBUTES, false)?,
+            make(&users[1], fs::SYNCHRONIZE, false)?,
+        ];
+        assert!(!readable_for_users(&dacl, &split, &common, &users)?);
+        assert!(!readable_for_users(
+            &dacl,
+            &[metadata_ace(&users[0])?],
+            &common,
+            &users
+        )?);
+        let per_user = [metadata_ace(&users[0])?, metadata_ace(&users[1])?];
+        assert!(readable_for_users(&dacl, &per_user, &common, &users)?);
+        for user in &users {
+            for mask in [fs::FILE_READ_ATTRIBUTES, fs::SYNCHRONIZE, 0x4000_0000] {
+                assert!(
+                    readable_for_users(
+                        &dacl,
+                        &[metadata_ace(&group)?, make(user, mask, true)?],
+                        &common,
+                        &users
+                    )
+                    .is_err()
+                );
+            }
+        }
+        assert_eq!(metadata_rights(0x4000_0000), fs::SYNCHRONIZE);
+        for generic in [0x8000_0000, 0x2000_0000, 0x1000_0000] {
+            assert_eq!(metadata_rights(generic), METADATA_ACCESS);
+        }
+        assert!(!readable_for_users(
+            &dacl,
+            &[make(&group, 0x4000_0000, false)?],
+            &common,
+            &users
+        )?);
+        assert_eq!(
+            metadata_rights(fs::FILE_LIST_DIRECTORY | fs::FILE_WRITE_DATA),
+            0
+        );
+        Ok(())
+    }
