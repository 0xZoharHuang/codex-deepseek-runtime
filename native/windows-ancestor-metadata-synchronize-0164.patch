+    #[test]
+    fn metadata_upgrade_preserves_legacy_ace_and_is_idempotent() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let owner = SandboxNamespace::current(root.path())?.owner_sid;
+        let home = root.path().join("home");
+        create_explicit_inheritable_fixture(&home, &owner)?;
+        let namespace = SandboxNamespace::current(&home)?;
+        namespace.reserve_owner()?;
+        let group = sid(1101);
+        let pin = PinnedDirectory::open(&home)?;
+        let dacl = Dacl::read(&pin)?;
+        let mut entries = dacl.entries()?;
+        let mut legacy = metadata_ace(&group)?;
+        legacy[4..8].copy_from_slice(&fs::FILE_READ_ATTRIBUTES.to_le_bytes());
+        entries.push(legacy.clone());
+        dacl.write(&pin, &entries)?;
+        grant_pinned(&namespace, &group, &[pin], &[])?;
+        let after = Dacl::read(&PinnedDirectory::open(&home)?)?.entries()?;
+        assert_eq!(after.len(), entries.len() + 1);
+        assert!(exact_index(&after, &legacy)?.is_some());
+        assert!(exact_index(&after, &metadata_ace(&group)?)?.is_some());
+        grant_pinned(&namespace, &group, &[PinnedDirectory::open(&home)?], &[])?;
+        assert_eq!(
+            Dacl::read(&PinnedDirectory::open(&home)?)?.entries()?,
+            after
+        );
+        Ok(())
+    }
