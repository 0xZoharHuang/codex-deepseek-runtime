+    let mut value = format!("O:{owner_sid}D:P");
+    for (index, sid) in trustees.iter().enumerate() {
+        if !trustees[..index].contains(sid) {
+            value.push_str(&format!("(A;;FA;;;{sid})"));
+        }
+    }
