+// Object names are taken from the actual process station. Preserve their UTF-16
+// exactly instead of applying a lossy Unicode conversion or guessing WinSta0.
+const MAX_STARTUP_DESKTOP_UNITS: usize = 32 * 1024;
+
+fn validate_private_desktop_name(name: &str) -> Result<()> {
+    if !name
+        .strip_prefix(PRIVATE_DESKTOP_PREFIX)
+        .is_some_and(|nonce| {
+            !nonce.is_empty()
+                && nonce.len() <= 32
+                && nonce.bytes().all(|byte| byte.is_ascii_hexdigit())
+        })
+    {
+        anyhow::bail!("invalid private desktop name");
+    }
+    Ok(())
+}
+
+fn startup_desktop_name(station: &[u16], private_name: &str) -> Result<Vec<u16>> {
+    validate_private_desktop_name(private_name)?;
+    if station.is_empty() || station.iter().any(|unit| matches!(*unit, 0 | 47 | 92)) {
+        anyhow::bail!("invalid current window station name");
+    }
+    let units = station
+        .len()
+        .checked_add(private_name.len() + 2)
+        .filter(|units| *units <= MAX_STARTUP_DESKTOP_UNITS)
+        .ok_or_else(|| anyhow::anyhow!("startup desktop name exceeds bound"))?;
+    let mut value = Vec::with_capacity(units);
+    value.extend_from_slice(station);
+    value.push(b'\\' as u16);
+    value.extend(private_name.encode_utf16());
+    value.push(0);
+    Ok(value)
+}
+
+fn current_window_station_name() -> Result<Vec<u16>> {
+    // This is a borrowed process handle. It must not be closed or rebound.
+    let station = unsafe { GetProcessWindowStation() };
+    if station.is_null() {
+        anyhow::bail!("GetProcessWindowStation failed: {}", unsafe {
+            GetLastError()
+        });
+    }
+    let mut needed = 0_u32;
+    let probe =
+        unsafe { GetUserObjectInformationW(station, UOI_NAME, ptr::null_mut(), 0, &mut needed) };
+    let probe_error = if probe == 0 {
+        unsafe { GetLastError() }
+    } else {
+        0
+    };
+    if probe != 0
+        || probe_error != ERROR_INSUFFICIENT_BUFFER
+        || needed < 4
+        || needed % 2 != 0
+        || needed as usize > MAX_STARTUP_DESKTOP_UNITS * 2
+    {
+        anyhow::bail!("window station name query failed or exceeded bound: {probe_error}");
+    }
+    let mut name = vec![0_u16; needed as usize / 2];
+    let mut returned = needed;
+    let ok = unsafe {
+        GetUserObjectInformationW(
+            station,
+            UOI_NAME,
+            name.as_mut_ptr().cast(),
+            needed,
+            &mut returned,
+        )
+    };
+    if ok == 0 {
+        anyhow::bail!("GetUserObjectInformationW failed: {}", unsafe {
+            GetLastError()
+        });
+    }
+    if returned < 4 || returned % 2 != 0 || returned > needed {
+        anyhow::bail!("window station name length changed or is invalid");
+    }
+    name.truncate(returned as usize / 2);
+    if name.pop() != Some(0)
+        || name.is_empty()
+        || name.iter().any(|unit| matches!(*unit, 0 | 47 | 92))
+    {
+        anyhow::bail!("invalid current window station name");
+    }
+    Ok(name)
+}
