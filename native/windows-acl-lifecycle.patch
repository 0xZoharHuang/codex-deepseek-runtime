+// Only below-home parents of this request's already-authorized physical roots
+// enter the grant set. Journal-only paths are validated/revoked, never regranted.
+fn private_descendant(namespace: &SandboxNamespace, path: &Path) -> bool {
+    let key = crate::deny_read_acl::lexical_path_key(dunce::simplified(path));
+    let home = crate::deny_read_acl::lexical_path_key(dunce::simplified(&namespace.home));
+    key.starts_with(&(home + "/"))
+}
+
+fn pin_requested_parents(
+    namespace: &SandboxNamespace,
+    roots: &[PathBuf],
+) -> Result<Vec<PinnedDirectory>> {
+    use std::os::windows::fs::MetadataExt;
+    let mut pinned = pin_ancestors(namespace)?;
+    let own_home = pinned
+        .iter()
+        .find(|p| p.path == namespace.home)
+        .context("metadata home pin is missing")?
+        .identity
+        .clone();
+    let home_depth = dunce::simplified(&namespace.home).components().count();
+    for root in roots {
+        crate::no_reparse_dir::validate_local_directory_path(root)?;
+        if !private_descendant(namespace, root) {
+            continue;
+        }
+        let metadata = match std::fs::symlink_metadata(root) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(error) => return Err(error).context("inspect authorized metadata root"),
+        };
+        ensure!(
+            metadata.is_file() || metadata.is_dir(),
+            "authorized metadata root is not a regular file or directory"
+        );
+        ensure!(
+            metadata.file_attributes() & fs::FILE_ATTRIBUTE_REPARSE_POINT == 0,
+            "authorized metadata root is a reparse point"
+        );
+        // Case-folded text is only a candidate filter: Windows directories can
+        // be case-sensitive and Home/HOME can belong to different namespaces.
+        let boundary = root
+            .ancestors()
+            .find(|p| dunce::simplified(p).components().count() == home_depth)
+            .context("authorized root has no physical home boundary")?;
+        let requested_home = PinnedDirectory::open(boundary)?;
+        ensure!(
+            requested_home.identity == own_home,
+            "authorized root belongs to a different physical CODEX_HOME"
+        );
+        for parent in root.ancestors().skip(1) {
+            if !private_descendant(namespace, parent) {
+                break;
+            }
+            // NtCreateFile OBJ_DONT_REPARSE rejects every redirected component;
+            // FILE_TRAVERSE + no SHARE_DELETE pin the actual directory object.
+            // Distinct case-sensitive names can resolve to distinct objects.
+            let directory = PinnedDirectory::open(parent)?;
+            if !pinned
+                .iter()
+                .any(|item| item.identity == directory.identity)
+            {
+                pinned.push(directory);
+            }
+        }
+    }
+    pinned.sort_by_key(|item| item.path.components().count());
+    Ok(pinned)
+}
