+fn handle_path(handle: HANDLE, volume_guid: bool) -> Result<PathBuf> {
+    use std::os::windows::ffi::OsStringExt;
+    let mut name = vec![0_u16; 32_768];
+    let count = unsafe {
+        fs::GetFinalPathNameByHandleW(
+            handle,
+            name.as_mut_ptr(),
+            name.len() as u32,
+            if volume_guid { 1 } else { 0 },
+        )
+    };
+    ensure!(
+        count > 0 && (count as usize) < name.len(),
+        "resolve metadata object path: {}",
+        std::io::Error::last_os_error()
+    );
+    name.truncate(count as usize);
+    Ok(PathBuf::from(std::ffi::OsString::from_wide(&name)))
+}
+
+fn filesystem_name(handle: HANDLE) -> Result<String> {
+    let mut name = [0_u16; 32];
+    let mut label = [0_u16; 260];
+    let (mut serial, mut maximum, mut flags) = (0_u32, 0_u32, 0_u32);
+    let ok = unsafe {
+        fs::GetVolumeInformationByHandleW(
+            handle,
+            label.as_mut_ptr(),
+            label.len() as u32,
+            &mut serial,
+            &mut maximum,
+            &mut flags,
+            name.as_mut_ptr(),
+            name.len() as u32,
+        )
+    };
+    ensure!(
+        ok != 0,
+        "read metadata volume type: {}",
+        std::io::Error::last_os_error()
+    );
+    let end = name
+        .iter()
+        .position(|v| *v == 0)
+        .context("unterminated filesystem name")?;
+    Ok(String::from_utf16(&name[..end])?)
+}
