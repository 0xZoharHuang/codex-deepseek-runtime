+#[test]
+fn root_only_acl_update_without_write_dac_fails_unchanged() {
+    use std::os::windows::io::AsRawHandle;
+    let root = tempfile::tempdir().unwrap();
+    let before = acl_snapshot(root.path());
+    let handle = OpenOptions::new()
+        .access_mode(READ_CONTROL)
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+        .open(root.path())
+        .unwrap();
+    unsafe {
+        let (acl, sd) = fetch_dacl_handle(root.path()).unwrap();
+        let error =
+            super::set_directory_dacl_without_propagation(handle.as_raw_handle() as _, sd, acl)
+                .unwrap_err();
+        assert!(error.to_string().contains("root-only DACL"));
+        LocalFree(sd as HLOCAL);
+    }
+    assert_eq!(acl_snapshot(root.path()), before);
+}
