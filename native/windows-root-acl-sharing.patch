+// Keep the original write-capable handle so every assertion path restores the
+// isolated fixture, even after OWNER RIGHTS removes implicit WRITE_DAC.
+struct RestoreFixtureDacl {
+    handle: std::fs::File,
+    descriptor: *mut c_void,
+    dacl: *mut windows_sys::Win32::Security::ACL,
+}
+impl Drop for RestoreFixtureDacl {
+    fn drop(&mut self) {
+        use std::os::windows::io::AsRawHandle;
+        unsafe {
+            let _ = super::set_directory_dacl_without_propagation(
+                self.handle.as_raw_handle() as _,
+                self.descriptor,
+                self.dacl,
+            );
+            LocalFree(self.descriptor as HLOCAL);
+        }
+    }
+}
+fn install_readonly_fixture_dacl(path: &Path, target_deny: bool) -> RestoreFixtureDacl {
+    let handle = OpenOptions::new()
+        .access_mode(READ_CONTROL | super::WRITE_DAC)
+        .share_mode(super::FILE_SHARE_READ | super::FILE_SHARE_WRITE | super::FILE_SHARE_DELETE)
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+        .open(path)
+        .unwrap();
+    unsafe {
+        let (dacl, descriptor) = fetch_dacl_handle(path).unwrap();
+        let guard = RestoreFixtureDacl {
+            handle,
+            descriptor,
+            dacl,
+        };
+        let target = if target_deny {
+            "(D;;0x80;;;S-1-5-21-10-20-30-4248)"
+        } else {
+            "(A;;0x80;;;S-1-5-21-10-20-30-4248)"
+        };
+        let sddl = format!("D:P(D;;WD;;;OW)(D;;WD;;;WD)(A;;FR;;;WD){target}");
+        let mut next = std::ptr::null_mut();
+        assert_ne!(
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                to_wide(sddl).as_ptr(),
+                SDDL_REVISION_1,
+                &mut next,
+                std::ptr::null_mut()
+            ),
+            0
+        );
+        let outcome = SetFileSecurityW(
+            to_wide(path).as_ptr(),
+            DACL_SECURITY_INFORMATION
+                | windows_sys::Win32::Security::PROTECTED_DACL_SECURITY_INFORMATION,
+            next,
+        );
+        LocalFree(next as HLOCAL);
+        assert_ne!(outcome, 0);
+        guard
+    }
+}
+
+struct FixtureImpersonation;
+impl Drop for FixtureImpersonation {
+    fn drop(&mut self) {
+        unsafe {
+            windows_sys::Win32::Security::RevertToSelf();
+        }
+    }
+}
+fn disable_fixture_thread_privileges() -> FixtureImpersonation {
+    use windows_sys::Win32::Foundation::CloseHandle;
+    use windows_sys::Win32::Security::{
+        CreateRestrictedToken, ImpersonateLoggedOnUser, TOKEN_DUPLICATE, TOKEN_QUERY,
+    };
+    use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+    unsafe {
+        let mut original = std::ptr::null_mut();
+        assert_ne!(
+            OpenProcessToken(
+                GetCurrentProcess(),
+                TOKEN_DUPLICATE | TOKEN_QUERY,
+                &mut original
+            ),
+            0
+        );
+        let mut restricted = std::ptr::null_mut();
+        let created = CreateRestrictedToken(
+            original,
+            1,
+            0,
+            std::ptr::null(),
+            0,
+            std::ptr::null(),
+            0,
+            std::ptr::null(),
+            &mut restricted,
+        );
+        CloseHandle(original);
+        assert_ne!(created, 0);
+        let impersonated = ImpersonateLoggedOnUser(restricted);
+        CloseHandle(restricted);
+        assert_ne!(impersonated, 0);
+    }
+    FixtureImpersonation
+}
