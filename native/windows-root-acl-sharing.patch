+#[test]
+fn root_only_readonly_dacl_preserves_noop_and_refuses_required_write() {
+    use windows_sys::Win32::System::SystemServices::MAXIMUM_ALLOWED;
+    for target_deny in [false, true] {
+        let root = tempfile::tempdir().unwrap();
+        let target = LocalSid::from_string("S-1-5-21-10-20-30-4248").unwrap();
+        let other = LocalSid::from_string("S-1-5-21-10-20-30-4249").unwrap();
+        let _restore = install_readonly_fixture_dacl(root.path(), target_deny);
+        let _impersonation = disable_fixture_thread_privileges();
+        let before = acl_snapshot(root.path());
+        let denied = OpenOptions::new()
+            .access_mode(READ_CONTROL | super::WRITE_DAC)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(root.path())
+            .unwrap_err();
+        assert_eq!(denied.raw_os_error(), Some(ERROR_ACCESS_DENIED as i32));
+        let _old = OpenOptions::new()
+            .access_mode(MAXIMUM_ALLOWED)
+            .share_mode(super::FILE_SHARE_READ | super::FILE_SHARE_WRITE | super::FILE_SHARE_DELETE)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(root.path())
+            .unwrap();
+        assert!(!unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                root.path(),
+                &[target.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+            .unwrap()
+        });
+        assert_eq!(acl_snapshot(root.path()), before);
+        if !target_deny {
+            let error = unsafe {
+                ensure_allow_mask_aces_with_inheritance(
+                    root.path(),
+                    &[other.as_ptr()],
+                    FILE_READ_ATTRIBUTES,
+                    0,
+                )
+            }
+            .unwrap_err();
+            assert!(error.chain().any(|cause| {
+                cause
+                    .downcast_ref::<std::io::Error>()
+                    .and_then(std::io::Error::raw_os_error)
+                    == Some(ERROR_ACCESS_DENIED as i32)
+            }));
+            assert_eq!(acl_snapshot(root.path()), before);
+        }
+    }
+}
