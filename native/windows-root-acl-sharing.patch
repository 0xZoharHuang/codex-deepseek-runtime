+#[test]
+fn root_only_acl_update_with_read_watcher_preserves_children_and_flags() {
+    use windows_sys::Win32::Security::Authorization::SetNamedSecurityInfoW;
+    use windows_sys::Win32::Security::{
+        PROTECTED_DACL_SECURITY_INFORMATION, SE_DACL_AUTO_INHERITED,
+    };
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_LIST_DIRECTORY, FILE_SHARE_READ, FILE_SHARE_WRITE,
+    };
+    use windows_sys::Win32::System::SystemServices::MAXIMUM_ALLOWED;
+    for protected in [true, false] {
+        let temporary = tempfile::tempdir().unwrap();
+        let root = temporary.path().join("root");
+        std::fs::create_dir(&root).unwrap();
+        let marker = LocalSid::from_string("S-1-5-21-10-20-30-4245").unwrap();
+        let target = LocalSid::from_string("S-1-5-21-10-20-30-4246").unwrap();
+        unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                &root,
+                &[marker.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                super::CONTAINER_INHERIT_ACE | super::OBJECT_INHERIT_ACE,
+            )
+            .unwrap();
+            let (acl, sd) = fetch_dacl_handle(&root).unwrap();
+            let flag = if protected {
+                PROTECTED_DACL_SECURITY_INFORMATION
+            } else {
+                UNPROTECTED_DACL_SECURITY_INFORMATION
+            };
+            assert_eq!(
+                SetNamedSecurityInfoW(
+                    to_wide(&root).as_ptr() as _,
+                    1,
+                    DACL_SECURITY_INFORMATION | flag,
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                    acl,
+                    std::ptr::null_mut()
+                ),
+                0
+            );
+            LocalFree(sd as HLOCAL);
+        }
+        let child = root.join("child");
+        std::fs::create_dir(&child).unwrap();
+        let leaf = child.join("leaf");
+        std::fs::write(&leaf, "synthetic").unwrap();
+        let before = acl_snapshot(&root);
+        assert_eq!(before.0 & SE_DACL_PROTECTED != 0, protected);
+        if !protected {
+            assert_ne!(before.0 & SE_DACL_AUTO_INHERITED, 0);
+        }
+        let child_before = acl_snapshot(&child);
+        let leaf_before = acl_snapshot(&leaf);
+        let watcher = OpenOptions::new()
+            .access_mode(FILE_LIST_DIRECTORY)
+            .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(&root)
+            .unwrap();
+        let error = OpenOptions::new()
+            .access_mode(MAXIMUM_ALLOWED)
+            .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | super::FILE_SHARE_DELETE)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(&root)
+            .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(32));
+        assert!(unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                &root,
+                &[target.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+            .unwrap()
+        });
+        assert_eq!(acl_snapshot(&root).0, before.0);
+        assert_eq!(acl_snapshot(&child), child_before);
+        assert_eq!(acl_snapshot(&leaf), leaf_before);
+        assert!(
+            super::path_mask_allows(&root, &[target.as_ptr()], FILE_READ_ATTRIBUTES, true).unwrap()
+        );
+        assert!(
+            !super::path_mask_allows(&child, &[target.as_ptr()], FILE_READ_ATTRIBUTES, true)
+                .unwrap()
+        );
+        assert!(!unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                &root,
+                &[target.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+            .unwrap()
+        });
+        drop(watcher);
+    }
+}
