+#[test]
+fn root_only_acl_update_with_read_watcher_preserves_deny() {
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_LIST_DIRECTORY, FILE_SHARE_READ, FILE_SHARE_WRITE,
+    };
+    let root = tempfile::tempdir().unwrap();
+    let target = LocalSid::from_string("S-1-5-21-10-20-30-4247").unwrap();
+    unsafe {
+        super::add_deny_read_ace(root.path(), target.as_ptr()).unwrap();
+    }
+    let before = acl_snapshot(root.path());
+    let _watcher = OpenOptions::new()
+        .access_mode(FILE_LIST_DIRECTORY)
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE)
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
