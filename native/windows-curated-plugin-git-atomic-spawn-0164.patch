+++ b/codex-rs/utils/pty/src/win/background_output.rs
@@ -0,0 +1,297 @@
+//! Windows output capture for an already resolved, non-interactive executable.
+
+use super::JobObject;
+use super::procthreadattr::ProcThreadAttributeList;
+use super::psuedocon::append_quoted;
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::PipeReader;
+use std::io::Read;
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::FromRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::os::windows::process::ExitStatusExt;
+use std::path::Path;
+use std::process::Command;
+use std::process::ExitStatus;
+use std::process::Output;
+use std::ptr;
+use std::time::Duration;
+use std::time::Instant;
+use winapi::shared::winerror::ERROR_BROKEN_PIPE;
+use winapi::um::handleapi::DuplicateHandle;
+use winapi::um::namedpipeapi::PeekNamedPipe;
+use winapi::um::processthreadsapi::CreateProcessW;
+use winapi::um::processthreadsapi::GetCurrentProcess;
+use winapi::um::processthreadsapi::GetExitCodeProcess;
+use winapi::um::processthreadsapi::PROCESS_INFORMATION;
+use winapi::um::synchapi::WaitForSingleObject;
+use winapi::um::winbase::CREATE_NO_WINDOW;
+use winapi::um::winbase::CREATE_UNICODE_ENVIRONMENT;
+use winapi::um::winbase::EXTENDED_STARTUPINFO_PRESENT;
+use winapi::um::winbase::STARTF_USESTDHANDLES;
+use winapi::um::winbase::STARTUPINFOEXW;
+use winapi::um::winbase::WAIT_OBJECT_0;
+use winapi::um::winnt::DUPLICATE_SAME_ACCESS;
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CompareStringOrdinal(
+        a: *const u16,
+        a_len: i32,
+        b: *const u16,
+        b_len: i32,
+        ignore_case: i32,
+    ) -> i32;
+}
+
+fn wide(value: &OsStr) -> io::Result<Vec<u16>> {
+    let units: Vec<u16> = value.encode_wide().collect();
+    if units.contains(&0) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "NUL in process launch data",
+        ));
+    }
+    Ok(units)
+}
+
+fn windows_key_cmp(a: &[u16], b: &[u16]) -> Ordering {
+    // SAFETY: Each valid slice remains allocated during the Windows comparison.
+    let result =
+        unsafe { CompareStringOrdinal(a.as_ptr(), a.len() as i32, b.as_ptr(), b.len() as i32, 1) };
+    result.cmp(&2)
+}
+
+fn environment(command: &Command) -> io::Result<Vec<u16>> {
+    let mut entries: Vec<(Vec<u16>, Vec<u16>)> = std::env::vars_os()
+        .map(|(key, value)| Ok((wide(&key)?, wide(&value)?)))
+        .collect::<io::Result<_>>()?;
+    for (key, value) in command.get_envs() {
+        let key = wide(key)?;
+        let old = entries
+            .iter()
+            .position(|(name, _)| windows_key_cmp(name, &key).is_eq());
+        match (old, value) {
+            (Some(index), Some(value)) => entries[index].1 = wide(value)?,
+            (Some(index), None) => {
+                entries.swap_remove(index);
+            }
+            (None, Some(value)) => entries.push((key, wide(value)?)),
+            (None, None) => {}
+        }
+    }
+    entries.sort_by(|(a, _), (b, _)| windows_key_cmp(a, b));
+    let mut block = Vec::new();
+    for (name, value) in entries {
+        block.extend(name);
+        block.push(b'=' as u16);
+        block.extend(value);
+        block.push(0);
+    }
+    if block.is_empty() {
+        block.push(0);
+    }
+    block.push(0);
+    Ok(block)
+}
+
+fn working_directory(path: &Path) -> io::Result<Vec<u16>> {
+    let mut units = wide(path.as_os_str())?;
+    let verbatim: Vec<u16> = r"\\?\".encode_utf16().collect();
+    let unc: Vec<u16> = r"\\?\UNC\".encode_utf16().collect();
+    // CreateProcessW does not accept verbatim cwd syntax. Preserve only the
+    // equivalent absolute UNC or drive path, as std::process::Command does.
+    if units.starts_with(&unc) {
+        units.splice(..unc.len(), [b'\\' as u16, b'\\' as u16]);
+    } else if units.starts_with(&verbatim) && units.get(5..7) == Some(&[b':' as u16, b'\\' as u16])
+    {
+        units.drain(..verbatim.len());
+    }
+    units.push(0);
+    Ok(units)
+}
+
+fn inheritable(handle: &impl AsRawHandle) -> io::Result<OwnedHandle> {
+    let mut duplicate = ptr::null_mut();
+    // SAFETY: Duplicate a valid owned stdio handle in the same process.
+    let ok = unsafe {
+        let process = GetCurrentProcess();
+        DuplicateHandle(
+            process,
+            handle.as_raw_handle().cast(),
+            process,
+            &mut duplicate,
+            0,
+            1,
+            DUPLICATE_SAME_ACCESS,
+        )
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: The duplicate is a distinct, owned handle.
+    Ok(unsafe { OwnedHandle::from_raw_handle(duplicate.cast()) })
+}
+
+fn pipe_bytes(reader: &PipeReader) -> io::Result<u32> {
+    let mut available = 0;
+    // SAFETY: This only queries our live read end and does not consume data.
+    let ok = unsafe {
+        PeekNamedPipe(
+            reader.as_raw_handle().cast(),
+            ptr::null_mut(),
+            0,
+            ptr::null_mut(),
+            &mut available,
+            ptr::null_mut(),
+        )
+    };
+    if ok == 0 {
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() != Some(ERROR_BROKEN_PIPE as i32) {
+            return Err(error);
+        }
+    }
+    Ok(available)
+}
+
+fn drain(reader: &mut PipeReader, output: &mut Vec<u8>, limit: u32) -> io::Result<()> {
+    // Exactly one reader owns this end, so bytes reported by PeekNamedPipe are
+    // immediately readable. Do not wait for EOF on these private Git pipes.
+    let count = pipe_bytes(reader)?.min(limit);
+    reader.take(u64::from(count)).read_to_end(output)?;
+    Ok(())
+}
+
+impl JobObject {
+    /// Run a trusted absolute Windows executable with null stdin and captured output.
+    /// The command inherits the ambient environment with `get_envs()` edits applied;
+    /// callers must not use `env_clear`, raw arguments, or custom stdio/creation flags.
+    pub fn output_std_atomic(&self, command: &Command, timeout: Duration) -> io::Result<Output> {
+        let program = command.get_program();
+        if !Path::new(program).is_absolute()
+            || !Path::new(program)
+                .extension()
+                .is_some_and(|ext| ext.eq_ignore_ascii_case("exe"))
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "expected an absolute Windows executable path",
+            ));
+        }
+        let mut application = wide(program)?;
+        application.push(0);
+        let mut line = Vec::new();
+        append_quoted(program, &mut line);
+        for arg in command.get_args() {
+            wide(arg)?;
+            line.push(b' ' as u16);
+            append_quoted(arg, &mut line);
+        }
+        line.push(0);
+        let cwd = command
+            .get_current_dir()
+            .map(working_directory)
+            .transpose()?;
+        let mut environment = environment(command)?;
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        let (mut stdout_reader, stdout_writer) = io::pipe()?;
+        let (mut stderr_reader, stderr_writer) = io::pipe()?;
+        let child = {
+            let null = OpenOptions::new().read(true).open("NUL")?;
+            let stdin = inheritable(&null)?;
+            let stdout = inheritable(&stdout_writer)?;
+            let stderr = inheritable(&stderr_writer)?;
+            let mut attributes =
+                ProcThreadAttributeList::with_capacity(2).map_err(io::Error::other)?;
+            attributes
+                .set_job(self.as_raw_handle().cast())
+                .map_err(io::Error::other)?;
+            attributes
+                .set_handle_list(vec![
+                    stdin.as_raw_handle().cast(),
+                    stdout.as_raw_handle().cast(),
+                    stderr.as_raw_handle().cast(),
+                ])
+                .map_err(io::Error::other)?;
+            // SAFETY: Zero-initialized Win32 structs get their required fields below.
+            let mut startup: STARTUPINFOEXW = unsafe { std::mem::zeroed() };
+            let mut process: PROCESS_INFORMATION = unsafe { std::mem::zeroed() };
+            startup.StartupInfo.cb = std::mem::size_of::<STARTUPINFOEXW>() as u32;
+            startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+            startup.StartupInfo.hStdInput = stdin.as_raw_handle().cast();
+            startup.StartupInfo.hStdOutput = stdout.as_raw_handle().cast();
+            startup.StartupInfo.hStdError = stderr.as_raw_handle().cast();
+            startup.lpAttributeList = attributes.as_mut_ptr();
+            // SAFETY: The buffers and owned handles outlive the call. Windows
+            // attaches the job during creation and inherits only the three handles.
+            let ok = unsafe {
+                CreateProcessW(
+                    application.as_ptr(),
+                    line.as_mut_ptr(),
+                    ptr::null_mut(),
+                    ptr::null_mut(),
+                    1,
+                    CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT,
+                    environment.as_mut_ptr().cast(),
+                    cwd.as_ref().map_or(ptr::null(), Vec::as_ptr),
+                    &mut startup.StartupInfo,
+                    &mut process,
+                )
+            };
+            if ok == 0 {
+                return Err(io::Error::last_os_error());
+            }
+            // SAFETY: A successful spawn returns two uniquely owned handles.
+            let _thread = unsafe { OwnedHandle::from_raw_handle(process.hThread.cast()) };
+            unsafe { OwnedHandle::from_raw_handle(process.hProcess.cast()) }
+        };
+        drop((stdout_writer, stderr_writer));
+        let start = Instant::now();
+        let process = child.as_raw_handle().cast();
+        loop {
+            drain(&mut stdout_reader, &mut stdout, 64 * 1024)?;
+            drain(&mut stderr_reader, &mut stderr, 64 * 1024)?;
+            let wait_ms = timeout.saturating_sub(start.elapsed()).as_millis().min(10) as u32;
+            // SAFETY: The child process handle remains owned for the whole wait.
+            let wait = unsafe { WaitForSingleObject(process, wait_ms) };
+            if wait == WAIT_OBJECT_0 {
+                let mut code = 0;
+                // SAFETY: This is the same signaled process handle and valid output storage.
+                if unsafe { GetExitCodeProcess(process, &mut code) } == 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                self.terminate()?;
+                drain(&mut stdout_reader, &mut stdout, u32::MAX)?;
+                drain(&mut stderr_reader, &mut stderr, u32::MAX)?;
+                return Ok(Output {
+                    status: ExitStatus::from_raw(code),
+                    stdout,
+                    stderr,
+                });
+            }
+            if wait != 0x102 {
+                return Err(io::Error::last_os_error());
+            }
+            if start.elapsed() >= timeout {
+                self.terminate()?;
+                drain(&mut stderr_reader, &mut stderr, u32::MAX)?;
+                let message = String::from_utf8_lossy(&stderr);
+                let suffix = if message.trim().is_empty() {
+                    String::new()
+                } else {
+                    format!(": {}", message.trim())
+                };
+                return Err(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    format!("timed out after {}s{suffix}", timeout.as_secs()),
+                ));
+            }
+        }
+    }
+}
