+#[test]
+fn unrelated_inheritable_handle_is_excluded_from_git_child() {
+    const EVENT_ENV: &str = "CODEX_TEST_PLUGIN_GIT_INHERITABLE_EVENT";
+    if let Some(raw) = std::env::var_os(EVENT_ENV) {
+        let raw = raw.to_str().unwrap().parse::<usize>().unwrap();
+        // If the child has this exact inherited event, it can signal the parent.
+        // A coincidentally recycled local handle cannot signal the parent's event.
+        unsafe { SetEvent(raw as *mut std::ffi::c_void) };
+        return;
+    }
+    let name = concat!(
+        module_path!(),
+        "::unrelated_inheritable_handle_is_excluded_from_git_child"
+    )
+    .split_once("::")
+    .unwrap()
+    .1;
+    // SAFETY: Successful CreateEventW returns a uniquely owned non-inheritable event.
+    let raw = unsafe { CreateEventW(std::ptr::null_mut(), 0, 0, std::ptr::null()) };
+    assert!(!raw.is_null());
+    let event = unsafe { OwnedHandle::from_raw_handle(raw) };
+    assert_ne!(
+        unsafe { SetHandleInformation(event.as_raw_handle(), 1, 1) },
+        0
+    );
+    let mut command = Command::new(std::env::current_exe().unwrap());
+    command
+        .args(["--exact", name, "--nocapture"])
+        .env(EVENT_ENV, (event.as_raw_handle() as usize).to_string());
+    let output = run_git_command_with_timeout(
+        &mut command,
+        "Git handle isolation fixture",
+        Duration::from_secs(3),
+    )
+    .unwrap();
+    assert!(output.status.success());
+    assert_eq!(
+        unsafe { WaitForSingleObject(event.as_raw_handle(), 0) },
+        258
+    );
+    // Positive control proves the fixture detects broad stdio-handle inheritance.
+    assert!(command.output().unwrap().status.success());
+    assert_eq!(unsafe { WaitForSingleObject(event.as_raw_handle(), 0) }, 0);
+}
