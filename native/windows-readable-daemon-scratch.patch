+
+    #[tokio::test]
+    async fn scratch_pins_home_and_target_until_launch_scope_ends() {
+        crate::backend::windows::ensure_not_elevated().expect("actual non-elevated test");
+        let home = tempfile::tempdir().expect("own home");
+        let state = home.path().join("state");
+        codex_uds::prepare_private_socket_directory(&state)
+            .await
+            .expect("state");
+        let saved = home.path().with_extension("scratch-pin-test");
+        std::fs::rename(home.path(), &saved).expect("rename authority before pin");
+        std::fs::rename(&saved, home.path()).expect("restore home before pin");
+        let guards = prepare(&state.join("server.pid")).await.expect("scratch");
+        let scratch = guards.path.clone();
+        let moved = home.path().join("scratch-moved");
+        let home_error = std::fs::rename(home.path(), &saved).expect_err("home pinned");
+        let scratch_error = std::fs::rename(&scratch, &moved).expect_err("scratch pinned");
+        assert!(matches!(home_error.raw_os_error(), Some(5 | 32)));
+        assert!(matches!(scratch_error.raw_os_error(), Some(5 | 32)));
+        drop(guards);
+        std::fs::rename(&scratch, &moved).expect("scratch unpinned");
+        std::fs::rename(&moved, &scratch).expect("restore own scratch");
+        std::fs::rename(home.path(), &saved).expect("home unpinned");
+        std::fs::rename(&saved, home.path()).expect("restore own home");
+    }
+
+    #[test]
+    fn scratch_owner_guard_rejects_foreign_system_directory_read_only() {
+        crate::backend::windows::ensure_not_elevated().expect("actual non-elevated test");
+        // Read-only owner/control metadata. No grant, directory creation, or ACL
+        // change is attempted against the OS directory.
+        let system =
+            PathBuf::from(std::env::var_os("SystemRoot").expect("SystemRoot")).join("System32");
+        let handle = open_directory(&system).expect("public OS directory readable");
