+//! Windows-only managed-child scratch. Keep writable cwd outside private IPC state.
+use anyhow::Context;
+use anyhow::Result;
+use std::io;
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::FromRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::path::Path;
+use std::path::PathBuf;
+use std::ptr;
+use tokio::fs;
+use windows_sys::Win32::Foundation::{INVALID_HANDLE_VALUE, LocalFree};
+use windows_sys::Win32::Security::Authorization::{GetSecurityInfo, SE_FILE_OBJECT};
+use windows_sys::Win32::Security::{
+    EqualSid, GetTokenInformation, OWNER_SECURITY_INFORMATION, TOKEN_QUERY, TOKEN_USER, TokenUser,
+};
+use windows_sys::Win32::Storage::FileSystem::{
+    BY_HANDLE_FILE_INFORMATION, CreateFileW, FILE_ATTRIBUTE_DIRECTORY,
+    FILE_ATTRIBUTE_REPARSE_POINT, FILE_FLAG_BACKUP_SEMANTICS, FILE_FLAG_OPEN_REPARSE_POINT,
+    FILE_ID_INFO, FILE_READ_ATTRIBUTES, FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_TRAVERSE,
+    FileIdInfo, GetFileInformationByHandle, GetFileInformationByHandleEx, OPEN_EXISTING,
+    READ_CONTROL,
+};
+use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+#[derive(Debug)]
+pub(super) struct WorkingDirectory {
+    pub(super) path: PathBuf,
+    // No SHARE_DELETE: retain the trusted state, home and scratch through spawn.
+    _guards: Vec<OwnedHandle>,
+}
+
+pub(super) async fn prepare(pid_file: &Path) -> Result<WorkingDirectory> {
+    let state = pid_file.parent().context("daemon pid path has no parent")?;
+    // Reuse the unchanged IPC validator as the authoritative state-root boundary.
+    // No placeholder file is opened or created.
+    let (probe, state_guard) =
+        codex_uds::validate_private_socket_path(&state.join("__scratch_owner_guard__"))?;
+    let state = probe
+        .parent()
+        .context("canonical state path has no parent")?;
+    let home = state
+        .parent()
+        .context("daemon state directory has no home")?;
+    // Pin each canonical parent before resolving the next component, so a
+    // sibling path cannot be redirected through an ancestor rename/junction.
+    let mut home_guards = pin_home_ancestors(home)?;
+    validate_current_owner(home_guards.last().context("daemon home is missing")?)
+        .context("daemon home owner differs from current user")?;
+    let state_again = open_directory(state).context("confirm state under pinned home")?;
+    if directory_identity(&state_guard)? != directory_identity(&state_again)? {
+        anyhow::bail!("daemon state no longer belongs to pinned home");
+    }
+    let mut name = state
+        .file_name()
+        .context("daemon state directory has no name")?
+        .to_os_string();
+    name.push("-workdir");
+    let scratch = state.with_file_name(name);
+    match fs::symlink_metadata(&scratch).await {
+        Ok(_) => {}
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            // Fresh creation uses the existing exact User-owned/private constructor.
+            if let Err(create_error) = codex_uds::prepare_private_socket_directory(&scratch).await {
+                // Another same-user start can create and already use this exact
+                // scratch between the existence check and the private ctor.
+                // Reuse is permitted only through the identical no-reparse,
+                // current-owner handle checks below; never repair its DACL.
+                let existing = open_directory(&scratch)
+                    .with_context(|| format!("create private daemon scratch: {create_error}"))?;
+                validate_current_owner(&existing)
+                    .with_context(|| format!("create private daemon scratch: {create_error}"))?;
+            }
+        }
+        Err(error) => return Err(error).context("inspect daemon scratch"),
+    }
+    // Existing scratch may legitimately have sandbox WRITE grants. Preserve that
+    // DACL; check the actual opened object, not a prior lstat or private-ACL repair.
+    let scratch_guard = open_directory(&scratch).context("pin daemon scratch")?;
+    validate_current_owner(&scratch_guard)
+        .context("daemon scratch owner differs from current user")?;
+    home_guards.extend([state_guard, state_again, scratch_guard]);
+    Ok(WorkingDirectory {
+        path: scratch,
+        _guards: home_guards,
+    })
+}
+
+fn open_directory(path: &Path) -> io::Result<OwnedHandle> {
+    open_directory_access(path, READ_CONTROL | FILE_READ_ATTRIBUTES | FILE_TRAVERSE)
+}
+
+fn open_directory_access(path: &Path, access: u32) -> io::Result<OwnedHandle> {
+    let wide: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+    let handle = unsafe {
+        CreateFileW(
+            wide.as_ptr(),
+            access,
+            FILE_SHARE_READ | FILE_SHARE_WRITE,
+            ptr::null(),
+            OPEN_EXISTING,
+            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT,
+            ptr::null_mut(),
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        return Err(io::Error::last_os_error());
+    }
+    let guard = unsafe { OwnedHandle::from_raw_handle(handle) };
+    let mut info: BY_HANDLE_FILE_INFORMATION = unsafe { std::mem::zeroed() };
+    if unsafe { GetFileInformationByHandle(guard.as_raw_handle(), &mut info) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY == 0
+        || info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT != 0
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "untrusted daemon scratch directory",
+        ));
+    }
+    Ok(guard)
+}
+
+fn pin_home_ancestors(home: &Path) -> io::Result<Vec<OwnedHandle>> {
+    let mut paths = home.ancestors().collect::<Vec<_>>();
+    paths.reverse();
+    let mut guards = Vec::with_capacity(paths.len());
+    for path in paths {
+        // Ancestors only need traversal/attributes to pin them; do not demand
+        // READ_CONTROL or directory listing on an otherwise usable prefix.
+        let access =
+            FILE_READ_ATTRIBUTES | FILE_TRAVERSE | if path == home { READ_CONTROL } else { 0 };
+        guards.push(open_directory_access(path, access)?);
+    }
+    Ok(guards)
+}
+
+fn directory_identity(handle: &OwnedHandle) -> io::Result<(u64, [u8; 16])> {
+    let mut info: FILE_ID_INFO = unsafe { std::mem::zeroed() };
+    if unsafe {
+        GetFileInformationByHandleEx(
+            handle.as_raw_handle(),
+            FileIdInfo,
+            (&mut info as *mut FILE_ID_INFO).cast(),
+            std::mem::size_of::<FILE_ID_INFO>() as u32,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok((info.VolumeSerialNumber, info.FileId.Identifier))
+}
+
+fn current_user() -> io::Result<Vec<usize>> {
+    let mut token = ptr::null_mut();
+    if unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let token = unsafe { OwnedHandle::from_raw_handle(token) };
+    let mut size = 0;
+    unsafe {
+        GetTokenInformation(
+            token.as_raw_handle(),
+            TokenUser,
+            ptr::null_mut(),
+            0,
+            &mut size,
+        );
+    }
+    if size == 0 || size > 65_536 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid TokenUser size",
+        ));
+    }
+    // Match the existing uds current_user pointer-aligned TOKEN_USER buffer.
+    let mut user = vec![0usize; (size as usize).div_ceil(std::mem::size_of::<usize>())];
+    if unsafe {
+        GetTokenInformation(
+            token.as_raw_handle(),
+            TokenUser,
+            user.as_mut_ptr().cast(),
+            size,
+            &mut size,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(user)
+}
+
+fn validate_current_owner(guard: &OwnedHandle) -> io::Result<()> {
+    let user = current_user()?;
+    let user_sid = unsafe { (*(user.as_ptr().cast::<TOKEN_USER>())).User.Sid };
+    let mut owner = ptr::null_mut();
+    let mut descriptor = ptr::null_mut();
+    let status = unsafe {
+        GetSecurityInfo(
+            guard.as_raw_handle(),
+            SE_FILE_OBJECT,
+            OWNER_SECURITY_INFORMATION,
+            &mut owner,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    if status != 0 {
+        return Err(io::Error::from_raw_os_error(status as i32));
+    }
+    let trusted = !owner.is_null() && unsafe { EqualSid(owner, user_sid) } != 0;
+    unsafe {
+        LocalFree(descriptor as _);
+    }
+    if !trusted {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "foreign daemon scratch owner",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use windows_sys::Win32::Security::DACL_SECURITY_INFORMATION;
+    use windows_sys::Win32::Security::GetKernelObjectSecurity;
+
+    fn raw_security(path: &Path) -> Vec<u8> {
+        let handle = open_directory(path).expect("open own test directory");
+        let mut size = 0;
+        unsafe {
+            GetKernelObjectSecurity(
+                handle.as_raw_handle(),
+                OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                ptr::null_mut(),
+                0,
+                &mut size,
+            );
+        }
+        assert!((20..=65536).contains(&size));
+        let mut data = vec![0u8; size as usize];
+        assert_ne!(
+            unsafe {
+                GetKernelObjectSecurity(
+                    handle.as_raw_handle(),
+                    OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                    data.as_mut_ptr().cast(),
+                    data.len() as u32,
+                    &mut size,
+                )
+            },
+            0
+        );
+        data.truncate(size as usize);
+        data
+    }
+
+    #[tokio::test]
+    async fn scratch_keeps_existing_workspace_write_acl_and_ipc_private() {
+        crate::backend::windows::ensure_not_elevated().expect("actual non-elevated test");
+        let home = tempfile::tempdir().expect("own home");
+        let state = home.path().join("state");
+        codex_uds::prepare_private_socket_directory(&state)
+            .await
+            .expect("state");
+        let pid = state.join("server.pid");
+        let first = prepare(&pid).await.expect("fresh scratch");
+        let scratch = first.path.clone();
+        let before_state = raw_security(&state);
+        // A resolvable built-in group receives the native workspace Modify mask.
+        // No account/group is created, or directory outside this temp changed.
+        let sid = "*S-1-5-32-545:(OI)(CI)(M)";
+        let status = std::process::Command::new(
+            PathBuf::from(std::env::var_os("SystemRoot").expect("SystemRoot"))
+                .join("System32/icacls.exe"),
+        )
+        .arg(&scratch)
+        .args(["/grant", sid])
+        .status()
+        .expect("icacls");
+        assert!(status.success());
+        let writable = raw_security(&scratch);
+        drop(first);
+        let second = prepare(&pid)
+            .await
+            .expect("reuse authorized writable scratch");
+        assert_eq!(second.path, scratch);
+        assert_eq!(raw_security(&scratch), writable);
+        assert_eq!(raw_security(&state), before_state);
+        codex_uds::prepare_private_socket_directory(&state)
+            .await
+            .expect("IPC still private");
+    }
+
+    #[tokio::test]
+    async fn scratch_rejects_same_owner_junction_without_touching_target() {
+        crate::backend::windows::ensure_not_elevated().expect("actual non-elevated test");
+        let home = tempfile::tempdir().expect("own home");
+        let state = home.path().join("state");
+        codex_uds::prepare_private_socket_directory(&state)
+            .await
+            .expect("state");
+        let target = home.path().join("target");
+        codex_uds::prepare_private_socket_directory(&target)
+            .await
+            .expect("target");
+        std::fs::write(target.join("canary"), "unchanged").expect("canary");
+        let before = raw_security(&target);
+        let scratch = home.path().join("state-workdir");
+        let status = std::process::Command::new(
+            PathBuf::from(std::env::var_os("SystemRoot").expect("SystemRoot"))
+                .join("System32")
+                .join("cmd.exe"),
+        )
+        .args(["/d", "/c", "mklink", "/J"])
+        .arg(&scratch)
+        .arg(&target)
+        .status()
+        .expect("create own junction");
+        assert!(status.success());
+        let error = prepare(&state.join("server.pid"))
+            .await
