+    fn stable_identity() {
+        let a = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        assert_eq!(a, NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001"));
+        assert_eq!(a.offline().len(), 20);
