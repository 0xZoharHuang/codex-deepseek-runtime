+            let status = unsafe { NtResumeProcess(process_handle.cast()) };
+            if NT_SUCCESS(status) {
+                Ok(())
+            } else {
+                Err(io::Error::other(format!(
+                    "failed to resume contained process: NTSTATUS {status:#x}"
+                )))
+            }
+        });
+        if let Err(error) = started {
+            // std::process::Child does not kill on drop. In particular, failed
+            // assignment must not leave a suspended, uncontained child behind.
+            let cleanup = child.kill().and_then(|()| child.wait().map(|_| ()));
+            return match cleanup {
+                Ok(()) => Err(error),
+                Err(cleanup_error) => Err(io::Error::other(format!(
+                    "{error}; failed to reap suspended child: {cleanup_error}"
+                ))),
+            };
+        }
+        Ok(child)
+    }
