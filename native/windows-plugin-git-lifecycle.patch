+//! Exercises the real plugin Git runner with a child that retains inherited pipes.
+use super::run_git_command_with_timeout;
+use std::fs;
+use std::io::Write;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+const PHASE: &str = "CODEX_TEST_PLUGIN_GIT_LIFETIME_PHASE";
+const ROOT: &str = "CODEX_TEST_PLUGIN_GIT_LIFETIME_ROOT";
+
+#[repr(C)]
+#[derive(Default)]
+struct FileTime {
+    low: u32,
+    high: u32,
+}
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> *mut std::ffi::c_void;
+    fn WaitForSingleObject(handle: *mut std::ffi::c_void, milliseconds: u32) -> u32;
+    fn TerminateProcess(handle: *mut std::ffi::c_void, exit_code: u32) -> i32;
+    fn GetCurrentProcess() -> *mut std::ffi::c_void;
+    fn GetProcessTimes(
+        handle: *mut std::ffi::c_void,
+        created: *mut FileTime,
+        exited: *mut FileTime,
+        kernel: *mut FileTime,
+        user: *mut FileTime,
+    ) -> i32;
+}
+
+fn creation_time(handle: *mut std::ffi::c_void) -> u64 {
+    let (mut created, mut exited, mut kernel, mut user) = (
+        FileTime::default(),
+        FileTime::default(),
+        FileTime::default(),
+        FileTime::default(),
+    );
+    assert_ne!(
+        unsafe { GetProcessTimes(handle, &mut created, &mut exited, &mut kernel, &mut user) },
+        0
+    );
+    (u64::from(created.high) << 32) | u64::from(created.low)
+}
+
+fn write_leaf_identity(root: &Path) {
+    let birth = creation_time(unsafe { GetCurrentProcess() });
+    fs::write(
+        root.join("leaf.tmp"),
+        format!("{}:{birth}", std::process::id()),
+    )
+    .expect("leaf identity");
+    fs::rename(root.join("leaf.tmp"), root.join("leaf.pid")).expect("publish leaf identity");
+}
+
+struct LeafHandle(OwnedHandle);
+impl LeafHandle {
+    fn exited(&self) -> bool {
+        unsafe { WaitForSingleObject(self.0.as_raw_handle(), 2000) == 0 }
+    }
+}
+impl Drop for LeafHandle {
+    fn drop(&mut self) {
+        if unsafe { WaitForSingleObject(self.0.as_raw_handle(), 0) } != 0 {
+            // Preserve failure while cleaning only the fixture process captured before ack.
+            unsafe { TerminateProcess(self.0.as_raw_handle(), 1) };
+        }
+    }
+}
+
+fn wait_path(path: &Path) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !path.exists() {
+        assert!(Instant::now() < deadline, "fixture handshake timed out");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn command(name: &str, root: &Path, phase: &str) -> Command {
+    let mut command = Command::new(std::env::current_exe().expect("current test executable"));
+    command
+        .args(["--exact", name, "--nocapture"])
+        .env(PHASE, phase)
+        .env(ROOT, root);
+    command
+}
+
+fn fixture(name: &str) -> bool {
+    let Ok(phase) = std::env::var(PHASE) else {
+        return false;
+    };
+    let root = PathBuf::from(std::env::var_os(ROOT).expect("fixture root"));
+    if phase == "leaf" {
+        write_leaf_identity(&root);
+        wait_path(&root.join("leaf.ack"));
+        std::thread::sleep(Duration::from_secs(60));
+        return true;
+    }
+    if phase == "nonzero" {
+        println!("PLUGIN_STDOUT");
+        eprintln!("PLUGIN_STDERR");
+        std::io::stdout().flush().expect("flush stdout");
+        std::io::stderr().flush().expect("flush stderr");
+        std::process::exit(7);
+    }
+    let _leaf = command(name, &root, "leaf")
+        .stdin(Stdio::null())
+        .stdout(Stdio::inherit())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .expect("spawn fixture leaf");
+    wait_path(&root.join("leaf.ack"));
+    println!("PLUGIN_STDOUT");
+    eprintln!("PLUGIN_STDERR");
+    std::io::stdout().flush().expect("flush stdout");
+    std::io::stderr().flush().expect("flush stderr");
+    if phase == "timeout" {
+        std::thread::sleep(Duration::from_secs(60));
+    }
+    true
+}
+
+fn observe_leaf(root: &Path) -> LeafHandle {
+    wait_path(&root.join("leaf.pid"));
+    // The leaf cannot exit before this ack, so capture its kernel handle before the root exits.
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let (pid, birth) = loop {
+        if let Ok(text) = fs::read_to_string(root.join("leaf.pid"))
+            && let Some((pid, birth)) = text.split_once(':')
+            && let (Ok(pid), Ok(birth)) = (pid.parse::<u32>(), birth.parse::<u64>())
+        {
+            break (pid, birth);
+        }
+        assert!(
+            Instant::now() < deadline,
+            "invalid or incomplete fixture identity"
+        );
+        std::thread::sleep(Duration::from_millis(1));
+    };
+    let raw = unsafe { OpenProcess(0x0010_1001, 0, pid) }; // SYNCHRONIZE | QUERY_LIMITED_INFORMATION | TERMINATE
+    assert!(
+        !raw.is_null(),
+        "open exact fixture process: {}",
+        std::io::Error::last_os_error()
+    );
+    let owned = unsafe { OwnedHandle::from_raw_handle(raw) };
+    // Do not construct the cleanup guard until the captured kernel identity is verified.
+    assert_eq!(
+        creation_time(owned.as_raw_handle()),
+        birth,
+        "fixture PID was reused"
+    );
+    assert_eq!(
+        unsafe { WaitForSingleObject(owned.as_raw_handle(), 0) },
+        258,
+        "fixture exited before ack"
+    );
+    let handle = LeafHandle(owned);
+    fs::write(root.join("leaf.ack"), b"observed").expect("ack fixture identity");
+    handle
+}
+
+#[test]
+fn root_exit_reaps_descendants_before_collecting_output() {
+    let full_name = concat!(
+        module_path!(),
+        "::root_exit_reaps_descendants_before_collecting_output"
+    );
+    let name = full_name
+        .split_once("::")
+        .expect("crate-qualified test module")
+        .1;
+    if fixture(name) {
+        return;
+    }
+    let root = tempfile::tempdir().expect("fixture root");
+    std::thread::scope(|scope| {
+        let observer = scope.spawn(|| observe_leaf(root.path()));
+        let started = Instant::now();
+        let output = run_git_command_with_timeout(
+            &mut command(name, root.path(), "success"),
+            "owned plugin test",
+            Duration::from_secs(2),
+        )
+        .expect("successful root");
+        let leaf = observer.join().expect("leaf observer");
+        assert!(started.elapsed() < Duration::from_secs(5));
+        assert!(output.status.success());
+        assert!(String::from_utf8_lossy(&output.stdout).contains("PLUGIN_STDOUT"));
+        assert!(String::from_utf8_lossy(&output.stderr).contains("PLUGIN_STDERR"));
+        assert!(leaf.exited(), "root exit left a descendant");
+    });
+}
+
+#[test]
+fn timeout_reaps_descendants_before_collecting_output() {
+    let full_name = concat!(
+        module_path!(),
+        "::timeout_reaps_descendants_before_collecting_output"
+    );
+    let name = full_name
+        .split_once("::")
+        .expect("crate-qualified test module")
+        .1;
+    if fixture(name) {
+        return;
+    }
+    let root = tempfile::tempdir().expect("fixture root");
+    std::thread::scope(|scope| {
+        let observer = scope.spawn(|| observe_leaf(root.path()));
+        let started = Instant::now();
+        let error = run_git_command_with_timeout(
+            &mut command(name, root.path(), "timeout"),
+            "owned plugin test",
+            Duration::from_secs(2),
+        )
+        .expect_err("timeout must be an error");
+        let leaf = observer.join().expect("leaf observer");
+        assert!(started.elapsed() < Duration::from_secs(5));
+        assert!(error.contains("timed out after 2s"));
+        assert!(error.contains("PLUGIN_STDERR"));
+        assert!(leaf.exited(), "timeout left a descendant");
+    });
+}
+
+#[test]
+fn nonzero_exit_preserves_status_and_both_output_streams() {
+    let full_name = concat!(
+        module_path!(),
+        "::nonzero_exit_preserves_status_and_both_output_streams"
+    );
+    let name = full_name
+        .split_once("::")
+        .expect("crate-qualified test module")
+        .1;
+    if fixture(name) {
+        return;
+    }
+    let root = tempfile::tempdir().expect("fixture root");
+    let output = run_git_command_with_timeout(
+        &mut command(name, root.path(), "nonzero"),
+        "owned plugin test",
+        Duration::from_secs(2),
+    )
+    .expect("capture nonzero exit");
+    assert_eq!(output.status.code(), Some(7));
+    assert!(String::from_utf8_lossy(&output.stdout).contains("PLUGIN_STDOUT"));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("PLUGIN_STDERR"));
+}
+
+#[test]
+fn spawn_failure_remains_an_error() {
+    let root = tempfile::tempdir().expect("fixture root");
+    let error = run_git_command_with_timeout(
+        &mut Command::new(root.path().join("not-present.exe")),
+        "owned plugin test",
+        Duration::from_secs(2),
+    )
+    .expect_err("missing program");
+    assert!(error.contains("failed to run owned plugin test"));
+}
