+//! Synchronous plugin launches use the existing strict native Job ownership.
+use super::*;
+use std::fs;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::process::{Command as StdCommand, Stdio};
+use std::time::{Duration, Instant};
+use winapi::um::synchapi::WaitForSingleObject;
+use winapi::um::winnt::JOB_OBJECT_LIMIT_ACTIVE_PROCESS;
+use winapi::um::winnt::SYNCHRONIZE;
+
+const PHASE: &str = "CODEX_TEST_STD_JOB_PHASE";
+const ROOT: &str = "CODEX_TEST_STD_JOB_ROOT";
+
+fn wait_path(path: &Path) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !path.exists() {
+        assert!(Instant::now() < deadline, "fixture handshake timed out");
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+fn child_command(name: &str, root: &Path, phase: &str) -> StdCommand {
+    let mut command = StdCommand::new(std::env::current_exe().expect("test executable"));
+    command
+        .args(["--exact", name, "--nocapture"])
+        .env(PHASE, phase)
+        .env(ROOT, root);
+    command
+}
+fn creation_time(handle: HANDLE) -> u64 {
+    let mut created: winapi::shared::minwindef::FILETIME = unsafe { std::mem::zeroed() };
+    let mut exited = created;
+    let mut kernel = created;
+    let mut user = created;
+    assert_ne!(
+        unsafe {
+            winapi::um::processthreadsapi::GetProcessTimes(
+                handle,
+                &mut created,
+                &mut exited,
+                &mut kernel,
+                &mut user,
+            )
+        },
+        0
+    );
+    (u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime)
+}
+fn write_leaf_identity(root: &Path) {
+    let birth = creation_time(unsafe { winapi::um::processthreadsapi::GetCurrentProcess() });
+    fs::write(
+        root.join("leaf.tmp"),
+        format!("{}:{birth}", std::process::id()),
+    )
+    .expect("leaf identity");
+    fs::rename(root.join("leaf.tmp"), root.join("leaf.pid")).expect("publish leaf identity");
+}
+fn open_leaf(root: &Path) -> OwnedHandle {
+    wait_path(&root.join("leaf.pid"));
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let (pid, birth) = loop {
+        if let Ok(text) = fs::read_to_string(root.join("leaf.pid"))
+            && let Some((pid, birth)) = text.split_once(':')
+            && let (Ok(pid), Ok(birth)) = (pid.parse::<u32>(), birth.parse::<u64>())
+        {
+            break (pid, birth);
+        }
+        assert!(
+            Instant::now() < deadline,
+            "invalid or incomplete fixture identity"
+        );
+        std::thread::sleep(Duration::from_millis(1));
+    };
+    let raw = unsafe { OpenProcess(SYNCHRONIZE | PROCESS_TERMINATE | 0x1000, 0, pid) };
+    assert!(!raw.is_null(), "open leaf: {}", io::Error::last_os_error());
+    let handle = unsafe { OwnedHandle::from_raw_handle(raw.cast()) };
+    assert_eq!(
+        creation_time(handle.as_raw_handle().cast()),
+        birth,
+        "fixture PID was reused"
+    );
+    assert_eq!(
+        unsafe { WaitForSingleObject(handle.as_raw_handle().cast(), 0) },
+        258,
+        "fixture exited before observation"
+    );
+    handle
+}
+
+#[test]
+fn std_contained_assignment_failure_never_runs_child() {
+    let full_name = concat!(
+        module_path!(),
+        "::std_contained_assignment_failure_never_runs_child"
+    );
+    let name = full_name
+        .split_once("::")
+        .expect("crate-qualified test module")
+        .1;
+    if let Ok(phase) = std::env::var(PHASE) {
+        let root = PathBuf::from(std::env::var_os(ROOT).expect("fixture root"));
+        if phase == "hold" {
+            write_leaf_identity(&root);
+            std::thread::sleep(Duration::from_secs(60));
+        } else {
+            fs::write(root.join("unexpected-child-body"), b"ran").expect("unexpected body");
+        }
+        return;
+    }
+    let root = tempfile::tempdir().expect("fixture root");
+    let job = JobObject::create_without_breakaway().expect("job");
+    let mut limits: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = unsafe { std::mem::zeroed() };
+    limits.BasicLimitInformation.LimitFlags =
+        JOB_OBJECT_LIMIT_ACTIVE_PROCESS | JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    limits.BasicLimitInformation.ActiveProcessLimit = 1;
+    let configured = unsafe {
+        SetInformationJobObject(
+            job.as_raw_handle().cast(),
+            JobObjectExtendedLimitInformation,
+            std::ptr::addr_of_mut!(limits).cast(),
+            std::mem::size_of_val(&limits) as u32,
+        )
+    };
+    assert_ne!(configured, 0);
+    let mut holder = job
+        .spawn_std_contained(
+            child_command(name, root.path(), "hold")
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null()),
+        )
+        .expect("first job member");
+    let handle = open_leaf(root.path());
+    let rejected = job.spawn_std_contained(
+        child_command(name, root.path(), "rejected")
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null()),
+    );
+    assert!(
+        rejected.is_err(),
+        "full job must reject instead of fallback"
+    );
+    assert!(!root.path().join("unexpected-child-body").exists());
+    let mut flags = 0;
+    assert_ne!(
+        unsafe {
+            winapi::um::handleapi::GetHandleInformation(job.as_raw_handle().cast(), &mut flags)
+        },
+        0
+    );
+    assert_eq!(flags & winapi::um::winbase::HANDLE_FLAG_INHERIT, 0);
+    job.terminate().expect("terminate exact job");
+    holder.wait().expect("reap holder");
+    assert_eq!(
+        unsafe { WaitForSingleObject(handle.as_raw_handle().cast(), 2000) },
+        0
+    );
+}
+
+#[test]
+fn std_contained_owner_exit_closes_tree_and_output_pipes() {
+    let full_name = concat!(
+        module_path!(),
+        "::std_contained_owner_exit_closes_tree_and_output_pipes"
+    );
+    let name = full_name
+        .split_once("::")
+        .expect("crate-qualified test module")
+        .1;
+    if let Ok(phase) = std::env::var(PHASE) {
+        let root = PathBuf::from(std::env::var_os(ROOT).expect("fixture root"));
+        if phase == "leaf" {
+            write_leaf_identity(&root);
+            std::thread::sleep(Duration::from_secs(60));
+            return;
+        }
+        let job = JobObject::create_without_breakaway().expect("job");
+        let _child = job
+            .spawn_std_contained(
+                child_command(name, &root, "leaf")
+                    .stdin(Stdio::null())
+                    .stdout(Stdio::inherit())
+                    .stderr(Stdio::inherit()),
+            )
+            .expect("contained leaf");
+        // The controller captures the leaf handle before closing stdin or terminating this owner.
+        wait_path(&root.join("leaf.pid"));
+        let mut input = Vec::new();
+        std::io::stdin()
+            .read_to_end(&mut input)
+            .expect("read owner stdin");
+        std::process::exit(0); // Deliberately bypass Rust Drop; kernel job-handle closure must suffice.
+    }
+    for shutdown in ["eof", "terminate"] {
+        let root = tempfile::tempdir().expect("fixture root");
+        let mut owner = child_command(name, root.path(), "owner")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .expect("fixture owner");
+        let leaf = open_leaf(root.path());
+        if shutdown == "eof" {
+            drop(owner.stdin.take());
+        } else {
+            owner.kill().expect("terminate exact owner");
+        }
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while owner.try_wait().expect("owner status").is_none() {
+            if Instant::now() >= deadline {
+                let _ = owner.kill();
+                panic!("fixture owner did not exit");
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        let exited = unsafe { WaitForSingleObject(leaf.as_raw_handle().cast(), 2000) } == 0;
+        if !exited {
+            unsafe { TerminateProcess(leaf.as_raw_handle().cast(), 1) };
+        }
+        assert!(exited, "{shutdown} left the contained leaf alive");
+        let output = owner.wait_with_output().expect("pipes must reach EOF");
+        if shutdown == "eof" {
+            assert!(output.status.success());
+        }
+    }
+}
