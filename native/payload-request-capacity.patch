+fn manual_prefix_has_input(items: &[ResponseItemEnvelope]) -> bool {
+    items.iter().any(|envelope| {
+        is_real_user_or_agent_message(&envelope.item)
+            || matches!(
+                &envelope.item,
+                ResponseItem::FunctionCallOutput { .. }
+                    | ResponseItem::CustomToolCallOutput { .. }
+                    | ResponseItem::ToolSearchOutput { .. }
+            )
+    })
+}
+
+fn smaller_manual_prefix(
+    history: &crate::context_manager::ContextManager,
+    selected: usize,
+) -> Option<usize> {
+    let items = history.annotated_items();
+    // The previous native summary and retained context are the starting context,
+    // not a new legacy chunk. A partial retry must include useful input after it
+    // instead of repeatedly summarizing only an already summarized window prefix.
+    let progress_start = items
+        .iter()
+        .rposition(|item| {
+            matches!(
+                &item.item,
+                ResponseItem::Message {
+                    internal_chat_message_metadata_passthrough: Some(metadata),
+                    ..
+                } if metadata.content_item_kinds.as_ref().is_some_and(|kinds| {
+                    kinds.iter().any(|kind| kind.0 == CompactionSummary::KIND)
+                })
+            )
+        })
+        .map_or(0, |index| index + 1);
+    let candidate = |proposed| {
+        let len = history.pair_safe_prefix_len(proposed);
+        (len > progress_start
+            && len < selected
+            && manual_prefix_has_input(&items[progress_start..len]))
+        .then_some(len)
+    };
+    if selected <= 1 || selected > items.len() {
+        return None;
+    }
+    candidate(selected / 2).or_else(|| candidate(selected - 1))
+}
