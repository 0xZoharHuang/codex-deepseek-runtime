+            "invalid request-capacity security descriptor"
+        );
+        Ok(raw)
+    }
+    fn within(raw: &[u32], pointer: *const c_void, bytes: usize) -> bool {
+        let start = raw.as_ptr() as usize;
+        let end = start + std::mem::size_of_val(raw);
+        let value = pointer as usize;
+        value >= start && value.checked_add(bytes).is_some_and(|limit| limit <= end)
+    }
+    pub(super) fn validate_owner(
+        file: &File,
+        owner: &str,
+        directory: bool,
+        private: bool,
+    ) -> Result<()> {
+        let mut info = fs::BY_HANDLE_FILE_INFORMATION::default();
+        ensure!(
+            unsafe { fs::GetFileInformationByHandle(file.as_raw_handle() as _, &mut info) } != 0,
+            "read request-capacity metadata"
+        );
+        ensure!(
+            info.dwFileAttributes & fs::FILE_ATTRIBUTE_REPARSE_POINT == 0
+                && (info.dwFileAttributes & fs::FILE_ATTRIBUTE_DIRECTORY != 0) == directory
+                && (directory || info.nNumberOfLinks == 1),
+            "capacity object is linked or has wrong type"
+        );
+        let raw = security(file)?;
+        let descriptor = raw.as_ptr().cast_mut().cast();
+        let mut actual_owner = std::ptr::null_mut();
+        let mut defaulted = 0;
+        ensure!(
+            unsafe { GetSecurityDescriptorOwner(descriptor, &mut actual_owner, &mut defaulted) }
+                != 0
+                && within(&raw, actual_owner, 8)
+                && unsafe { IsValidSid(actual_owner) } != 0,
+            "invalid capacity owner descriptor"
+        );
+        let expected = owner_bytes()?;
+        ensure!(
+            current_owner()? == owner
+                && within(&raw, actual_owner, unsafe { GetLengthSid(actual_owner) }
+                    as usize)
+                && unsafe { EqualSid(actual_owner, expected.as_ptr().cast_mut().cast()) } != 0,
+            "request-capacity object belongs to another owner"
+        );
+        if private {
+            let (mut control, mut revision, mut present) = (0, 0, 0);
+            ensure!(
+                unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) }
+                    != 0
+                    && control & SE_DACL_PROTECTED != 0,
+                "capacity private DACL is not protected"
+            );
+            let mut acl: *mut ACL = std::ptr::null_mut();
+            ensure!(
+                unsafe {
+                    GetSecurityDescriptorDacl(descriptor, &mut present, &mut acl, &mut defaulted)
+                } != 0
+                    && present != 0
+                    && within(&raw, acl.cast(), size_of::<ACL>())
+                    && unsafe { IsValidAcl(acl) } != 0
+                    && within(&raw, acl.cast(), unsafe { (*acl).AclSize } as usize),
+                "invalid request-capacity private ACL"
+            );
+            let system = [1_u8, 1, 0, 0, 0, 0, 0, 5, 18, 0, 0, 0];
+            for index in 0..unsafe { (*acl).AceCount } as u32 {
+                let mut entry = std::ptr::null_mut();
+                ensure!(
+                    unsafe { GetAce(acl, index, &mut entry) } != 0
+                        && within(&raw, entry, size_of::<ACE_HEADER>()),
+                    "invalid capacity private ACE"
+                );
+                let header = unsafe { &*entry.cast::<ACE_HEADER>() };
+                ensure!(
+                    matches!(header.AceType, 0 | 1) && within(&raw, entry, header.AceSize as usize),
+                    "unsupported capacity private ACE"
+                );
+                if header.AceType == 0 {
+                    ensure!(
+                        header.AceSize as usize >= size_of::<ACCESS_ALLOWED_ACE>(),
+                        "truncated capacity allow ACE"
+                    );
+                    let ace = unsafe { &*entry.cast::<ACCESS_ALLOWED_ACE>() };
+                    let sid = (&raw const ace.SidStart).cast_mut().cast();
+                    ensure!(
+                        unsafe { IsValidSid(sid) } != 0
+                            && unsafe { GetLengthSid(sid) } as usize <= header.AceSize as usize - 8,
+                        "invalid capacity allow trustee"
+                    );
+                    ensure!(
+                        unsafe { EqualSid(sid, expected.as_ptr().cast_mut().cast()) } != 0
+                            || unsafe { EqualSid(sid, system.as_ptr().cast_mut().cast()) } != 0,
+                        "capacity private object grants another principal"
+                    );
+                }
+            }
+        }
+        Ok(())
+    }
+    struct PrivateDescriptor(HANDLE);
+    impl PrivateDescriptor {
+        fn new(owner: &str) -> Result<Self> {
+            let text = format!("O:{owner}D:P(A;OICI;FA;;;{owner})(A;OICI;FA;;;SY)");
+            let name = wide(Path::new(&text));
+            let mut descriptor = std::ptr::null_mut();
+            ensure!(
+                unsafe {
+                    ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                        name.as_ptr(),
+                        1,
+                        &mut descriptor,
+                        std::ptr::null_mut(),
+                    )
+                } != 0,
+                "create private request-capacity descriptor"
+            );
+            Ok(Self(descriptor))
+        }
+        fn attributes(&self) -> SECURITY_ATTRIBUTES {
+            SECURITY_ATTRIBUTES {
+                nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+                lpSecurityDescriptor: self.0,
+                bInheritHandle: 0,
+            }
+        }
+    }
+    impl Drop for PrivateDescriptor {
+        fn drop(&mut self) {
+            unsafe {
+                LocalFree(self.0);
+            }
+        }
+    }
+    impl Directory {
+        pub(super) fn open_home(path: &Path) -> Result<Self> {
+            let handle = codex_windows_sandbox::open_directory_no_reparse(
+                path,
+                fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+                codex_windows_sandbox::DirectoryOpenDisposition::OpenExisting,
+            )?;
+            Ok(Self {
+                file: File::from(handle),
+                path: path.to_owned(),
+                parents: Vec::new(),
+            })
+        }
+        pub(super) fn child(
+            &self,
+            component: &str,
+            create: bool,
+            private: bool,
+        ) -> Result<Option<Self>> {
+            ensure!(
+                !component.contains(['/', '\\']) && !matches!(component, "." | ".."),
+                "invalid capacity path component"
+            );
+            let path = self.path.join(component);
+            if create {
+                let descriptor = PrivateDescriptor::new(&current_owner()?)?;
+                let attributes = descriptor.attributes();
+                if unsafe { fs::CreateDirectoryW(wide(&path).as_ptr(), &attributes) } == 0 {
+                    let error = std::io::Error::last_os_error();
+                    if error.kind() != std::io::ErrorKind::AlreadyExists {
+                        return Err(error.into());
+                    }
+                }
+            }
+            let mut directory = match Self::open_home(&path) {
+                Ok(value) => value,
+                Err(error)
+                    if !create
+                        && error
+                            .downcast_ref::<std::io::Error>()
+                            .is_some_and(|e| e.kind() == std::io::ErrorKind::NotFound) =>
+                {
+                    return Ok(None);
+                }
+                Err(error) => return Err(error),
+            };
+            validate_owner(&directory.file, &current_owner()?, true, private)?;
+            directory.parents = self
+                .parents
+                .iter()
+                .map(File::try_clone)
+                .collect::<std::io::Result<Vec<_>>>()?;
+            directory.parents.push(self.file.try_clone()?);
+            Ok(Some(directory))
+        }
+        fn open(
+            &self,
+            component: &str,
+            create: bool,
+            exclusive: bool,
+            write: bool,
+        ) -> Result<Option<File>> {
+            ensure!(
+                !component.contains(['/', '\\']) && !matches!(component, "." | ".."),
+                "invalid capacity file component"
+            );
+            let descriptor = PrivateDescriptor::new(&current_owner()?)?;
+            let attributes = descriptor.attributes();
+            let access = fs::READ_CONTROL
+                | fs::FILE_READ_ATTRIBUTES
+                | 0x8000_0000
+                | if write { 0x4000_0000 } else { 0 };
+            let share = if exclusive {
+                0
+            } else if write {
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE
+            } else {
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE
+            };
+            let handle = unsafe {
+                fs::CreateFileW(
+                    wide(&self.path.join(component)).as_ptr(),
+                    access,
+                    share,
+                    &attributes,
+                    if exclusive {
+                        fs::CREATE_NEW
+                    } else if create {
+                        fs::OPEN_ALWAYS
+                    } else {
+                        fs::OPEN_EXISTING
+                    },
+                    fs::FILE_FLAG_OPEN_REPARSE_POINT | fs::FILE_ATTRIBUTE_NORMAL,
+                    std::ptr::null_mut(),
+                )
+            };
+            if handle == INVALID_HANDLE_VALUE {
+                let error = std::io::Error::last_os_error();
+                if !create && error.kind() == std::io::ErrorKind::NotFound {
+                    return Ok(None);
+                }
+                return Err(error.into());
+            }
+            Ok(Some(File::from(unsafe {
+                OwnedHandle::from_raw_handle(handle)
+            })))
+        }
+        pub(super) fn open_existing(&self, component: &str) -> Result<Option<File>> {
+            self.open(component, false, false, false)
+        }
+        pub(super) fn open_lock(&self, component: &str) -> Result<File> {
+            self.open(component, true, false, true)?
+                .context("capacity lock unavailable")
+        }
+        pub(super) fn open_existing_lock(&self, component: &str) -> Result<Option<File>> {
+            self.open(component, false, false, true)
+        }
+        pub(super) fn remove_owned(&self, component: &str, owner: &str) -> Result<bool> {
+            ensure!(
+                !component.contains(['/', '\\']) && !matches!(component, "." | ".."),
+                "invalid capacity cleanup component"
+            );
+            let handle = unsafe {
+                fs::CreateFileW(
+                    wide(&self.path.join(component)).as_ptr(),
+                    fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::DELETE,
+                    fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE,
+                    std::ptr::null(),
+                    fs::OPEN_EXISTING,
+                    fs::FILE_FLAG_OPEN_REPARSE_POINT,
+                    std::ptr::null_mut(),
+                )
+            };
+            if handle == INVALID_HANDLE_VALUE {
+                let error = std::io::Error::last_os_error();
+                if error.kind() == std::io::ErrorKind::NotFound {
+                    return Ok(false);
+                }
+                return Err(error.into());
+            }
+            let file = File::from(unsafe { OwnedHandle::from_raw_handle(handle) });
+            validate_owner(&file, owner, false, true)?;
+            ensure!(
+                file.metadata()?.len() <= MAX_METADATA_BYTES as u64,
+                "reserved request-capacity metadata exceeds cleanup bound"
+            );
+            let info = fs::FILE_DISPOSITION_INFO { DeleteFile: true };
+            ensure!(
+                unsafe {
+                    fs::SetFileInformationByHandle(
+                        file.as_raw_handle() as _,
+                        fs::FileDispositionInfo,
+                        (&raw const info).cast(),
+                        size_of::<fs::FILE_DISPOSITION_INFO>() as u32,
+                    )
+                } != 0,
+                "remove owned request-capacity checkpoint: {}",
+                std::io::Error::last_os_error()
+            );
+            Ok(true)
+        }
+
+        pub(super) fn replace(&self, component: &str, bytes: &[u8], owner: &str) -> Result<()> {
+            let temporary = format!(".capacity-{}.tmp", uuid::Uuid::new_v4());
+            let path = self.path.join(&temporary);
+            let mut file = self
+                .open(&temporary, true, true, true)?
+                .context("capacity temporary file unavailable")?;
+            let result = (|| -> Result<()> {
+                validate_owner(&file, owner, false, true)?;
+                file.write_all(bytes)?;
+                file.sync_all()?;
+                drop(file);
+                std::fs::rename(&path, self.path.join(component))?;
+                Ok(())
+            })();
+            if result.is_err() {
+                let _ = std::fs::remove_file(path);
+            }
+            result
+        }
+    }
+}
