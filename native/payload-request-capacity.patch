+#[tokio::test]
+async fn shutdown_joins_blocking_native_persistence_after_its_awaiter_is_cancelled() {
+    let (session, _) = make_session_and_context().await;
+    let session = Arc::new(session);
+    let token = session
+        .track_native_persistence()
+        .expect("open native persistence");
+    let (started, starting) = tokio::sync::oneshot::channel();
+    let (release, released) = std::sync::mpsc::channel();
+    let finished = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let published = Arc::clone(&finished);
+    let outer = tokio::spawn(async move {
+        tokio::task::spawn_blocking(move || {
+            let _persistence = token;
+            started.send(()).expect("observe admitted blocking writer");
+            released.recv().expect("release owned blocking writer");
+            published.store(true, std::sync::atomic::Ordering::Release);
+        })
+        .await
+        .expect("blocking writer joined");
+    });
+    starting.await.expect("blocking writer started");
+    outer.abort();
+    assert!(outer.await.expect_err("awaiter cancelled").is_cancelled());
+    let mut shutdown = Box::pin(session.drain_code_mode_messages());
+    assert!(futures::poll!(shutdown.as_mut()).is_pending());
+    assert!(session.track_native_persistence().is_none());
+    assert!(session.track_code_mode_message().is_none());
+    assert!(!finished.load(std::sync::atomic::Ordering::Acquire));
+    release.send(()).expect("finish exact admitted writer");
+    tokio::time::timeout(Duration::from_secs(5), shutdown)
+        .await
+        .expect("existing shutdown tracker joins blocking persistence");
+    assert!(finished.load(std::sync::atomic::Ordering::Acquire));
