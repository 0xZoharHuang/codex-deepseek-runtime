+    /// A confirmed request prefix may not split a pair or consume an unfinished call.
+    /// Reuse native pairing rather than copying or rewriting any response content.
+    pub(crate) fn pair_safe_prefix_len(&self, proposed: usize) -> usize {
+        let items = self.annotated_items();
+        let mut len = proposed.min(items.len());
+        loop {
+            let mut protected_from = len;
+            for (index, item) in items[..len].iter().enumerate() {
+                match normalize::corresponding_item(items, &item.item) {
+                    normalize::PairCorrespondence::Matched(other) if other >= len => {
+                        protected_from = index;
+                        break;
+                    }
+                    normalize::PairCorrespondence::Unmatched => {
+                        protected_from = index;
+                        break;
+                    }
+                    _ => {}
+                }
+            }
+            if protected_from == len {
+                return len;
+            }
+            len = protected_from;
+        }
