+        "custom" => (
+            ResponseItem::CustomToolCall {
+                encrypted_content: None,
+                id: None,
+                status: None,
+                call_id: call_id.to_string(),
+                name: "capacity_custom".to_string(),
+                namespace: None,
+                input: "synthetic".to_string(),
+                internal_chat_message_metadata_passthrough: None,
+            },
