+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn capacity_token_budget_reset_preserves_pending_and_concurrent_suffix_without_model()
+-> anyhow::Result<()> {
+    skip_if_no_network!(Ok(()));
+    let (_home, session, turn, server, events) = token_budget_capacity_test_session().await?;
+    session
+        .record_conversation_items(
+            &turn,
+            turn.model_info(),
+            &[
+                user_message("CONFIRMED-OLD-TOKEN-RESET-PREFIX"),
+                user_message("CONFIRMED-NEWEST-TOKEN-RESET-PREFIX"),
+            ],
+        )
+        .await;
+    let consumed = session.capture_capacity_send().await;
+    session
+        .confirm_capacity_completion(
+            &turn,
+            &turn.model_info().slug,
+            consumed,
+            "ordinary-before-native-reset",
+        )
+        .await;
+    let confirmed_len = session.clone_history().await.annotated_items().len();
+    let pending_media = serde_json::from_value(json!({
+        "type":"message","role":"user","content":[
+            {"type":"input_text","text":"UNCONSUMED-TOKEN-RESET-MEDIA"},
+            {"type":"input_image","image_url":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGMQMgkDAAD4AJ3MaiF4AAAAAElFTkSuQmCC","detail":"high"},
+        ],
+    }))?;
+    session
+        .record_conversation_items(&turn, turn.model_info(), &[pending_media])
+        .await;
+    let prefix = session
+        .capacity_prefix(&turn, &turn.model_info().slug)
+        .await
+        .expect("explicit TokenBudget can qualify the same confirmed prefix");
+    // This append happens after the reset captures its prefix but before install.
+    // The existing Prefix installer must retain it together with the pending media.
+    let late_pair = vec![
+        serde_json::from_value(
+            json!({"type":"custom_tool_call","call_id":"late-reset-call",
+            "name":"fixture","input":"NEVER-REEXECUTE-RESET-CALL"}),
+        )?,
+        serde_json::from_value(
+            json!({"type":"custom_tool_call_output","call_id":"late-reset-call",
+            "output":"UNCONSUMED-LATE-RESET-RESULT"}),
+        )?,
+    ];
+    session
+        .record_conversation_items(&turn, turn.model_info(), &late_pair)
+        .await;
+    let before = session.clone_history().await;
+    let expected_suffix = before.annotated_items()[confirmed_len..].to_vec();
+    let old_window = session.current_window().await.1;
+    let step = session
+        .capture_step_context(
+            Arc::clone(&turn),
+            &tokio_util::sync::CancellationToken::new(),
+        )
+        .await?;
+    let world = Arc::new(session.build_world_state_for_step(&step, true).await?);
+    crate::compact_token_budget::run_inline_capacity_reset_task(
+        Arc::clone(&session),
+        step,
+        world,
+        prefix,
+        capacity_rejection_for_test(),
+    )
+    .await?;
+    let after = session.clone_history().await;
+    assert_eq!(
+        &after.annotated_items()[after.annotated_items().len() - expected_suffix.len()..],
+        expected_suffix.as_slice()
+    );
+    assert!(!after.raw_items().any(|item| matches!(item,ResponseItem::Message {content,..}
+        if content_items_to_text(content).is_some_and(|text| text.contains("CONFIRMED-OLD-TOKEN-RESET-PREFIX")))));
+    assert_eq!(session.current_window().await.1, old_window + 1);
+    let requests = server.received_requests().await.unwrap();
+    assert!(
+        requests
+            .iter()
+            .all(|request| request.url.path() != "/v1/responses"),
+        "native TokenBudget reset must not issue a summarizer or ordinary model request"
+    );
+    assert!(
+        session
+            .capacity_prefix(&turn, &turn.model_info().slug)
+            .await
+            .is_none(),
+        "local reset translates the same epoch/fence and cannot rearm it"
+    );
+    let mut started = Vec::new();
+    let mut completed = Vec::new();
+    while let Ok(event) = events.try_recv() {
+        match event.msg {
+            EventMsg::ItemStarted(event)
+                if matches!(&event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                started.push((event.turn_id, event.item.id()));
+            }
+            EventMsg::ItemCompleted(event)
+                if matches!(&event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                completed.push((event.turn_id, event.item.id()));
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        started.len(),
+        1,
+        "native reset emits one visible compaction lifecycle"
+    );
+    assert_eq!(
+        started, completed,
+        "same native compaction item and turn complete"
+    );
+    Ok(())
+}
