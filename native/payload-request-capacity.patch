+    sess.send_event(turn_context, EventMsg::Warning(WarningEvent {
+        message: "Request-byte capacity was exceeded (HTTP 413). Native compaction will summarize only previously confirmed input; the unconsumed suffix is preserved unchanged. If needed, the oldest item and any paired tool item are removed only from the compactor's local input.".to_owned(),
+    })).await;
