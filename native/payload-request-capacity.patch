+/// Match original fixture items, not a guessed wire-frame offset. The only
+/// allowed extra frames are the verified native base and exact compact prompt.
+fn manual_fixture_model_prefix_len(
+    input: &[serde_json::Value],
+    original: &[serde_json::Value],
+    expected_base: &serde_json::Value,
+    compact_prompt: &str,
+) -> usize {
+    let identities = original
+        .iter()
+        .map(manual_fixture_item_identity)
+        .collect::<Vec<_>>();
+    assert_eq!(
+        identities
+            .iter()
+            .collect::<std::collections::HashSet<_>>()
+            .len(),
+        identities.len(),
+        "fixture raw identities must be unambiguous"
+    );
+    let mut matched = 0usize;
+    let mut synthetic_base = 0usize;
+    let mut prompt_count = 0usize;
+    for (position, item) in input.iter().enumerate() {
+        let identity = manual_fixture_item_identity(item);
+        if matched < original.len() && identity == identities[matched] {
+            for field in [
+                "role",
+                "content",
+                "name",
+                "namespace",
+                "input",
+                "arguments",
+                "output",
+                "call_id",
+                "tools",
+            ] {
+                assert_eq!(
+                    item[field], original[matched][field],
+                    "model request skipped, reordered, or altered original fixture business content: {field}"
+                );
+            }
+            matched += 1;
+            continue;
+        }
+        let compact_content = json!([{"type":"input_text","text":compact_prompt}]);
+        if item["type"] == "message" && item["role"] == "user" && item["content"] == compact_content
+        {
+            assert_eq!(
+                position + 1,
+                input.len(),
+                "only the final exact compact prompt is synthetic"
+            );
+            prompt_count += 1;
+            continue;
+        }
+        if item == expected_base {
+            assert_eq!(
+                position, 0,
+                "native prompt-only instructions may occur only before raw input"
+            );
+            assert_eq!(matched, 0);
+            synthetic_base += 1;
+            assert_eq!(synthetic_base, 1);
+            continue;
+        }
+        panic!(
+            "unmatched model frame: neither next original fixture item nor verified synthetic frame"
+        );
+    }
+    assert_eq!(prompt_count, 1);
+    assert!(matched > 0 && matched <= original.len());
+    eprintln!(
+        "NATIVE_MANUAL_FRAME_ORACLE raw_prefix={matched} raw_total={} synthetic_base={synthetic_base} compact_prompt=1",
+        original.len()
+    );
+    matched
+}
