+fn manual_fixture_item_identity(item: &serde_json::Value) -> (String, String) {
+    let kind = item["type"].as_str().unwrap_or("message").to_owned();
+    if let Some(call_id) = item["call_id"].as_str() {
+        return (kind, format!("call:{call_id}"));
+    }
+    if let Some(id) = item["id"].as_str() {
+        return (kind, format!("id:{id}"));
+    }
+    assert_eq!(
+        kind, "message",
+        "fixture items without native IDs need explicit message content identity"
+    );
+    (
+        kind,
+        format!("message:{}:{}", item["role"], item["content"]),
+    )
+}
