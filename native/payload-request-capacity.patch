+    #[test]
+    fn native_rollout_replay_hash_preserves_direct_code_mode_and_mixed_input() -> Result<()> {
+        use codex_protocol::models::ExecutedToolCall;
+        use codex_protocol::models::ResponseItem;
+        use codex_protocol::models::ToolResultMetadata;
+
+        for mode in ["direct", "code_mode", "mixed"] {
+            let mut warm = vec![envelope("original user input")?];
+            for custom in [false, true] {
+                if (mode == "direct" && custom) || (mode == "code_mode" && !custom) {
+                    continue;
+                }
+                let call_id = if custom { "code-call" } else { "direct-call" };
+                let call: ResponseItem = serde_json::from_value(if custom {
+                    serde_json::json!({"type":"custom_tool_call","call_id":call_id,"name":"exec","input":"synthetic()"})
+                } else {
+                    serde_json::json!({"type":"function_call","call_id":call_id,"name":"native_read","arguments":"{}"})
+                })?;
+                warm.push(ResponseItemEnvelope::new(call));
+                let mut item: ResponseItem = serde_json::from_value(serde_json::json!({
+                    "type": if custom {"custom_tool_call_output"} else {"function_call_output"},
+                    "call_id":call_id,
+                    "output":[
+                        {"type":"input_text","text":"original typed output"},
+                        {"type":"input_image","image_url":"data:image/png;base64,AA==","detail":"low"},
+                        {"type":"input_image","file_id":"synthetic-private-reference","detail":"original"}
+                    ],
+                    "internal_chat_message_metadata_passthrough":{
+                        "turn_id":"018f3405-e835-71af-914a-7efb76abfa72",
+                        "content_item_kinds":["tool.text","tool.image","tool.image"]
+                    }
+                }))?;
+                let mut attempted = ExecutedToolCall::new(
+                    "native_read".into(),
+                    serde_json::json!({"fixture":"owned"}),
+                );
+                attempted.set_tool_result_metadata(ToolResultMetadata::new(
+                    &serde_json::json!({"resource":"owned-fixture"}),
+                ));
+                item.append_executed_tool_calls(vec![attempted]);
+                item.mark_tool_calls_complete();
+                if custom {
+                    item.set_tool_call_cell_id("native-code-mode-cell");
+                }
+                warm.push(ResponseItemEnvelope {
+                    item,
+                    metadata: Some(codex_history::CodexHarnessMetadata {
+                        history_truncation_token_limit: Some(1200),
+                        user_input_order: Some(7),
+                        ..Default::default()
+                    }),
+                });
+            }
+            let before = warm.clone();
+            let cold = warm
+                .iter()
+                .cloned()
+                .map(|envelope| -> Result<ResponseItemEnvelope> {
+                    let wire =
+                        serde_json::to_vec(&codex_history::RolloutItem::ResponseItem(envelope))?;
+                    match serde_json::from_slice::<codex_history::RolloutItem>(&wire)? {
+                        codex_history::RolloutItem::ResponseItem(envelope) => Ok(envelope),
+                        _ => anyhow::bail!("native rollout changed response-item type"),
+                    }
+                })
+                .collect::<Result<Vec<_>>>()?;
+            // This is the exact native cold-read loss that made the old complete
+            // serialization hash ineligible despite unchanged model-visible input.
+            assert_ne!(
+                serde_json::to_value(&warm[2].item)?,
+                serde_json::to_value(&cold[2].item)?
+            );
+            let expected = prefix_hash(&warm)?;
+            assert_eq!(prefix_hash(&cold)?, expected, "{mode}");
+            assert_eq!(warm, before, "hash projection mutated live native history");
+
+            let mutate_item = |index: usize,
+                               edit: &dyn Fn(&mut serde_json::Value)|
+             -> Result<Vec<ResponseItemEnvelope>> {
+                let mut changed = cold.clone();
+                let mut value = serde_json::to_value(&changed[index].item)?;
+                edit(&mut value);
+                changed[index].item = serde_json::from_value(value)?;
+                Ok(changed)
+            };
+            for changed in [
+                mutate_item(0, &|value| value["role"] = serde_json::json!("developer"))?,
+                mutate_item(2, &|value| {
+                    value["call_id"] = serde_json::json!("other-call")
+                })?,
+                mutate_item(2, &|value| {
+                    value["output"][0]["text"] = serde_json::json!("changed output")
+                })?,
+                mutate_item(2, &|value| {
+                    value["output"][1]["detail"] = serde_json::json!("high")
+                })?,
+                mutate_item(2, &|value| {
+                    value["output"][1]["image_url"] =
+                        serde_json::json!("data:image/png;base64,AQ==")
+                })?,
+                mutate_item(2, &|value| {
+                    value["output"][2]["file_id"] = serde_json::json!("different-reference")
+                })?,
+                mutate_item(2, &|value| {
+                    value["output"].as_array_mut().unwrap().swap(0, 1)
+                })?,
+                mutate_item(2, &|value| {
+                    value["internal_chat_message_metadata_passthrough"]["turn_id"] =
+                        serde_json::json!("different-turn")
+                })?,
+                mutate_item(2, &|value| {
+                    value["internal_chat_message_metadata_passthrough"]["content_item_kinds"][0] =
+                        serde_json::json!("different.kind")
+                })?,
+            ] {
+                assert_ne!(
+                    prefix_hash(&changed)?,
+                    expected,
+                    "{mode} replayed field mutation passed"
+                );
+            }
+            let mut changed = cold.clone();
+            changed[2]
+                .metadata
+                .as_mut()
+                .unwrap()
+                .history_truncation_token_limit = Some(1201);
+            assert_ne!(
+                prefix_hash(&changed)?,
+                expected,
+                "{mode} harness metadata mutation passed"
+            );
+            let mut changed = cold.clone();
+            changed.swap(0, 1);
+            assert_ne!(
+                prefix_hash(&changed)?,
+                expected,
+                "{mode} item order mutation passed"
+            );
+        }
+        Ok(())
+    }
