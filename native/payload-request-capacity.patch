+fn request_capacity_prefix_protects_crossing_and_unfinished_native_pairs(kind: &str) {
+    let (call, output) = request_capacity_pair(kind);
+    let history = create_history_with_items(vec![
+        user_msg("confirmed input"),
+        call.clone(),
+        output.clone(),
+        user_msg("latest unseen input"),
+    ]);
+    let before = raw_items(&history);
+    assert_eq!(history.pair_safe_prefix_len(0), 0);
+    assert_eq!(history.pair_safe_prefix_len(2), 1);
+    assert_eq!(history.pair_safe_prefix_len(3), 3);
+    assert_eq!(history.pair_safe_prefix_len(usize::MAX), 4);
+    assert_eq!(raw_items(&history), before);
+
+    let unfinished = create_history_with_items(vec![user_msg("confirmed input"), call]);
+    assert_eq!(unfinished.pair_safe_prefix_len(2), 1);
+    let orphan = create_history_with_items(vec![user_msg("confirmed input"), output]);
+    assert_eq!(orphan.pair_safe_prefix_len(2), 1);
