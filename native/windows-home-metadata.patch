+#[cfg(test)]
+mod home_metadata_tests {
+    use super::*;
+    use crate::LocalSid;
+    use windows_sys::Win32::Security::{ACE_HEADER, GetAce};
+    use windows_sys::Win32::Storage::FileSystem::FILE_LIST_DIRECTORY;
+
+    fn acl_entries(path: &Path) -> Vec<Vec<u8>> {
+        unsafe {
+            let (acl, descriptor) = crate::fetch_dacl_handle(path).unwrap();
+            assert!(!acl.is_null());
+            let entries = (0..(*acl).AceCount as u32)
+                .map(|index| {
+                    let mut entry = std::ptr::null_mut();
+                    assert_ne!(GetAce(acl, index, &mut entry), 0);
+                    let size = (*(entry as *const ACE_HEADER)).AceSize as usize;
+                    std::slice::from_raw_parts(entry.cast::<u8>(), size).to_vec()
+                })
+                .collect();
+            LocalFree(descriptor as HLOCAL);
+            entries
+        }
+    }
+
+    #[test]
+    fn home_metadata_only_grants_attributes_without_listing_or_child_inheritance() {
+        let home = tempfile::tempdir().unwrap();
+        let sid = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4245").unwrap();
+        let children = [
+            home.path().join("private.txt"),
+            home.path().join("marker.json"),
+        ];
+        for child in &children {
+            std::fs::write(child, "synthetic private content").unwrap();
+        }
+        let before: Vec<_> = children.iter().map(|path| acl_entries(path)).collect();
+        ensure_codex_home_metadata(home.path(), sid.as_ptr()).unwrap();
+        assert!(
+            path_mask_allows(home.path(), &[sid.as_ptr()], FILE_READ_ATTRIBUTES, true).unwrap()
+        );
+        assert!(
+            !path_mask_allows(home.path(), &[sid.as_ptr()], FILE_LIST_DIRECTORY, true).unwrap()
+        );
+        for (child, original) in children.iter().zip(before) {
+            assert_eq!(acl_entries(child), original);
+            assert!(!path_mask_allows(child, &[sid.as_ptr()], FILE_GENERIC_READ, false).unwrap());
+        }
+        let entries = acl_entries(home.path());
+        assert!(entries.iter().any(|entry| entry[0] == 0
+            && entry[1] == 0
+            && u32::from_le_bytes(entry[4..8].try_into().unwrap()) == FILE_READ_ATTRIBUTES));
+        ensure_codex_home_metadata(home.path(), sid.as_ptr()).unwrap();
+        assert_eq!(acl_entries(home.path()), entries);
+    }
+
+    #[test]
+    fn home_metadata_preserves_existing_deny_and_fails_closed() {
+        let home = tempfile::tempdir().unwrap();
+        let sid = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4246").unwrap();
+        unsafe {
+            crate::add_deny_read_ace(home.path(), sid.as_ptr()).unwrap();
+        }
+        let before = acl_entries(home.path());
+        assert!(ensure_codex_home_metadata(home.path(), sid.as_ptr()).is_err());
+        assert_eq!(acl_entries(home.path()), before);
+    }
+}
