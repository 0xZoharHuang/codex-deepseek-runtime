+// PowerShell resolves every ancestor of its initial CWD, including the private
+// Codex home above the native junction. Only directory attributes are needed:
+// never grant listing, data access, or inheritance to sessions and secrets.
+fn ensure_codex_home_metadata(home: &Path, sandbox_group_psid: *mut c_void) -> Result<()> {
+    unsafe {
+        ensure_allow_mask_aces_with_inheritance(
+            home,
+            &[sandbox_group_psid],
+            FILE_READ_ATTRIBUTES,
+            /*inheritance*/ 0,
+        )
+    }
+    .context("grant Codex home directory metadata for native CWD resolution")?;
+    anyhow::ensure!(
+        path_mask_allows(home, &[sandbox_group_psid], FILE_READ_ATTRIBUTES, true)?,
+        "Codex home directory metadata remains denied; refusing native CWD fallback"
+    );
+    Ok(())
+}
