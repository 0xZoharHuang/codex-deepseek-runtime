+#[test]
+fn managed_read_revoke_preserves_other_aces_and_child_inheritance() {
+    let parent = tempfile::tempdir().unwrap();
+    let root = parent.path().join("directory");
+    std::fs::create_dir(&root).unwrap();
+    let child = root.join("child");
+    std::fs::write(&child, b"synthetic").unwrap();
+    let sid = LocalSid::from_string("S-1-5-21-10-20-30-4242").unwrap();
+    let other = LocalSid::from_string("S-1-5-21-10-20-30-4243").unwrap();
+    unsafe {
+        super::add_allow_ace(&root, sid.as_ptr()).unwrap();
+        super::add_deny_read_ace(&root, other.as_ptr()).unwrap();
+        let baseline = managed_read_revoke_entries(&root);
+        assert!(super::add_deny_read_ace(&root, sid.as_ptr()).unwrap());
+        managed_read_revoke_prepend_deny(
+            &root,
+            sid.as_ptr(),
+            windows_sys::Win32::Storage::FileSystem::FILE_WRITE_DATA,
+        );
+        let custom = managed_read_revoke_entries(&root)[0].clone();
+        assert!(super::revoke_managed_deny_read_aces(&root, sid.as_ptr()).unwrap());
+        let mut expected = vec![custom];
+        expected.extend(baseline);
+        assert_eq!(
+            managed_read_revoke_entries(&root),
+            expected,
+            "only the managed read pair may change"
+        );
+        let (acl, descriptor) = fetch_dacl_handle(&child).unwrap();
+        assert!(
+            !super::dacl_has_read_deny_for_sid(acl, sid.as_ptr()),
+            "inherited read deny must be removed"
+        );
+        assert!(
+            super::dacl_has_read_deny_for_sid(acl, other.as_ptr()),
+            "other principal deny remains"
+        );
+        LocalFree(descriptor as HLOCAL);
+        assert!(!super::revoke_managed_deny_read_aces(&root, sid.as_ptr()).unwrap());
+        std::fs::write(root.join("late-child"), b"later").unwrap();
+        let (acl, descriptor) = fetch_dacl_handle(&root.join("late-child")).unwrap();
+        assert!(!super::dacl_has_read_deny_for_sid(acl, sid.as_ptr()));
+        LocalFree(descriptor as HLOCAL);
+    }
+}
