+    let state_path = sandbox_dir(temp.path()).join(DENY_READ_ACL_STATE_FILE);
+    let sid_string = "S-1-5-21-10-20-30-424243";
+    let sid = LocalSid::from_string(sid_string)?;
+    let first = temp.path().join("first");
+    let second = temp.path().join("second");
+    fs::create_dir(&first)?;
+    fs::create_dir(&second)?;
+    let desired = [first.clone(), second.clone()];
+    let mut additions = 0;
+    let mut rollbacks = 0;
+    let error = unsafe {
+        sync_persistent_deny_read_acls_with(
+            temp.path(),
+            sid_string,
+            &desired,
+            sid.as_ptr(),
+            |planned, principal| {
+                assert_eq!(load_state(&state_path)?.principals[sid_string], planned);
+                crate::deny_read_acl::apply_planned_deny_read_acls_with(
+                    planned,
+                    principal,
+                    |path, principal| {
+                        additions += 1;
+                        if path == second {
+                            return Err(std::io::Error::from_raw_os_error(5).into());
+                        }
+                        crate::acl::add_deny_read_ace(path, principal)
+                    },
+                    |_path, _principal| {
+                        rollbacks += 1;
+                        Err(std::io::Error::from_raw_os_error(5).into())
+                    },
+                )
+            },
+        )
+    }
+    .expect_err("partial apply and failed rollback must block the command");
+    assert!(
+        format!("{error:#}").contains("rollback remains pending"),
+        "{error:#}"
+    );
+    assert_eq!((additions, rollbacks), (2, 1));
+    assert!(managed_read_state_has_deny(&first, sid.as_ptr())?);
+    assert!(!managed_read_state_has_deny(&second, sid.as_ptr())?);
+    assert_eq!(load_state(&state_path)?.principals[sid_string], desired);
+    unsafe { sync_persistent_deny_read_acls(temp.path(), sid_string, &[], sid.as_ptr()) }?;
+    assert!(!managed_read_state_has_deny(&first, sid.as_ptr())?);
