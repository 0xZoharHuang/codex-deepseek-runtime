+            let (_dacl, descriptor) = crate::acl::fetch_dacl_handle(&path)?;
+            let flags = DACL_SECURITY_INFORMATION
+                | if protected {
+                    PROTECTED_DACL_SECURITY_INFORMATION
+                } else {
