+/// Atomic ledger replacement retains its existing DACL and protection flags.
+/// Ownership follows the same authenticated-creator rule as other native outputs.
+/// The supplied validated leaf handle is closed only after capturing security;
+/// an error configuring the fresh temporary file leaves the old state intact.
+pub(crate) fn write_file_atomically_preserving_dacl(
+    path: &Path,
+    contents: &[u8],
+    previous: File,
+) -> Result<()> {
+    use windows_sys::Win32::Foundation::{HLOCAL, LocalFree};
+    use windows_sys::Win32::Security::Authorization::{GetSecurityInfo, SE_FILE_OBJECT};
+    use windows_sys::Win32::Security::{
+        DACL_SECURITY_INFORMATION, GetSecurityDescriptorControl,
+        PROTECTED_DACL_SECURITY_INFORMATION, SE_DACL_PROTECTED,
+    };
+    use windows_sys::Win32::Storage::FileSystem::WRITE_DAC;
+    let mut dacl = std::ptr::null_mut();
+    let mut descriptor = std::ptr::null_mut();
+    let information = DACL_SECURITY_INFORMATION;
+    let status = unsafe {
+        GetSecurityInfo(
+            previous.as_raw_handle() as HANDLE,
+            SE_FILE_OBJECT,
+            information,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            &mut dacl,
+            std::ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    if status != 0 {
+        if !descriptor.is_null() {
+            unsafe {
+                LocalFree(descriptor as HLOCAL);
+            }
+        }
+        return Err(std::io::Error::from_raw_os_error(status as i32))
+            .context("read ledger security");
+    }
+    let result = (|| {
+        let mut control = 0;
+        let mut revision = 0;
+        if unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) } == 0 {
+            return Err(std::io::Error::last_os_error()).context("read ledger security flags");
+        }
+        let protection = if control & SE_DACL_PROTECTED != 0 {
+            PROTECTED_DACL_SECURITY_INFORMATION
+        } else {
+            0
+        };
+        if control & windows_sys::Win32::Security::SE_DACL_AUTO_INHERITED != 0 {
+            let flag = windows_sys::Win32::Security::SE_DACL_AUTO_INHERIT_REQ;
+            if unsafe {
+                windows_sys::Win32::Security::SetSecurityDescriptorControl(descriptor, flag, flag)
+            } == 0
+            {
+                return Err(std::io::Error::last_os_error())
+                    .context("preserve ledger inheritance control");
+            }
+        }
+        drop(previous);
+        write_file_atomically_with(
+            path,
+            contents,
+            windows_sys::Win32::Storage::FileSystem::READ_CONTROL | WRITE_DAC,
+            |file| {
+                // Preserve the supplied DACL directly on the pinned file handle.
+                // Unlike SetSecurityInfo, this does not synthesize inherited ACEs.
+                let status = unsafe {
+                    NtSetSecurityObject(
+                        file.as_raw_handle() as HANDLE,
+                        information | protection,
+                        descriptor,
+                    )
+                };
+                if status < 0 {
+                    return Err(std::io::Error::from_raw_os_error(unsafe {
+                        RtlNtStatusToDosError(status)
+                    }
+                        as i32))
+                    .context("preserve ledger DACL");
+                }
+                Ok(())
+            },
+        )
+    })();
+    unsafe {
+        LocalFree(descriptor as HLOCAL);
+    }
+    result
+}
