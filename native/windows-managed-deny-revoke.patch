+fn managed_read_revoke_entries(path: &Path) -> Vec<Vec<u8>> {
+    unsafe {
+        use windows_sys::Win32::Security::{ACE_HEADER, GetAce};
+        let (acl, descriptor) = fetch_dacl_handle(path).unwrap();
+        let result = if acl.is_null() {
+            Vec::new()
+        } else {
+            (0..(*acl).AceCount as u32)
+                .map(|index| {
+                    let mut entry = std::ptr::null_mut();
+                    assert_ne!(GetAce(acl, index, &mut entry), 0);
+                    let size = (*(entry as *const ACE_HEADER)).AceSize as usize;
+                    std::slice::from_raw_parts(entry.cast::<u8>(), size).to_vec()
+                })
+                .collect()
+        };
+        LocalFree(descriptor as HLOCAL);
+        result
+    }
+}
+
+unsafe fn managed_read_revoke_prepend_deny(path: &Path, sid: *mut c_void, mask: u32) {
+    use windows_sys::Win32::Security::Authorization::SetNamedSecurityInfoW;
+    use windows_sys::Win32::Security::{
+        ACE_HEADER, ACL, ACL_REVISION, AddAccessDeniedAceEx, AddAce, GetAce, InitializeAcl,
+    };
+    let (old, descriptor) = fetch_dacl_handle(path).unwrap();
+    let size = (*old).AclSize as usize + 256;
+    let mut storage = vec![0_u32; size.div_ceil(std::mem::size_of::<u32>())];
+    let new = storage.as_mut_ptr().cast::<ACL>();
+    assert_ne!(
+        InitializeAcl(new, (storage.len() * 4) as u32, ACL_REVISION),
+        0
+    );
+    assert_ne!(AddAccessDeniedAceEx(new, ACL_REVISION, 0, mask, sid), 0);
+    for index in 0..(*old).AceCount as u32 {
+        let mut entry = std::ptr::null_mut();
+        assert_ne!(GetAce(old, index, &mut entry), 0);
+        assert_ne!(
+            AddAce(
+                new,
+                ACL_REVISION,
+                u32::MAX,
+                entry,
+                (*(entry as *const ACE_HEADER)).AceSize as u32
+            ),
+            0
+        );
+    }
+    assert_eq!(
+        SetNamedSecurityInfoW(
+            to_wide(path).as_ptr() as _,
+            1,
+            DACL_SECURITY_INFORMATION,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            new,
+            std::ptr::null_mut()
+        ),
+        0
+    );
+    LocalFree(descriptor as HLOCAL);
+}
