+#[test]
+fn managed_read_state_lock_process_exit_and_crash_release_without_replacing_lock() -> Result<()> {
+    const HOME_ENV: &str = "CODEX_TEST_DENY_LOCK_HOME";
+    if let Some(home) = std::env::var_os(HOME_ENV) {
+        let home = PathBuf::from(home);
+        let _transaction = lock_state_transaction(&home)?;
+        fs::write(home.join("holder-ready"), b"ready")?;
+        let deadline = Instant::now() + Duration::from_secs(15);
+        while !home.join("holder-release").exists() {
+            ensure!(
+                Instant::now() < deadline,
+                "parent did not release child lock"
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        return Ok(());
+    }
+    let temp = TempDir::new()?;
+    fs::create_dir(sandbox_dir(temp.path()))?;
+    let state = sandbox_dir(temp.path()).join(DENY_READ_ACL_STATE_FILE);
+    let original = br#"{"principals":{}}"#;
+    fs::write(&state, original)?;
+    for crash in [false, true] {
+        let mut child = Command::new(std::env::current_exe()?)
+            .args(["--exact", "deny_read_state::tests::managed_read_state_lock_process_exit_and_crash_release_without_replacing_lock", "--nocapture"])
+            .env(HOME_ENV, temp.path())
+            .stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null()).spawn()?;
+        let result = (|| -> Result<()> {
+            let deadline = Instant::now() + Duration::from_secs(5);
+            while !temp.path().join("holder-ready").exists() {
+                ensure!(
+                    child.try_wait()?.is_none(),
+                    "lock holder exited before readiness"
+                );
+                ensure!(
+                    Instant::now() < deadline,
+                    "lock holder did not become ready"
+                );
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            let lock_path = sandbox_dir(temp.path()).join("deny_read_acl_state.lock");
+            let lock = File::open(&lock_path)?;
+            let mut before = unsafe { std::mem::zeroed::<winfs::BY_HANDLE_FILE_INFORMATION>() };
+            assert_ne!(
+                unsafe {
+                    winfs::GetFileInformationByHandle(lock.as_raw_handle() as _, &mut before)
+                },
+                0
+            );
+            let error = lock_state_transaction(temp.path())
+                .err()
+                .expect("live process owns transaction");
+            assert!(format!("{error:#}").contains("timed out"));
+            assert_eq!(fs::read(&state)?, original);
+            if crash {
+                child.kill()?;
+            } else {
+                fs::write(temp.path().join("holder-release"), b"release")?;
+            }
+            let status = child.wait()?;
+            assert_eq!(status.success(), !crash);
+            let next = lock_state_transaction(temp.path())?;
+            let mut after = unsafe { std::mem::zeroed::<winfs::BY_HANDLE_FILE_INFORMATION>() };
+            assert_ne!(
+                unsafe {
+                    winfs::GetFileInformationByHandle(next._file.as_raw_handle() as _, &mut after)
+                },
+                0
+            );
+            assert_eq!(
+                (
+                    before.dwVolumeSerialNumber,
+                    before.nFileIndexHigh,
+                    before.nFileIndexLow
+                ),
+                (
+                    after.dwVolumeSerialNumber,
+                    after.nFileIndexHigh,
+                    after.nFileIndexLow
+                )
+            );
+            Ok(())
+        })();
+        if child.try_wait()?.is_none() {
+            child.kill()?;
+            child.wait()?;
+        }
+        result?;
+        fs::remove_file(temp.path().join("holder-ready"))?;
+        if temp.path().join("holder-release").exists() {
+            fs::remove_file(temp.path().join("holder-release"))?;
+        }
+    }
+    Ok(())
+}
