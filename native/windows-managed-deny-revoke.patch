+unsafe fn managed_deny_read_ace_indices(acl: *mut ACL, psid: *mut c_void) -> Result<Vec<u32>> {
+    let mut info: ACL_SIZE_INFORMATION = std::mem::zeroed();
+    if GetAclInformation(
+        acl,
+        &mut info as *mut _ as *mut c_void,
+        std::mem::size_of::<ACL_SIZE_INFORMATION>() as u32,
+        AclSizeInformation,
+    ) == 0
+    {
+        return Err(std::io::Error::last_os_error()).context("inspect managed deny-read ACL");
+    }
+    let mut indices = Vec::new();
+    for index in 0..info.AceCount {
+        let mut value: *mut c_void = std::ptr::null_mut();
+        if GetAce(acl, index, &mut value) == 0 {
+            return Err(std::io::Error::last_os_error()).context("inspect managed deny-read ACE");
+        }
+        let header = &*value.cast::<ACE_HEADER>();
+        if header.AceType != ACCESS_DENIED_ACE_TYPE || header.AceFlags & INHERITED_ACE != 0 {
+            continue;
+        }
+        let ace = &*value.cast::<ACCESS_DENIED_ACE>();
+        if EqualSid(std::ptr::addr_of!(ace.SidStart) as *mut c_void, psid) == 0 {
+            continue;
+        }
+        let owned = (header.AceFlags == 0 && ace.Mask == FILE_GENERIC_READ)
+            || (header.AceFlags
+                == ((CONTAINER_INHERIT_ACE | OBJECT_INHERIT_ACE) as u8 | INHERIT_ONLY_ACE)
+                && ace.Mask == (FILE_GENERIC_READ | GENERIC_READ_MASK));
+        if owned {
+            indices.push(index);
+        } else {
+            // READ_CONTROL/SYNCHRONIZE overlap writes: preserve write-only ACEs.
+            const READ_SPECIFIC: u32 = 0x0000_0089 | GENERIC_READ_MASK | GENERIC_ALL_MASK;
+            ensure!(
+                ace.Mask & READ_SPECIFIC == 0,
+                "ambiguous same-principal deny-read ACE; preserving ACL and ownership state"
+            );
+        }
+    }
+    Ok(indices)
+}
