+#[test]
+fn managed_read_state_lock_rejects_linked_leaf_without_touching_victim_or_ledger() -> Result<()> {
+    let temp = TempDir::new()?;
+    fs::create_dir(sandbox_dir(temp.path()))?;
+    let victim = temp.path().join("victim");
+    let original = b"owned fixture unchanged";
+    fs::write(&victim, original)?;
+    let lock_path = sandbox_dir(temp.path()).join("deny_read_acl_state.lock");
+    for kind in ["hardlink", "symlink"] {
+        if kind == "hardlink" {
+            fs::hard_link(&victim, &lock_path)?;
+        } else {
+            std::os::windows::fs::symlink_file(&victim, &lock_path)?;
+        }
+        let error = lock_state_transaction(temp.path())
+            .err()
+            .expect("linked lock must fail");
+        assert!(format!("{error:#}").contains(if kind == "hardlink" {
+            "multiple links"
+        } else {
+            "reparse"
+        }));
+        assert_eq!(fs::read(&victim)?, original);
+        assert!(
+            !sandbox_dir(temp.path())
+                .join(DENY_READ_ACL_STATE_FILE)
+                .exists()
+        );
+        fs::remove_file(&lock_path)?;
+    }
+    Ok(())
+}
