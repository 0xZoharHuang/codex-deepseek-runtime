+        assert_eq!(compacted.len(), 1);
+        // Native CompactedItem encoding writes default metadata for None slots
+        // when its positional metadata array exists. Roundtrip the independent
+        // live expected value through the official codec, then compare the full
+        // envelopes; do not discard or mask any non-default metadata.
+        let mut expected_compacted: codex_history::CompactedItem =
+            serde_json::from_value(json!({"message":"independent live replacement codec"}))?;
+        expected_compacted.replacement_history = Some(after.annotated_items().to_vec());
+        let replay_expected: codex_history::CompactedItem =
+            serde_json::from_slice(&serde_json::to_vec(&expected_compacted)?)?;
+        assert_eq!(
+            compacted[0].replacement_history, replay_expected.replacement_history,
+            "durable replacement must equal independent live history after native replay"
+        );
+        let after_window = session.current_window().await;
+        assert_eq!(compacted[0].window_number, Some(after_window.1));
+        assert_eq!(
+            compacted[0].window_id.as_deref(),
+            Some(after_window.2.to_string().as_str())
+        );
+        // Native prefix compaction stores the summary in rich replacement
+        // history (already checked exactly above), leaving this legacy field empty.
+        assert!(compacted[0].message.is_empty());
+        let cp = serde_json::to_value(session.capacity_checkpoint_for_test().await.unwrap())?;
+        assert_eq!(
+            cp["binding"]["history_anchor"],
+            format!(
+                "{}:{}",
+                session.thread_id,
+                compacted[0].window_number.unwrap()
+            )
+        );
+        assert!(
+            session
+                .capacity_checkpoint_matches_history_for_test(
+                    compacted[0].replacement_history.as_ref().unwrap()
+                )
+                .await?
+        );
+    }
+    let completed = std::iter::from_fn(|| events.try_recv().ok())
+        .filter(|event| {
+            matches!(&event.msg,
+        EventMsg::ItemCompleted(event) if matches!(event.item,TurnItem::ContextCompaction(_)))
+        })
+        .count();
+    assert_eq!(completed, usize::from(success));
+    session.drain_capacity_native_persistence_for_test().await;
+    session.live_thread().unwrap().shutdown().await?;
+    Ok(())
+}
