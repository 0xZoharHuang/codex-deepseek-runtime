+    let (items, _, errors) = RolloutRecorder::load_rollout_items(&rollout).await?;
+    assert_eq!(errors, 0);
+    assert_eq!(
+        items
+            .iter()
+            .filter(|item| matches!(item, codex_history::RolloutItem::Compacted(_)))
+            .count(),
+        usize::from(success),
+        "one final durable installation only"
+    );
+    if success {
+        let compacted = items
+            .iter()
+            .filter_map(|item| match item {
