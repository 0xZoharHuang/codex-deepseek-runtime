+/// Copies the actual TokenUser SID; never consults environment/account-name selectors.
+///
+/// # Safety
+/// `token` must remain valid with TOKEN_QUERY access during this call.
+pub(crate) unsafe fn token_user_sid(token: HANDLE) -> Result<Vec<u8>> {
+    use windows_sys::Win32::Security::TokenUser;
+    let mut needed = 0;
+    unsafe { GetTokenInformation(token, TokenUser, std::ptr::null_mut(), 0, &mut needed) };
+    ensure!(needed > 0 && needed <= 65_536, "invalid token user size");
+    let mut buffer = vec![0u8; needed as usize];
+    ensure!(
+        unsafe {
+            GetTokenInformation(
+                token,
+                TokenUser,
+                buffer.as_mut_ptr().cast(),
+                needed,
+                &mut needed,
+            )
+        } != 0,
+        "GetTokenInformation(TokenUser) failed: {}",
+        unsafe { GetLastError() }
+    );
+    ensure!(
+        needed as usize <= buffer.len(),
+        "invalid token user result size"
+    );
+    decode_token_user(&buffer[..needed as usize])
+}
+
+fn decode_token_user(buffer: &[u8]) -> Result<Vec<u8>> {
+    use windows_sys::Win32::Security::TOKEN_USER;
+    ensure!(
+        buffer.len() >= std::mem::size_of::<TOKEN_USER>(),
+        "truncated token user header"
+    );
+    let user = unsafe { std::ptr::read_unaligned(buffer.as_ptr().cast::<TOKEN_USER>()) };
+    let offset = (user.User.Sid as usize).wrapping_sub(buffer.as_ptr() as usize);
+    ensure!(
+        offset <= buffer.len().saturating_sub(8),
+        "invalid token user SID pointer"
+    );
+    ensure!(buffer[offset] == 1, "invalid token user SID revision");
+    let length = 8 + usize::from(buffer[offset + 1]) * 4;
+    ensure!(
+        length <= 68 && length <= buffer.len() - offset,
+        "invalid token user SID size"
+    );
+    ensure!(
+        unsafe { IsValidSid(user.User.Sid) } != 0,
+        "invalid token user SID"
+    );
+    let mut sid = vec![0; length];
+    ensure!(
+        unsafe { CopySid(length as u32, sid.as_mut_ptr().cast(), user.User.Sid) } != 0,
+        "copy token user SID failed"
+    );
+    Ok(sid)
+}
