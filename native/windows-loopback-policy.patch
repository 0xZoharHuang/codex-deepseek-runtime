+// Limit both the API enumeration and deletion to this validated home's provider and
+// dedicated sublayer. No global rules, foreign namespace, or named-object scan is used.
+pub(super) fn remove(engine: HANDLE, namespace: &NamespaceKey) -> Result<()> {
+    let mut provider = namespaced_guid(namespace, PROVIDER_KEY);
+    let sublayer = namespaced_guid(namespace, SUBLAYER_KEY);
+    let mut keys = Vec::new();
+    for layer in [
+        FWPM_LAYER_ALE_AUTH_CONNECT_V4,
+        FWPM_LAYER_ALE_AUTH_CONNECT_V6,
+        FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4,
+        FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6,
+    ] {
+        let template = FWPM_FILTER_ENUM_TEMPLATE0 {
+            providerKey: &mut provider,
+            layerKey: layer,
+            enumType: FWP_FILTER_ENUM_FULLY_CONTAINED,
+            flags: FWP_FILTER_ENUM_FLAG_INCLUDE_DISABLED,
+            actionMask: u32::MAX,
+            ..unsafe { zeroed() }
+        };
+        let mut handle = HANDLE::default();
+        ensure_success(
+            unsafe { FwpmFilterCreateEnumHandle0(engine, &template, &mut handle) },
+            "create scoped loopback filter enumeration",
+        )?;
+        let enumeration = Enumeration { engine, handle };
+        loop {
+            let mut entries: *mut *mut FWPM_FILTER0 = null_mut();
+            let mut count = 0;
+            let status = unsafe {
+                FwpmFilterEnum0(engine, enumeration.handle, 128, &mut entries, &mut count)
+            };
+            if status != 0 {
+                if !entries.is_null() {
+                    unsafe {
+                        FwpmFreeMemory0((&mut entries as *mut *mut *mut FWPM_FILTER0).cast())
+                    };
+                }
+                ensure_success(status, "enumerate scoped loopback filters")?;
+            }
+            if !entries.is_null() {
+                for item in unsafe { std::slice::from_raw_parts(entries, count as usize) } {
+                    let item = unsafe { &**item };
+                    if !item.providerKey.is_null()
+                        && same_guid(unsafe { *item.providerKey }, provider)
+                        && same_guid(item.subLayerKey, sublayer)
+                    {
+                        keys.push(item.filterKey);
+                    }
+                }
+                unsafe { FwpmFreeMemory0((&mut entries as *mut *mut *mut FWPM_FILTER0).cast()) };
+            }
+            if count == 0 {
+                break;
+            }
+        }
+    }
+    for key in keys {
+        delete_filter_if_present(engine, &key)?;
+    }
+    ensure_success_or(
+        unsafe { FwpmSubLayerDeleteByKey0(engine, &sublayer) },
+        "delete owned loopback sublayer",
+        &[FWP_E_SUBLAYER_NOT_FOUND as u32, FWP_E_NOT_FOUND as u32],
+    )
+}
