+struct Enumeration {
+    engine: HANDLE,
+    handle: HANDLE,
+}
+impl Drop for Enumeration {
+    fn drop(&mut self) {
+        unsafe {
+            FwpmFilterDestroyEnumHandle0(self.engine, self.handle);
+        }
+    }
