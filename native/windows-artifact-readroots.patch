+    #[test]
+    fn artifact_read_roots_full_profile_keeps_only_pure_resources_and_explicit_denies() {
+        use codex_protocol::permissions::{
+            FileSystemAccessMode, FileSystemPath, FileSystemSandboxEntry, FileSystemSandboxPolicy,
+            FileSystemSpecialPath,
+        };
+        let temp = TempDir::new().expect("fixture");
+        let home = temp.path().join("private-home");
+        let cwd = temp.path().join("workspace");
+        for path in [
+            &cwd,
+            &home.join("skills"),
+            &home.join("plugins/cache"),
+            &home.join("sessions"),
+            &home.join("memories"),
+            &home.join("memories_v2"),
+            &home.join(".sandbox-secrets"),
+        ] {
+            fs::create_dir_all(path).expect("fixture directory");
+        }
+        let workspace_roots = workspace_roots_for(&cwd);
+        let root = FileSystemSandboxEntry::new(
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::Root,
+            },
+            FileSystemAccessMode::Read,
+        );
+        let denied = FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(home.join("skills"))
+                .unwrap()
+                .into(),
+            FileSystemAccessMode::Deny,
+        );
+        let denied_v2 = FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(home.join("memories_v2"))
+                .unwrap()
+                .into(),
+            FileSystemAccessMode::Deny,
+        );
+        let profile = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(vec![root, denied, denied_v2]),
+            NetworkSandboxPolicy::Restricted,
+        );
+        let permissions = permissions_for(&profile, &workspace_roots);
+        let roots = gather_read_roots(
+            &cwd,
+            &permissions,
+            &HashMap::new(),
+            &home,
+            super::SetupRuntime::Legacy,
+        );
+        assert!(roots.contains(&dunce::canonicalize(home.join("plugins/cache")).unwrap()));
+        assert!(!roots.contains(&dunce::canonicalize(home.join("skills")).unwrap()));
+        assert!(roots.contains(&dunce::canonicalize(home.join("memories")).unwrap()));
+        assert!(!roots.contains(&dunce::canonicalize(home.join("memories_v2")).unwrap()));
+        assert!(!roots.contains(&dunce::canonicalize(home.join(".sandbox-secrets")).unwrap()));
+        assert!(!roots.contains(&dunce::canonicalize(&home).unwrap()));
+        assert!(!roots.contains(&dunce::canonicalize(home.join("sessions")).unwrap()));
+    }
