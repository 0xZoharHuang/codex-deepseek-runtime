+    let mut first = eol_migrator(&pending, false);
+    first.migrations.to_mut().truncate(1);
+    first.run(&pool).await.unwrap();
+    let selected = eol_selected(&pool, &super::runtime_migrator(&pending), false, None)
+        .await
+        .unwrap();
+    selected.run(&pool).await.unwrap();
+    let value: String = sqlx::query_scalar("SELECT value FROM eol_literal")
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+    assert_eq!(value, "left\nright");
+    eol_migrator(&pending, false).run(&pool).await.unwrap();
+    pool.close().await;
+
+    let broken = Migrator::with_migrations(vec![Migration::new(
+        1, "failed DDL".into(), sqlx::migrate::MigrationType::Simple,
+        "CREATE TABLE eol_should_rollback(value TEXT);\nINSERT INTO eol_should_rollback VALUES ('x');\nSELECT missing_column FROM eol_missing_table;".into_sql_str(),
+        false,
+    )]);
+    let pool = eol_pool().await;
+    let selected = eol_selected(&pool, &super::runtime_migrator(&broken), false, None)
+        .await
+        .unwrap();
+    assert!(selected.run(&pool).await.is_err());
+    let count: i64 =
+        sqlx::query_scalar("SELECT count(*) FROM sqlite_master WHERE name='eol_should_rollback'")
+            .fetch_one(&pool)
+            .await
+            .unwrap();
+    assert_eq!(count, 0);
+    assert!(eol_ledger(&pool).await.is_empty());
+    pool.close().await;
+}
