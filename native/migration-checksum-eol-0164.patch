+                .filter(|migration| migration.version <= 37)
+                .cloned()
+                .collect(),
+        );
+        let mut recency = full
+            .iter()
+            .find(|migration| migration.version == 39)
+            .unwrap()
+            .clone();
+        recency.version = 38;
+        old.migrations.to_mut().push(recency);
+        old.run(&pool).await.unwrap();
+        let before = eol_ledger(&pool).await;
+        let canonical = super::runtime_state_migrator();
+        let selected = eol_selected(&pool, &canonical, true, None).await.unwrap();
+        repair_legacy_recency_migration_version(&pool, &selected)
+            .await
+            .unwrap();
+        selected.run(&pool).await.unwrap();
+        let after = eol_ledger(&pool).await;
+        assert_eq!(after.len(), full.migrations.len());
+        assert!(
+            after.len() > before.len(),
+            "new selector applied pending migrations"
+        );
+        for row in &after {
+            let expected = full
+                .iter()
+                .find(|migration| migration.version == row.0)
+                .unwrap();
+            assert_eq!(row.4, expected.checksum.as_ref());
+        }
+        for row in &before {
+            let mut expected = row.clone();
+            if expected.0 == 38 {
+                // Only the existing native recency repair changes version/description.
+                expected.0 = 39;
+                expected.1 = full
+                    .iter()
+                    .find(|migration| migration.version == 39)
+                    .unwrap()
+                    .description
+                    .to_string();
+            }
+            assert_eq!(
+                after.iter().find(|row| row.0 == expected.0),
+                Some(&expected)
+            );
+        }
+        full.run(&pool)
+            .await
+            .expect("same-format old reader after legacy metadata repair");
+        assert_eq!(
+            eol_ledger(&pool).await,
+            after,
+            "old reader made no ledger changes"
+        );
