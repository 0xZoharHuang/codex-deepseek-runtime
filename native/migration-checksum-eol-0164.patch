+#[tokio::test]
+async fn eol_empty_or_mixed_ledgers_prove_no_single_style_without_rewriting() {
+    let empty = eol_pool().await;
+    assert_eq!(super::profile_migration_eol(&empty).await.unwrap(), None);
+    empty.close().await;
+
+    let pool = eol_pool().await;
+    let mut mixed_prefix = super::copy_migrator(&super::STATE_MIGRATOR);
+    mixed_prefix.migrations.to_mut().truncate(2);
+    for (index, migration) in mixed_prefix.migrations.to_mut().iter_mut().enumerate() {
+        *migration = super::migration_form(migration, index % 2 != 0);
+    }
+    mixed_prefix.run(&pool).await.unwrap();
+    let before = eol_ledger(&pool).await;
+    let canonical = super::runtime_state_migrator();
+    let deliberately_opposite_hint = if cfg!(windows) {
+        super::MigrationEol::Lf
+    } else {
+        super::MigrationEol::CrLf
+    };
+    let (selected, established) = super::runtime_migrator_for_database(
+        &pool,
+        &canonical,
+        true,
+        Some(deliberately_opposite_hint),
+    )
+    .await
+    .expect("each mixed known checksum remains valid");
+    assert_eq!(established, None);
+    assert_eq!(super::profile_migration_eol(&pool).await.unwrap(), None);
+    selected.run(&pool).await.unwrap();
+    let after = eol_ledger(&pool).await;
+    assert_eq!(after.len(), canonical.migrations.len());
+    assert!(
+        after.len() > before.len(),
+        "mixed fixture has actual pending migrations"
+    );
+    assert_eq!(&after[..before.len()], &before);
+    for row in &after[before.len()..] {
+        let expected = canonical
+            .iter()
+            .find(|migration| migration.version == row.0)
+            .unwrap();
+        assert_eq!(
+            row.4,
+            expected.checksum.as_ref(),
+            "mixed pending uses platform canonical"
+        );
+    }
+    for crlf in [false, true] {
+        let error = eol_migrator(&super::STATE_MIGRATOR, crlf)
+            .run(&pool)
+            .await
+            .unwrap_err();
+        assert!(matches!(
+            error,
+            sqlx::migrate::MigrateError::VersionMismatch(_)
+        ));
+        assert_eq!(
+            eol_ledger(&pool).await,
+            after,
+            "no old-stock mixed interoperability invented"
+        );
+    }
+    pool.close().await;
+}
