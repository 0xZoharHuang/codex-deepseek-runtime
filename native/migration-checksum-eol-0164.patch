+/// One exact EOL form of the trusted built-in SQL, never a profile marker.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum MigrationEol {
+    Lf,
+    CrLf,
+}
+
+fn platform_eol() -> MigrationEol {
+    if cfg!(windows) {
+        MigrationEol::CrLf
+    } else {
+        MigrationEol::Lf
+    }
