+#[tokio::test]
+async fn eol_existing_auxiliary_ledger_does_not_depend_on_primary_health() {
+    for dirty in [false, true] {
+        let home = crate::runtime::test_support::unique_temp_dir();
+        tokio::fs::create_dir_all(&home).await.unwrap();
+        let _cleanup = scopeguard::guard(home.clone(), |home| {
+            let _ = std::fs::remove_dir_all(home);
+        });
+        let config = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+        let primary = config
+            .open_read_write_pool(&config.state_db_path())
+            .await
+            .unwrap();
+        eol_migrator(&super::STATE_MIGRATOR, false)
+            .run(&primary)
+            .await
+            .unwrap();
+        let logs = config
+            .open_read_write_pool(&config.logs_db_path())
+            .await
+            .unwrap();
+        eol_migrator(&super::LOGS_MIGRATOR, false)
+            .run(&logs)
+            .await
+            .unwrap();
+        let logs_before = eol_ledger(&logs).await;
+        logs.close().await;
+        if dirty {
+            sqlx::query("UPDATE _sqlx_migrations SET success=0 WHERE version=1")
+                .execute(&primary)
+                .await
+                .unwrap();
+        } else {
+            sqlx::query("UPDATE _sqlx_migrations SET checksum=zeroblob(48) WHERE version=1")
+                .execute(&primary)
+                .await
+                .unwrap();
+        }
+        let primary_before = eol_ledger(&primary).await;
+        let canonical = super::runtime_logs_migrator();
+        let logs = config
+            .open_logs_db(&canonical, None)
+            .await
+            .expect("valid existing auxiliary store is independent of primary validation");
+        assert_eq!(eol_ledger(&logs).await, logs_before);
+        assert_eq!(eol_ledger(&primary).await, primary_before);
+        let error = eol_selected(&primary, &super::runtime_state_migrator(), true, None)
+            .await
+            .unwrap_err();
+        assert!(matches!(error, sqlx::migrate::MigrateError::Dirty(1)) == dirty);
+        assert!(matches!(error, sqlx::migrate::MigrateError::VersionMismatch(1)) != dirty);
+        logs.close().await;
+        primary.close().await;
+    }
+}
