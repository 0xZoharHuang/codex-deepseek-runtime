+#[tokio::test]
+async fn eol_crlf_prefix_pending_stays_crlf_on_every_platform() {
+    for (name, base) in eol_domains() {
+        let pool = eol_pool().await;
+        let strict = eol_migrator(base, true);
+        let mut prefix = eol_migrator(base, true);
+        let count = prefix.migrations.len().max(2) / 2;
+        prefix.migrations.to_mut().truncate(count);
+        prefix.run(&pool).await.unwrap();
+        let before = eol_ledger(&pool).await;
+        let canonical = super::runtime_migrator(base);
+        let (selected, hint) =
+            super::runtime_migrator_for_database(&pool, &canonical, name == "state", None)
+                .await
+                .unwrap();
+        assert_eq!(hint, Some(super::MigrationEol::CrLf), "{name}");
+        selected.run(&pool).await.unwrap();
+        let after = eol_ledger(&pool).await;
+        assert_eq!(after.len(), strict.migrations.len(), "{name}");
+        assert!(
+            after.len() > before.len(),
+            "{name} has actual pending migrations"
+        );
+        assert_eq!(&after[..before.len()], &before, "{name}");
+        for row in &after {
+            let expected = strict
+                .iter()
+                .find(|migration| migration.version == row.0)
+                .unwrap();
+            assert_eq!(row.4, expected.checksum.as_ref(), "{name}");
+        }
+        strict
+            .run(&pool)
+            .await
+            .expect("same CRLF strict reader after pending migration");
+        assert_eq!(eol_ledger(&pool).await, after, "{name}");
+        pool.close().await;
+    }
+}
