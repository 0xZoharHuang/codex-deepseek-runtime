+            "memory" => config.open_memories_v2_db().await.unwrap(),
+            "queue" => config.open_queue_db(&canonical, None).await.unwrap(),
+            "history" => config
+                .open_thread_history_db(&canonical, None)
+                .await
+                .unwrap(),
+            _ => unreachable!(),
+        };
+        let legacy = eol_migrator(base, false);
+        let created = eol_ledger(&pool).await;
+        assert_eq!(created.len(), legacy.migrations.len(), "{name}");
+        for row in &created {
+            let expected = legacy
+                .iter()
+                .find(|migration| migration.version == row.0)
+                .unwrap();
+            assert_eq!(row.4, expected.checksum.as_ref(), "{name}");
+        }
+        legacy
+            .run(&pool)
+            .await
+            .expect("old P6 opens newly created legacy-profile auxiliary store");
+        assert_eq!(
+            eol_ledger(&pool).await,
+            created,
+            "{name}: old reader must not add or rewrite rows"
+        );
+        pool.close().await;
+    }
+    let primary = config
+        .open_read_only_pool(&config.state_db_path(), None)
+        .await
+        .unwrap();
+    assert_eq!(eol_ledger(&primary).await, primary_before);
+    primary.close().await;
+}
