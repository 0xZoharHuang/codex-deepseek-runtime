+#[tokio::test]
+async fn eol_primary_proven_style_inherited_by_missing_and_empty_aux_stores() {
+    use sqlx::migrate::Migrate;
+    for crlf in [false, true] {
+        for empty_table in [false, true] {
+            let home = crate::runtime::test_support::unique_temp_dir();
+            tokio::fs::create_dir_all(&home).await.unwrap();
+            let _cleanup = scopeguard::guard(home.clone(), |home| {
+                let _ = std::fs::remove_dir_all(home);
+            });
+            let config = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+            let primary = config
+                .open_read_write_pool(&config.state_db_path())
+                .await
+                .unwrap();
+            eol_migrator(&super::STATE_MIGRATOR, crlf)
+                .run(&primary)
+                .await
+                .unwrap();
+            let expected_hint = if crlf {
+                super::MigrationEol::CrLf
+            } else {
+                super::MigrationEol::Lf
+            };
+            assert_eq!(
+                super::profile_migration_eol(&primary).await.unwrap(),
+                Some(expected_hint)
+            );
+            let primary_before = eol_ledger(&primary).await;
+            primary.close().await;
+            let domains = [
+                ("logs", &super::LOGS_MIGRATOR),
+                ("goals", &super::GOALS_MIGRATOR),
+                ("memory-v1", &super::MEMORIES_MIGRATOR),
+                ("memory-v2", &super::MEMORIES_MIGRATOR),
+                ("queue", &super::QUEUE_MIGRATOR),
+                ("history", &super::THREAD_HISTORY_MIGRATOR),
+            ];
+            for (name, base) in domains {
+                if empty_table {
+                    let path = match name {
+                        "logs" => config.logs_db_path(),
+                        "goals" => config.goals_db_path(),
+                        "memory-v1" => config.memories_db_path(),
+                        "memory-v2" => config.memories_v2_db_path(),
+                        "queue" => config.queue_db_path(),
+                        "history" => config.thread_history_db_path(),
+                        _ => unreachable!(),
+                    };
+                    let empty = config.open_read_write_pool(&path).await.unwrap();
+                    let mut connection = empty.acquire().await.unwrap();
+                    connection
+                        .ensure_migrations_table(&base.table_name)
+                        .await
+                        .unwrap();
+                    drop(connection);
+                    assert!(eol_ledger(&empty).await.is_empty());
+                    empty.close().await;
+                }
+                let canonical = super::runtime_migrator(base);
+                let pool = match name {
+                    "logs" => config.open_logs_db(&canonical, None).await.unwrap(),
+                    "goals" => config.open_goals_db(&canonical, None).await.unwrap(),
+                    "memory-v1" => config.open_memories_db(&canonical, None).await.unwrap(),
+                    "memory-v2" => config.open_memories_v2_db().await.unwrap(),
+                    "queue" => config.open_queue_db(&canonical, None).await.unwrap(),
+                    "history" => config
+                        .open_thread_history_db(&canonical, None)
+                        .await
+                        .unwrap(),
+                    _ => unreachable!(),
+                };
+                let before = eol_ledger(&pool).await;
+                let strict = eol_migrator(base, crlf);
+                assert_eq!(before.len(), strict.migrations.len(), "{name}");
+                for row in &before {
+                    let expected = strict
+                        .iter()
+                        .find(|migration| migration.version == row.0)
+                        .unwrap();
+                    assert_eq!(row.4, expected.checksum.as_ref(), "{name}");
+                }
+                strict
+                    .run(&pool)
+                    .await
+                    .expect("inherited style is strict-reader compatible");
+                assert_eq!(eol_ledger(&pool).await, before, "{name}");
+                pool.close().await;
+            }
+            let primary = config
+                .open_read_only_pool(&config.state_db_path(), None)
+                .await
+                .unwrap();
+            assert_eq!(eol_ledger(&primary).await, primary_before);
+            primary.close().await;
+        }
+    }
+}
