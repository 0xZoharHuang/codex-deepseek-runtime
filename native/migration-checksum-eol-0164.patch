+#[tokio::test]
+async fn eol_missing_lazy_stores_inherit_lf_primary_for_old_p6_rollback() {
+    let home = crate::runtime::test_support::unique_temp_dir();
+    tokio::fs::create_dir_all(&home).await.unwrap();
