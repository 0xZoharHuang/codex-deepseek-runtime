+
+fn migration_form(migration: &Migration, crlf: bool) -> Migration {
+    let lf = migration.sql.as_str().replace("\r\n", "\n");
+    let sql = if crlf { lf.replace('\n', "\r\n") } else { lf };
+    // This is exclusively an EOL representation of the trusted embedded SQL.
+    Migration::new(
+        migration.version,
+        migration.description.clone(),
+        migration.migration_type,
+        AssertSqlSafe(sql).into_sql_str(),
+        migration.no_tx,
+    )
+}
+
+fn copy_migrator(base: &Migrator) -> Migrator {
+    Migrator {
+        migrations: Cow::Owned(base.migrations.to_vec()),
+        ignore_missing: base.ignore_missing,
+        locking: base.locking,
+        no_tx: base.no_tx,
+        table_name: base.table_name.clone(),
+        create_schemas: base.create_schemas.clone(),
+    }
+}
