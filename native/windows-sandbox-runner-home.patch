+#[cfg(test)]
+mod namespace_home_tests {
+    use super::*;
+
+    #[test]
+    fn runner_read_acl_mutex_uses_real_home_from_spawn_request() {
+        let fixture = tempfile::tempdir().expect("owned fixture");
+        let home = fixture.path().join("private-home");
+        let sandbox_base = home.join(".sandbox");
+        std::fs::create_dir_all(&sandbox_base).expect("sandbox directory");
+        let namespace = "a".repeat(64);
+        std::fs::write(
+            sandbox_base.join("setup_marker.json"),
+            serde_json::to_vec(&serde_json::json!({"namespace": namespace})).unwrap(),
+        )
+        .expect("synthetic marker");
+        let mut request = SpawnRequest {
+            command: vec![],
+            cwd: fixture.path().join("workspace"),
+            env: std::collections::HashMap::new(),
+            permission_profile: codex_protocol::models::PermissionProfile::read_only(),
+            workspace_roots: vec![],
+            // Match both actual parent IPC constructors, not the legacy field name.
+            codex_home: sandbox_base.clone(),
+            real_codex_home: home,
+            cap_sids: vec![],
+            network_proxy_restricting_sid: None,
+            timeout_ms: None,
+            tty: false,
+            stdin_open: false,
+            private_desktop_name: None,
+        };
+        let actual = read_acl_mutex_name(&request).expect("real home namespace");
+        assert_eq!(
+            String::from_utf16(&actual[..actual.len() - 1]).unwrap(),
+            format!("Local\\CodexDeepSeekReadAcl-{namespace}")
+        );
+        assert!(!sandbox_base.join(".sandbox").exists());
+        // A regression to the log-directory field must fail, never silently resolve.
+        request.real_codex_home = request.codex_home.clone();
+        assert!(read_acl_mutex_name(&request).is_err());
+    }
+}
