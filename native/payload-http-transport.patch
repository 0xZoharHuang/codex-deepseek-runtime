+async fn forward_raw(State(shared): State<Arc<Shared>>, headers: HeaderMap, body: Bytes) -> Response {
+    if !authorized(&headers, &shared.config.token) {
+        return failure(StatusCode::UNAUTHORIZED, "Unauthorized");
+    }
+    let Some(raw) = headers.get("x-cds-transport-metadata") else {
+        return failure(StatusCode::BAD_REQUEST, "Missing bounded raw request metadata");
+    };
+    if raw.as_bytes().len() > METADATA_BYTES_LIMIT {
+        return failure(StatusCode::BAD_REQUEST, "Raw request metadata exceeds its budget");
+    }
+    let Ok(metadata) = serde_json::from_slice::<RawMetadata>(raw.as_bytes()) else {
+        return failure(StatusCode::BAD_REQUEST, "Invalid raw request metadata");
+    };
+    let Ok(url) = Url::parse(&metadata.url) else {
+        return failure(StatusCode::BAD_REQUEST, "Invalid upstream URL");
+    };
+    if !raw_request_allowed(&url, &shared.origin, &metadata.method, metadata.content_type.as_deref(), body.len()) {
+        return failure(StatusCode::BAD_REQUEST, "Raw method, destination, body or content type is outside its contract");
+    }
+    let request = Request { api_key: metadata.api_key, url: metadata.url, method: metadata.method, payload: None, policy: metadata.policy };
+    forward_request(shared, request, Some((body, metadata.content_type))).await
+}
