+const JSON_BYTES_LIMIT: usize = 96 * 1024 * 1024;
+const FILE_BYTES_LIMIT: usize = 100 * 1024 * 1024 + 16384;
+const METADATA_BYTES_LIMIT: usize = 8192;
+
+fn file_object_path(path: &str) -> bool {
+    path.strip_prefix("/api/v1/files/or_file_").is_some_and(|id| {
+        (8..=128).contains(&id.len()) && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+    })
+}
+
+fn raw_request_allowed(url: &Url, upstream: &Url, method: &str, content_type: Option<&str>, size: usize) -> bool {
+    if url.origin() != upstream.origin() || !url.username().is_empty() || url.password().is_some() || url.fragment().is_some() {
+        return false;
+    }
+    match method {
+        "GET" => size == 0 && content_type.is_none() && (url.path() == "/api/v1/files" || file_object_path(url.path())),
+        "DELETE" => size == 0 && content_type.is_none() && file_object_path(url.path()),
+        "POST" if url.path() == upstream.path() => content_type == Some("application/json") && size <= JSON_BYTES_LIMIT,
+        "POST" if url.path() == "/api/v1/files" => size > 0 && size <= FILE_BYTES_LIMIT && content_type.is_some_and(|value| {
+            value.strip_prefix("multipart/form-data; boundary=").is_some_and(|boundary| {
+                (1..=70).contains(&boundary.len()) && boundary.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+            })
+        }),
+        _ => false,
+    }
+}
