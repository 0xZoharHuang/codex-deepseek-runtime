+#[cfg(test)]
+mod raw_ipc_tests {
+    use super::*;
+    fn upstream() -> Url { Url::parse("https://openrouter.ai/api/v1/responses").unwrap() }
+    #[test]
+    fn raw_scope_is_only_responses_and_files() {
+        let api=upstream();
+        let file=Url::parse("https://openrouter.ai/api/v1/files/or_file_12345678").unwrap();
+        assert!(raw_request_allowed(&api,&api,"POST",Some("application/json"),JSON_BYTES_LIMIT));
+        assert!(raw_request_allowed(&file,&api,"GET",None,0));
+        assert!(raw_request_allowed(&file,&api,"DELETE",None,0));
+        assert!(!raw_request_allowed(&file,&api,"DELETE",None,1));
+        assert!(!raw_request_allowed(&api,&api,"DELETE",None,0));
+        assert!(!raw_request_allowed(&api,&api,"POST",Some("application/json"),JSON_BYTES_LIMIT+1));
+        for value in ["https://other.invalid/api/v1/files/or_file_12345678", "https://openrouter.ai/api/v1/keys/12345678", "https://u:p@openrouter.ai/api/v1/files/or_file_12345678", "https://openrouter.ai/api/v1/files/or_file_12345678#x"] {
+            assert!(!raw_request_allowed(&Url::parse(value).unwrap(),&api,"DELETE",None,0));
+        }
+    }
+    #[test]
+    fn multipart_is_bounded_and_does_not_enable_legacy_delete() {
+        let api=upstream();let files=Url::parse("https://openrouter.ai/api/v1/files").unwrap();
+        assert!(raw_request_allowed(&files,&api,"POST",Some("multipart/form-data; boundary=cds-123"),FILE_BYTES_LIMIT));
+        assert!(!raw_request_allowed(&files,&api,"POST",Some("multipart/form-data; boundary=bad\r\nInjected"),1));
+        assert!(!raw_request_allowed(&files,&api,"POST",Some("application/json"),1));
+        assert!(!raw_request_allowed(&files,&api,"DELETE",None,0));
+    }
+    #[test]
+    fn ambiguous_metadata_is_rejected() {
+        assert!(serde_json::from_str::<RawMetadata>(r#"{"api_key":"a","api_key":"b","url":"x","method":"GET","policy":"default","content_type":null}"#).is_err());
+        assert!(serde_json::from_str::<RawMetadata>(r#"{"api_key":"a","url":"x","method":"GET","policy":"default","content_type":null,"unexpected":true}"#).is_err());
+    }
