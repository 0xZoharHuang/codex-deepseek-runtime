+    #[test]
+    fn restricted_thread_cannot_borrow_process_restore_privilege() -> Result<()> {
+        use windows_sys::Win32::Security::{
+            AdjustTokenPrivileges, LookupPrivilegeValueW, SE_PRIVILEGE_REMOVED, SE_RESTORE_NAME,
+            TOKEN_PRIVILEGES,
+        };
+        std::thread::spawn(|| -> Result<()> {
+            let restricted = duplicate_effective_token()?;
+            unsafe {
+                let mut state = TOKEN_PRIVILEGES::default();
+                state.PrivilegeCount = 1;
+                ensure!(
+                    LookupPrivilegeValueW(
+                        ptr::null(),
+                        SE_RESTORE_NAME,
+                        &mut state.Privileges[0].Luid
+                    ) != 0,
+                    "resolve fixture restore privilege"
+                );
+                state.Privileges[0].Attributes = SE_PRIVILEGE_REMOVED;
+                ensure!(
+                    AdjustTokenPrivileges(
+                        restricted.as_raw_handle() as _,
+                        0,
+                        &state,
+                        0,
+                        ptr::null_mut(),
+                        ptr::null_mut()
+                    ) != 0,
+                    "remove any restore privilege from test-only copy"
+                );
+                ensure!(
+                    SetThreadToken(ptr::null(), restricted.as_raw_handle() as _) != 0,
+                    "set restricted test token"
+                );
+                let result = caller_copy();
+                ensure!(
+                    SetThreadToken(ptr::null(), ptr::null_mut()) != 0,
+                    "clear restricted test token"
+                );
+                assert!(
+                    result.is_err(),
+                    "the effective restricted token must not borrow the process token"
+                );
+            }
+            Ok(())
+        })
+        .join()
+        .expect("restricted token test worker")
+    }
+
+    #[test]
+    fn retry_classifier_accepts_only_real_win32_access_denied() {
+        let denied =
+            anyhow::Error::new(std::io::Error::from_raw_os_error(5)).context("NtCreateFile");
+        let sharing = anyhow::Error::new(std::io::Error::from_raw_os_error(32));
+        assert!(access_denied(&denied));
+        assert!(!access_denied(&sharing));
+        assert!(!access_denied(&anyhow::anyhow!("Access denied")));
+    }
