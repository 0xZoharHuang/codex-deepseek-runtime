+//! Reopen a SYSTEM-owned protected bin installed by this same namespace.
+//! The normal open remains the first choice. This path never creates a target.
+use crate::file_security::get_raw_file_security;
+use crate::no_reparse_dir::{DirectoryOpenDisposition, open_directory_no_reparse};
+use anyhow::{Context, Result, ensure};
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+use std::ptr;
+use windows_sys::Win32::Foundation::{ERROR_ACCESS_DENIED, ERROR_NO_TOKEN, LocalFree};
+use windows_sys::Win32::Security::{
+    ACE_HEADER, ACL, DACL_SECURITY_INFORMATION, DuplicateTokenEx, GetAce,
+    GetSecurityDescriptorControl, IsValidAcl, IsValidSid, IsWellKnownSid,
+    OWNER_SECURITY_INFORMATION, SE_DACL_PROTECTED, SecurityImpersonation, TOKEN_ADJUST_PRIVILEGES,
+    TOKEN_DUPLICATE, TOKEN_IMPERSONATE, TOKEN_QUERY, TokenImpersonation, WinLocalSystemSid,
+};
+use windows_sys::Win32::Storage::FileSystem as fs;
+use windows_sys::Win32::System::Threading::{
+    GetCurrentProcess, GetCurrentThread, OpenProcessToken, OpenThreadToken, SetThreadToken,
+};
+
+pub(super) fn access_denied(error: &anyhow::Error) -> bool {
+    error
+        .downcast_ref::<std::io::Error>()
+        .and_then(|e| e.raw_os_error())
+        == Some(ERROR_ACCESS_DENIED as i32)
+}
+
+pub(super) fn pin_existing(path: &Path) -> Result<OwnedHandle> {
+    open_directory_no_reparse(
+        path,
+        fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+        fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+        DirectoryOpenDisposition::OpenExisting,
+    )
+}
+
+// Compare each ACE with the ACL generated for this payload, including type,
+// SID, mask, inheritance and order. The ACL's reserved storage is irrelevant.
+unsafe fn exact_bin_aces(actual: *mut ACL, expected: *mut ACL) -> bool {
+    if actual.is_null()
+        || expected.is_null()
+        || IsValidAcl(actual) == 0
+        || IsValidAcl(expected) == 0
+        || (*actual).AclRevision != (*expected).AclRevision
+        || (*actual).AceCount != 4
+        || (*expected).AceCount != 4
+    {
+        return false;
+    }
+    (0..4).all(|index| {
+        let mut left = ptr::null_mut();
+        let mut right = ptr::null_mut();
+        if GetAce(actual, index, &mut left) == 0 || GetAce(expected, index, &mut right) == 0 {
+            return false;
+        }
+        let left_header = &*left.cast::<ACE_HEADER>();
+        let right_header = &*right.cast::<ACE_HEADER>();
+        left_header.AceType == 0
+            && right_header.AceType == 0
+            && left_header.AceSize == right_header.AceSize
+            && std::slice::from_raw_parts(left.cast::<u8>(), left_header.AceSize as usize)
+                == std::slice::from_raw_parts(right.cast::<u8>(), right_header.AceSize as usize)
+    })
+}
+
+unsafe fn require_native_bin(handle: &OwnedHandle, expected: *mut ACL) -> Result<()> {
+    let (mut owner, mut acl, mut sd) = (ptr::null_mut(), ptr::null_mut(), ptr::null_mut());
+    let code = get_raw_file_security(
+        handle.as_raw_handle() as _,
+        1,
+        OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+        &mut owner,
+        ptr::null_mut(),
+        &mut acl,
+        ptr::null_mut(),
+        &mut sd,
+    );
+    let checked = (|| -> Result<()> {
+        ensure!(code == 0, "read managed sandbox bin owner and DACL: {code}");
+        ensure!(
+            !owner.is_null()
+                && IsValidSid(owner) != 0
+                && IsWellKnownSid(owner, WinLocalSystemSid) != 0,
+            "managed ACL retry requires the SYSTEM-owned namespace bin"
+        );
+        let (mut control, mut revision) = (0, 0);
+        ensure!(
+            GetSecurityDescriptorControl(sd, &mut control, &mut revision) != 0
+                && control & SE_DACL_PROTECTED != 0,
+            "managed ACL retry requires a protected namespace bin"
+        );
+        ensure!(
+            exact_bin_aces(acl, expected),
+            "managed ACL retry refuses a different or denied bin layout"
+        );
+        Ok(())
+    })();
+    if !sd.is_null() {
+        LocalFree(sd);
+    }
+    checked
+}
+
+// Duplicate the effective caller. A pre-existing impersonation that cannot be
+// opened is an error, never a reason to substitute the more privileged process.
+fn duplicate_effective_token() -> Result<OwnedHandle> {
+    let mut raw = ptr::null_mut();
+    unsafe {
+        if OpenThreadToken(
+            GetCurrentThread(),
+            TOKEN_DUPLICATE | TOKEN_QUERY,
+            1,
+            &mut raw,
+        ) == 0
+        {
+            let e = std::io::Error::last_os_error();
+            if e.raw_os_error() != Some(ERROR_NO_TOKEN as i32) {
+                return Err(e).context("open effective thread token");
+            }
+            if OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &mut raw) == 0 {
+                return Err(std::io::Error::last_os_error())
+                    .context("open effective process token");
+            }
+        }
+        let source = OwnedHandle::from_raw_handle(raw);
+        if DuplicateTokenEx(
+            source.as_raw_handle() as _,
+            TOKEN_QUERY | TOKEN_ADJUST_PRIVILEGES | TOKEN_IMPERSONATE,
+            ptr::null(),
+            SecurityImpersonation,
+            TokenImpersonation,
+            &mut raw,
+        ) == 0
+        {
+            return Err(std::io::Error::last_os_error())
+                .context("duplicate effective token for managed bin");
+        }
+        Ok(OwnedHandle::from_raw_handle(raw))
+    }
+}
+
+fn caller_copy() -> Result<OwnedHandle> {
+    let copy = duplicate_effective_token()?;
+    unsafe {
+        crate::token::enable_single_privilege(copy.as_raw_handle() as _, "SeRestorePrivilege")
+    }
+    .context("existing caller token lacks managed bin restore privilege")?;
+    Ok(copy)
+}
+
+fn scoped_reopen(path: &Path) -> Result<OwnedHandle> {
+    let copy = caller_copy()?;
+    std::thread::scope(|scope| {
+        // A new joined thread cannot alter the caller thread's token, even on
+        // panic or failure to revert. No other work runs on this thread.
+        let opener = std::thread::Builder::new()
+            .spawn_scoped(scope, move || -> Result<OwnedHandle> {
+                unsafe {
+                    if SetThreadToken(ptr::null(), copy.as_raw_handle() as _) == 0 {
+                        return Err(std::io::Error::last_os_error())
+                            .context("set managed bin opener token");
+                    }
+                }
+                let opened = crate::no_reparse_dir::reopen_managed_acl(path);
+                if unsafe { SetThreadToken(ptr::null(), ptr::null_mut()) } == 0 {
+                    let revert = std::io::Error::last_os_error();
+                    return match opened {
+                        Err(error) => {
+                            Err(error).context(format!("clear managed bin opener token: {revert}"))
+                        }
+                        Ok(_) => Err(revert).context("clear managed bin opener token"),
+                    };
+                }
+                opened
+            })
+            .context("start managed bin opener")?;
+        opener
+            .join()
+            .map_err(|_| anyhow::anyhow!("managed bin opener panicked"))?
+    })
+}
+
+// The caller keeps its original no-delete pin and native ACL coordination lock
+// throughout both checks, the privileged open, and the original SetSecurityInfo.
+pub(super) unsafe fn reopen_matching_bin(
+    path: &Path,
+    pin: &OwnedHandle,
+    expected: *mut ACL,
+) -> Result<OwnedHandle> {
+    require_native_bin(pin, expected)?;
+    let writable = scoped_reopen(path)?;
+    ensure!(
+        crate::acl_lock::same_file_identity(
+            pin.as_raw_handle() as _,
+            writable.as_raw_handle() as _
+        )?,
+        "managed bin identity changed during ACL reopen"
+    );
+    require_native_bin(&writable, expected)?;
+    Ok(writable)
+}
