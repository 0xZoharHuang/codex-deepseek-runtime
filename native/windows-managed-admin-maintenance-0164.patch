+#[cfg(test)]
+mod tests {
+    use super::*;
+    use windows_sys::Win32::Security::{
+        ACL_REVISION, AddAccessAllowedAceEx, AddAccessDeniedAceEx, InitializeAcl,
+    };
+
+    fn fixture_acl(
+        deny_index: Option<usize>,
+        extra: bool,
+        flags: u32,
+        mask: u32,
+    ) -> Result<Vec<u32>> {
+        let mut buf = vec![0u32; 256];
+        let acl = buf.as_mut_ptr().cast::<ACL>();
+        ensure!(
+            unsafe { InitializeAcl(acl, (buf.len() * 4) as u32, ACL_REVISION) } != 0,
+            "fixture ACL"
+        );
+        for (i, text) in [
+            "S-1-5-18",
+            "S-1-5-32-544",
+            "S-1-5-21-1-2-3-2100",
+            "S-1-5-21-1-2-3-2101",
+            "S-1-1-0",
+        ]
+        .iter()
+        .enumerate()
+        .take(if extra { 5 } else { 4 })
+        {
+            let sid = crate::token::LocalSid::from_string(text)?;
+            let ok = if deny_index == Some(i) {
+                unsafe { AddAccessDeniedAceEx(acl, ACL_REVISION, flags, mask, sid.as_ptr()) }
+            } else {
+                unsafe { AddAccessAllowedAceEx(acl, ACL_REVISION, flags, mask, sid.as_ptr()) }
+            };
+            ensure!(ok != 0, "fixture ACE");
+        }
+        Ok(buf)
+    }
+
+    #[test]
+    fn layout_retry_refuses_changed_denied_or_extra_aces() -> Result<()> {
+        let mut expected = fixture_acl(None, false, 3, fs::FILE_GENERIC_READ)?;
+        let p = expected.as_mut_ptr().cast::<ACL>();
+        for (mut candidate, matches) in [
+            (fixture_acl(None, false, 3, fs::FILE_GENERIC_READ)?, true),
+            (
+                fixture_acl(Some(1), false, 3, fs::FILE_GENERIC_READ)?,
+                false,
+            ),
+            (fixture_acl(None, true, 3, fs::FILE_GENERIC_READ)?, false),
+            (fixture_acl(None, false, 1, fs::FILE_GENERIC_READ)?, false),
+            (fixture_acl(None, false, 3, fs::FILE_GENERIC_WRITE)?, false),
+        ] {
+            assert_eq!(
+                unsafe { exact_bin_aces(candidate.as_mut_ptr().cast(), p) },
+                matches
+            );
+        }
+        Ok(())
+    }
+
