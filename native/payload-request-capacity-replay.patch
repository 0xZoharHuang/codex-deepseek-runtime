+    fn replay_compacted_metadata(
+        items: &[ResponseItemEnvelope],
+    ) -> Result<Vec<ResponseItemEnvelope>> {
+        // Exercise the native CompactedItem parallel metadata wire format, not
+        // independent ResponseItem lines (which preserve Option presence).
+        let mut compacted: codex_history::CompactedItem =
+            serde_json::from_value(serde_json::json!({"message":"native summary"}))?;
+        compacted.replacement_history = Some(items.to_vec());
+        let wire = serde_json::to_vec(&codex_history::RolloutItem::Compacted(compacted))?;
+        match serde_json::from_slice::<codex_history::RolloutItem>(&wire)? {
+            codex_history::RolloutItem::Compacted(compacted) => compacted
+                .replacement_history
+                .context("native compaction lost replacement history"),
+            _ => anyhow::bail!("native rollout changed compacted item type"),
+        }
+    }
