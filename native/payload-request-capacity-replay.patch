+    #[test]
+    fn legacy_metadata_accepts_only_two_fixed_v2_forms_without_mutation() -> Result<()> {
+        let warm = compacted_metadata_fixture()?;
+        let cold = replay_compacted_metadata(&warm)?;
+        let before = cold.clone();
+        let home = tempfile::tempdir()?;
+        let mut record = checkpoint(home.path());
+        record.prefix_len = warm.len();
+        // Cold exact form: old checkpoint authored after replay already had all Some.
+        record.prefix_hash = prefix_hash_with_metadata(&cold, MetadataHashMode::LegacyExact)?;
+        assert_ne!(record.prefix_hash, prefix_hash(&cold)?);
+        assert!(record.matches_prefix(&cold)?);
+        // Pre-replay form: every exact-Default slot was absent in live input.
+        record.prefix_hash = prefix_hash_with_metadata(&warm, MetadataHashMode::LegacyExact)?;
+        assert_eq!(
+            record.prefix_hash,
+            prefix_hash_with_metadata(&cold, MetadataHashMode::LegacyDefaultAsNone)?
+        );
+        let original_record = record.clone();
+        assert!(record.matches_prefix(&cold)?);
+        assert_eq!(record, original_record);
+        assert_eq!(cold, before);
+        let mut changed = cold.clone();
+        changed[0].item = envelope("changed legacy payload")?.item;
+        assert!(!record.matches_prefix(&changed)?);
+        let mut changed = cold.clone();
+        changed.swap(0, 1);
+        assert!(!record.matches_prefix(&changed)?);
+        let mut changed = cold.clone();
+        let mut payload = serde_json::to_value(&changed[4].item)?;
+        payload["internal_chat_message_metadata_passthrough"]["turn_id"] =
+            serde_json::json!("changed-legacy-opaque-turn");
+        changed[4].item = serde_json::from_value(payload)?;
+        assert!(!record.matches_prefix(&changed)?);
+        let mut changed = cold.clone();
+        changed[2].metadata.as_mut().unwrap().client_authored = false;
+        assert!(!record.matches_prefix(&changed)?);
+        let mut changed = cold.clone();
+        changed[3]
+            .metadata
+            .as_mut()
+            .unwrap()
+            .history_truncation_token_limit = Some(1201);
+        assert!(!record.matches_prefix(&changed)?);
+        let mut mixed_old = warm.clone();
+        mixed_old[1].metadata = Some(Default::default());
+        record.prefix_hash = prefix_hash_with_metadata(&mixed_old, MetadataHashMode::LegacyExact)?;
+        assert!(record.matches_prefix(&mixed_old)?);
+        assert!(
+            !record.matches_prefix(&cold)?,
+            "must not guess mixed legacy Option slots"
+        );
+        record.prefix_hash = format!("sha256-v1:{}", "0".repeat(64));
+        assert!(!record.matches_prefix(&cold)?);
+        record.prefix_len = cold.len() + 1;
+        assert!(!record.matches_prefix(&cold)?);
+        assert_eq!(cold, before);
+        Ok(())
+    }
