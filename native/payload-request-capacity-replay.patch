+    #[test]
+    fn native_compacted_parallel_metadata_replay_hash_is_stable_and_strict() -> Result<()> {
+        let mut warm = compacted_metadata_fixture()?;
+        warm[1].metadata = Some(Default::default());
+        let before = warm.clone();
+        let cold = replay_compacted_metadata(&warm)?;
+        assert!(warm[0].metadata.is_none());
+        assert_eq!(cold[0].metadata, Some(Default::default()));
+        assert_eq!(cold[1].metadata, warm[1].metadata);
+        assert_eq!(cold[2].metadata, warm[2].metadata);
+        assert_eq!(cold[3].metadata, warm[3].metadata);
+        assert_ne!(
+            warm, cold,
+            "fixture must expose native Option materialization"
+        );
+        let expected = prefix_hash(&warm)?;
+        assert_eq!(prefix_hash(&cold)?, expected);
+        assert_eq!(warm, before, "hash projection mutated live history");
+        let home = tempfile::tempdir()?;
+        let mut record = checkpoint(home.path());
+        record.prefix_len = warm.len();
+        record.prefix_hash = expected;
+        let mut tampered = Vec::new();
+        let mut changed = cold.clone();
+        changed[0].item = envelope("different payload")?.item;
+        tampered.push(changed);
+        let mut changed = cold.clone();
+        changed.swap(0, 1);
+        tampered.push(changed);
+        let mut changed = cold.clone();
+        changed[2].metadata.as_mut().unwrap().client_authored = false;
+        tampered.push(changed);
+        let mut changed = cold.clone();
+        changed[3]
+            .metadata
+            .as_mut()
+            .unwrap()
+            .history_truncation_token_limit = Some(1201);
+        tampered.push(changed);
+        let mut changed = cold.clone();
+        changed[3].metadata.as_mut().unwrap().user_input_order = Some(8);
+        tampered.push(changed);
+        for (field, value) in [
+            ("turn_id", serde_json::json!("different-opaque-turn")),
+            (
+                "content_item_kinds",
+                serde_json::json!(["different.kind", "tool.image"]),
+            ),
+        ] {
+            let mut changed = cold.clone();
+            let mut payload = serde_json::to_value(&changed[4].item)?;
+            payload["internal_chat_message_metadata_passthrough"][field] = value;
+            changed[4].item = serde_json::from_value(payload)?;
+            tampered.push(changed);
+        }
+        let mut changed = cold.clone();
+        let mut payload = serde_json::to_value(&changed[4].item)?;
+        payload["output"][1]["image_url"] = serde_json::json!("data:image/png;base64,AQ==");
+        changed[4].item = serde_json::from_value(payload)?;
+        tampered.push(changed);
+        for changed in tampered {
+            assert!(
+                !record.matches_prefix(&changed)?,
+                "nondefault/payload/order mutation passed"
+            );
+        }
+        assert_eq!(warm, before);
+        Ok(())
+    }
