+    /// Reservation is polled before spawning so a later steer/model snapshot
+    /// cannot overtake an admitted commit, including while the boundary is busy.
+    /// Dropping the caller's JoinHandle does not cancel this owned operation.
+    pub(crate) fn spawn_ordered_native_persistence<F>(
+        self: &Arc<Self>,
+        operation: F,
+    ) -> Option<JoinHandle<F::Output>>
+    where
+        F: Future + Send + 'static,
+        F::Output: Send + 'static,
