+struct CapacityResetCommitTask {
+    prefix: std::sync::Mutex<Option<CapacityPrefix>>,
+}
+impl SessionTask for CapacityResetCommitTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Compact
+    }
+    fn span_name(&self) -> &'static str {
+        "session_task.capacity_commit_regression"
+    }
+    async fn run(
+        self: Arc<Self>,
+        session: Arc<Session>,
+        ctx: Arc<TurnContext>,
+        _input: Vec<TurnInput>,
+        cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        let prefix = self
+            .prefix
+            .lock()
+            .unwrap()
+            .take()
+            .expect("one admitted reset");
+        let step = session
+            .capture_step_context(Arc::clone(&ctx), &cancellation_token)
+            .await?;
+        let world = Arc::new(session.build_world_state_for_step(&step, true).await?);
+        crate::compact_token_budget::run_inline_capacity_reset_task(
+            session,
+            step,
+            world,
+            prefix,
+            codex_protocol::error::UnexpectedResponseError {
+                status: http::StatusCode::PAYLOAD_TOO_LARGE,
+                body: "owned native writer regression fixture".to_owned(),
+                user_message: None,
+                url: None,
+                cf_ray: None,
+                request_id: None,
+                identity_authorization_error: None,
+                identity_error_code: None,
+            },
+            cancellation_token,
+        )
+        .await?;
+        Ok(None)
+    }
+}
