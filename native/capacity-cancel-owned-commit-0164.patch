+        assert_eq!(ordinary.completed_epoch, fenced.completed_epoch + 1);
+        assert_eq!(ordinary.response_id, "ordinary-after-owned-commit");
+        assert_eq!(ordinary.recovery_turn_id, None);
+        let disk_ordinary: serde_json::Value = serde_json::from_slice(&std::fs::read(
+            capacity_checkpoint_file(home.path(), session.thread_id),
+        )?)?;
+        assert_eq!(
+            disk_ordinary["checkpoint"],
+            serde_json::to_value(&ordinary)?
+        );
+    }
+    let aborted_turns = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event.msg {
+            EventMsg::TurnAborted(event) => Some((event.turn_id, event.reason)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        aborted_turns,
+        vec![(Some(turn.sub_id.clone()), TurnAbortReason::Interrupted)],
+        "the exact actual native task must close through Interrupted TurnAborted",
+    );
+    session.drain_code_mode_messages().await;
+    assert!(session.spawn_ordered_native_persistence(async {}).is_none());
+    session.live_thread().unwrap().shutdown().await?;
+    Ok(())
+}
