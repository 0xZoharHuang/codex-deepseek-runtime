+            .tasks
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner);
+        // Admission and spawn share the same lock used by native shutdown.
+        if tasks.is_closed() {
+            return None;
+        }
+        Some(tasks.spawn(async move {
+            let _boundary = match reserved {
+                Poll::Ready(permit) => permit,
+                Poll::Pending => reservation.await,
+            }
+            .unwrap_or_else(|_| unreachable!("communication boundary remains open"));
+            operation.await
+        }))
