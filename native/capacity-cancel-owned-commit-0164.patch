+    let (disk_mid, _, errors) = RolloutRecorder::load_rollout_items(&rollout_path).await?;
+    assert_eq!(errors, 0);
+    assert_eq!(
+        disk_mid
+            .iter()
+            .filter(|item| matches!(item, RolloutItem::Compacted(_)))
+            .count(),
