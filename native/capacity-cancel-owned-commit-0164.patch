+async fn capacity_commit_writer_fixture(
+    after_append: bool,
+    interrupt_marker: bool,
+) -> anyhow::Result<(
+    tempfile::TempDir,
+    Arc<Session>,
+    Arc<TurnContext>,
+    Arc<CapacityCommitBarrierStore>,
+    PathBuf,
+    async_channel::Receiver<Event>,
+)> {
+    let home = tempfile::tempdir()?;
+    let home_path = AbsolutePathBuf::from_absolute_path(home.path())?;
+    let (mut session, mut turn, events) = make_session_and_context_with_auth_and_config_and_rx(
+        CodexAuth::from_api_key("Test API Key"),
+        Vec::new(),
+        move |config| {
+            config.codex_home = home_path;
+            config.agent_interrupt_message_enabled = interrupt_marker;
+            config.analytics_enabled = Some(false);
+        },
+    )
+    .await;
+    Arc::get_mut(&mut turn).expect("unique fixture turn").sub_id = Uuid::new_v4().to_string();
+    let barrier = Arc::new(CapacityCommitBarrierStore {
+        inner: Arc::clone(&session.services.thread_store),
+        after_append,
+        armed: AtomicBool::new(false),
+        entered: tokio::sync::Notify::new(),
+        release: tokio::sync::Notify::new(),
+        delegated_compactions: AtomicUsize::new(0),
+    });
+    let mutable_session = Arc::get_mut(&mut session).expect("unique fixture session");
+    mutable_session.services.thread_store = barrier.clone();
+    let rollout_path = attach_thread_persistence(mutable_session).await;
+    assert!(
+        session.live_thread().is_some(),
+        "must exercise native writer"
+    );
+    Ok((home, session, turn, barrier, rollout_path, events))
+}
+
+fn capacity_checkpoint_file(home: &std::path::Path, thread: ThreadId) -> PathBuf {
+    home.join("cache/request-capacity-v1")
+        .join(format!("{thread}.json"))
+}
