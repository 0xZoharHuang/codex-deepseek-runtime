+#[test_case::test_case(false, true, false; "before Add with native interruption marker")]
+#[test_case::test_case(true, true, false; "after Add ACK withheld with native interruption marker")]
+#[test_case::test_case(false, false, false; "before Add without native interruption marker")]
+#[test_case::test_case(true, false, false; "after Add ACK withheld without native interruption marker")]
+#[test_case::test_case(false, false, true; "shutdown admission closes before Add finishes")]
+#[test_case::test_case(true, false, true; "shutdown admission closes while append ACK withheld")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn capacity_owned_commit_survives_native_force_abort_and_orders_real_writer(
+    after_append: bool,
+    interrupt_marker: bool,
+    close_admission: bool,
+) -> anyhow::Result<()> {
+    let (home, session, turn, barrier, rollout_path, events) =
+        capacity_commit_writer_fixture(after_append, interrupt_marker).await?;
+    let tool_pair: Vec<ResponseItem> = serde_json::from_value(serde_json::json!([
+        {"type":"custom_tool_call","call_id":"completed-before-owned-commit","name":"fixture","input":"already completed effect"},
+        {"type":"custom_tool_call_output","call_id":"completed-before-owned-commit","output":"effect receipt retained"}
+    ]))?;
+    let mut consumed = vec![user_message("CONSUMED-BEFORE-OWNED-COMMIT")];
+    consumed.extend(tool_pair);
+    session
+        .record_conversation_items(&turn, turn.model_info(), &consumed)
+        .await;
+    session
+        .confirm_capacity_completion(
+            &turn,
+            &turn.model_info().slug,
+            session.capture_capacity_send().await,
+            "ordinary-before-owned-commit",
+        )
+        .await;
+    session
+        .record_conversation_items(
+            &turn,
+            turn.model_info(),
+            &[user_message("CURRENT-UNCONSUMED-OWNED-COMMIT")],
+        )
+        .await;
+    let prefix = session
+        .capacity_prefix(&turn, &turn.model_info().slug)
+        .await
+        .expect("durable confirmed prefix");
+    assert!(!prefix.needs_fresh_summary());
+    let before_window = session.current_window().await;
+    let fenced = session.capacity_checkpoint_for_test().await.unwrap();
+    let disk_before = std::fs::read(capacity_checkpoint_file(home.path(), session.thread_id))?;
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&disk_before)?["checkpoint"],
+        serde_json::to_value(&fenced)?
+    );
+    barrier.armed.store(true, Ordering::Release);
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            CapacityResetCommitTask {
+                prefix: std::sync::Mutex::new(Some(prefix)),
+            },
+        )
+        .await;
+    tokio::time::timeout(StdDuration::from_secs(10), barrier.entered.notified()).await?;
+    let committed_live = session.clone_history().await;
+    let committed_window = session.current_window().await;
+    assert_eq!(committed_window.1, before_window.1 + 1);
+    assert_eq!(
+        barrier.delegated_compactions.load(Ordering::Acquire),
