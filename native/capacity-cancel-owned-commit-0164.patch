+    let mut abort = tokio::spawn(async move {
+        abort_session
+            .abort_all_tasks(TurnAbortReason::Interrupted)
+            .await;
+    });
+    tokio::time::timeout(StdDuration::from_secs(10), actual_task_token.cancelled()).await?;
+    let early_abort = tokio::time::timeout(
+        StdDuration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS + 50),
+        &mut abort,
+    )
+    .await;
+    if interrupt_marker {
