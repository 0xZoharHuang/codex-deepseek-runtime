+#[tokio::test]
+async fn capacity_complete_cancel_before_guard_keeps_real_window_history_and_writer_unchanged()
+-> anyhow::Result<()> {
+    let (_home, session, turn, _barrier, rollout_path, _events) =
+        capacity_commit_writer_fixture(false, true).await?;
+    session
+        .record_conversation_items(
+            &turn,
+            turn.model_info(),
+            &[user_message("COMPLETE-PATH-HISTORY-MUST-STAY")],
+        )
+        .await;
+    session.flush_rollout().await?;
+    let before = session.clone_history().await;
+    let before_window = session.current_window().await;
+    let disk_before = std::fs::read(&rollout_path)?;
+    let token = CancellationToken::new();
+    let state_guard = session.state.lock().await;
+    let commit_session = Arc::clone(&session);
+    let commit_turn = Arc::clone(&turn);
+    let commit_token = token.clone();
+    let mut install = tokio::spawn(async move {
+        commit_session
+            .install_local_compaction(
+                LocalCompactionCommit {
+                    items: vec![ResponseItemEnvelope::new(user_message("MUST-NOT-INSTALL"))],
+                    reference_context_item: commit_turn.to_turn_context_item(),
+                    world_state_baseline: WorldStateSnapshot::default(),
+                    prefix: None,
+                    model_info: commit_turn.model_info().as_ref().clone(),
+                    metadata: LocalCompactionMetadata {
+                        input_goal_ids: Default::default(),
+                        message: "unused summary".to_owned(),
+                        compaction_response_id: Some("never-installed-summary".to_owned()),
+                        compaction_model_hash: None,
+                        reviewer_compaction_hash: None,
+                    },
+                    capacity: None,
+                },
+                commit_turn,
+                commit_token,
+            )
+            .await
+    });
+    assert!(
+        tokio::time::timeout(StdDuration::from_millis(10), &mut install)
+            .await
+            .is_err()
+    );
+    token.cancel();
+    drop(state_guard);
+    assert!(!tokio::time::timeout(StdDuration::from_secs(10), install).await??);
+    assert_eq!(
+        session.clone_history().await.annotated_items(),
+        before.annotated_items()
+    );
+    assert_eq!(session.current_window().await, before_window);
+    session.flush_rollout().await?;
+    assert_eq!(std::fs::read(&rollout_path)?, disk_before);
+    session.drain_code_mode_messages().await;
+    session.live_thread().unwrap().shutdown().await?;
+    Ok(())
+}
