+    fn metadata_fixture_snapshot(
+        directory: &PinnedDirectory,
+    ) -> Result<(Vec<u8>, (u16, u32, Vec<Vec<u8>>))> {
+        let dacl = Dacl::read(directory)?;
+        ensure!(
+            !dacl.owner.is_null() && unsafe { IsValidSid(dacl.owner) } != 0,
+            "fixture owner SID"
+        );
+        let owner = unsafe {
+            std::slice::from_raw_parts(dacl.owner.cast::<u8>(), GetLengthSid(dacl.owner) as usize)
+        }
+        .to_vec();
+        Ok((owner, raw_fixture_descriptor(directory)?))
+    }
+
+    // Only the own-temp fixture uses this pre-authorized handle after installing
+    // its inherited deny. Production writes still reopen and revalidate.
+    fn write_metadata_fixture_on_held_handle(
+        directory: &PinnedDirectory,
+        writable: &OwnedHandle,
+        entries: &[Vec<u8>],
+    ) -> Result<()> {
+        ensure!(
+            directory_id(writable.as_raw_handle() as _)? == directory.identity,
+            "own fixture handle identity"
+        );
+        let old = Dacl::read(directory)?;
+        let bytes = size_of::<ACL>() + entries.iter().map(Vec::len).sum::<usize>();
+        let mut storage = vec![0_u32; bytes.div_ceil(size_of::<u32>())];
+        let acl = storage.as_mut_ptr().cast::<ACL>();
+        let revision = unsafe { (*old.acl).AclRevision } as u32;
+        ensure!(
+            unsafe { InitializeAcl(acl, bytes as u32, revision) } != 0,
+            "initialize own fixture ACL"
+        );
+        for entry in entries {
+            ensure!(
+                unsafe {
+                    AddAce(
+                        acl,
+                        revision,
+                        u32::MAX,
+                        entry.as_ptr().cast(),
+                        entry.len() as u32,
+                    )
+                } != 0,
+                "append own fixture ACE"
+            );
+        }
+        unsafe {
+            crate::acl::set_directory_dacl_without_propagation(
+                writable.as_raw_handle() as _,
+                old.descriptor,
+                acl,
+            )
+        }
+    }
