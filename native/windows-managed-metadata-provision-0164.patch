+        let after = metadata_fixture_snapshot(&directory)?;
+        Dacl::read(&directory)?.write(&directory, &original.1.2)?;
+        assert_eq!(metadata_fixture_snapshot(&directory)?, original);
+        drop(directory);
+        root.close()?;
+        assert_eq!(after, before);
         Ok(())
     }
 
