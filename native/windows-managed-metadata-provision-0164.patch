+    fn current_token_metadata_access(directory: &PinnedDirectory) -> Result<bool> {
+        use std::os::windows::io::FromRawHandle;
+        use windows_sys::Win32::Security::{
+            AccessCheck, DuplicateToken, GENERIC_MAPPING, GROUP_SECURITY_INFORMATION,
+            PRIVILEGE_SET, SecurityImpersonation, TOKEN_DUPLICATE, TOKEN_QUERY,
+        };
+        use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+        let mut raw = std::ptr::null_mut();
+        ensure!(
+            unsafe {
+                OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &mut raw)
+            } != 0,
+            "open own test token: {}",
+            std::io::Error::last_os_error()
+        );
+        let primary = unsafe { OwnedHandle::from_raw_handle(raw) };
+        let mut raw = std::ptr::null_mut();
+        ensure!(
+            unsafe {
+                DuplicateToken(
+                    primary.as_raw_handle() as _,
+                    SecurityImpersonation,
+                    &mut raw,
+                )
+            } != 0,
+            "duplicate own test token for read-only AccessCheck: {}",
+            std::io::Error::last_os_error()
+        );
+        let impersonation = unsafe { OwnedHandle::from_raw_handle(raw) };
+        // AccessCheck requires both owner and primary-group SIDs. Production
+        // mutation planning needs only owner+DACL; read a complete descriptor
+        // locally for this independent Windows access check.
+        let mut dacl = Dacl {
+            descriptor: std::ptr::null_mut(),
+            owner: std::ptr::null_mut(),
+            acl: std::ptr::null_mut(),
+        };
+        let mut group = std::ptr::null_mut();
+        let code = unsafe {
+            get_raw_file_security(
+                directory.handle.as_raw_handle() as _,
+                SE_FILE_OBJECT,
+                OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                &mut dacl.owner,
+                &mut group,
+                &mut dacl.acl,
+                std::ptr::null_mut(),
+                &mut dacl.descriptor,
+            )
+        };
+        ensure!(code == 0, "read AccessCheck descriptor: {code}");
+        ensure!(
+            !dacl.owner.is_null()
+                && !group.is_null()
+                && unsafe { IsValidSid(dacl.owner) } != 0
+                && unsafe { IsValidSid(group) } != 0,
+            "AccessCheck descriptor requires owner and group SIDs"
+        );
+        let mut mapping = GENERIC_MAPPING {
+            GenericRead: fs::FILE_GENERIC_READ,
+            GenericWrite: fs::FILE_GENERIC_WRITE,
+            GenericExecute: fs::FILE_GENERIC_EXECUTE,
+            GenericAll: fs::FILE_ALL_ACCESS,
+        };
+        let mut privileges = vec![0_u32; 256];
+        let mut bytes = (privileges.len() * size_of::<u32>()) as u32;
+        let (mut granted, mut allowed) = (0, 0);
+        ensure!(
+            unsafe {
+                AccessCheck(
+                    dacl.descriptor,
+                    impersonation.as_raw_handle() as _,
+                    METADATA_ACCESS,
+                    &mut mapping,
+                    privileges.as_mut_ptr().cast::<PRIVILEGE_SET>(),
+                    &mut bytes,
+                    &mut granted,
+                    &mut allowed,
+                )
+            } != 0,
+            "native metadata AccessCheck: {}",
+            std::io::Error::last_os_error()
+        );
+        Ok(allowed != 0 && granted & METADATA_ACCESS == METADATA_ACCESS)
+    }
