+#[test]
+fn legacy_marker_modes_preserve_reopen_lifetime() -> Result<()> {
+    use std::os::windows::fs::OpenOptionsExt;
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_SHARE_DELETE, FILE_SHARE_READ, FILE_SHARE_WRITE,
+    };
+    for mode in [
+        super::SetupMode::Full,
+        super::SetupMode::InteractiveProvision,
+    ] {
+        let root = tempfile::tempdir()?;
+        std::fs::create_dir_all(crate::sandbox_dir(root.path()))?;
+        let user = crate::runtime_ownership::current_setup_user()?;
+        let prepared = super::prepare_setup_marker(root.path(), &user, mode)?;
+        assert!(matches!(prepared, super::PreparedSetupMarker::Reopen));
+        let writer = std::fs::OpenOptions::new()
+            .write(true)
+            .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE)
+            .open(crate::setup::setup_marker_path(root.path()))?;
+        drop(writer);
+        root.close()?;
+    }
+    Ok(())
+}
