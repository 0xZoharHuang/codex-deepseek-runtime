+fn marker_snapshot(file: &std::fs::File) -> Result<(Vec<u8>, u64, [u8; 16])> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::Security::{
+        DACL_SECURITY_INFORMATION, GROUP_SECURITY_INFORMATION, GetKernelObjectSecurity,
+        OWNER_SECURITY_INFORMATION,
+    };
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_ID_INFO, FileIdInfo, GetFileInformationByHandleEx,
+    };
+    let flags = OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+    let mut needed = 0;
+    unsafe {
+        GetKernelObjectSecurity(
+            file.as_raw_handle() as _,
+            flags,
+            std::ptr::null_mut(),
+            0,
+            &mut needed,
+        );
+    }
+    anyhow::ensure!((20..=1_048_576).contains(&needed), "marker descriptor size");
+    let mut storage = vec![0_u32; (needed as usize).div_ceil(size_of::<u32>())];
+    anyhow::ensure!(
+        unsafe {
+            GetKernelObjectSecurity(
+                file.as_raw_handle() as _,
+                flags,
+                storage.as_mut_ptr().cast(),
+                (storage.len() * size_of::<u32>()) as u32,
+                &mut needed,
+            )
+        } != 0,
+        "read marker descriptor: {}",
+        std::io::Error::last_os_error()
+    );
+    let bytes =
+        unsafe { std::slice::from_raw_parts(storage.as_ptr().cast::<u8>(), needed as usize) }
+            .to_vec();
+    let mut id = FILE_ID_INFO::default();
+    anyhow::ensure!(
+        unsafe {
+            GetFileInformationByHandleEx(
+                file.as_raw_handle() as _,
+                FileIdInfo,
+                (&mut id as *mut FILE_ID_INFO).cast(),
+                size_of::<FILE_ID_INFO>() as u32,
+            )
+        } != 0,
+        "read marker file identity: {}",
+        std::io::Error::last_os_error()
+    );
+    Ok((bytes, id.VolumeSerialNumber, id.FileId.Identifier))
+}
