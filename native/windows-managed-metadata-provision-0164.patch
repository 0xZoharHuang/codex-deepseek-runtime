+#[test]
+fn managed_marker_is_read_shared_write_delete_exclusive_until_commit() -> Result<()> {
+    use std::io::{Read, Seek, SeekFrom};
+    use std::os::windows::fs::OpenOptionsExt;
+    use windows_sys::Win32::Foundation::{ERROR_ACCESS_DENIED, ERROR_SHARING_VIOLATION};
+    use windows_sys::Win32::Storage::FileSystem::{
+        FILE_SHARE_DELETE, FILE_SHARE_READ, FILE_SHARE_WRITE, MOVEFILE_REPLACE_EXISTING,
+        MoveFileExW,
+    };
+    let root = tempfile::tempdir()?;
+    let namespace = crate::namespace::SandboxNamespace::current(root.path())?;
+    namespace.reserve_owner()?;
+    std::fs::create_dir_all(crate::sandbox_dir(root.path()))?;
+    let real_user = crate::runtime_ownership::current_setup_user()?;
+    let prepared =
+        super::prepare_setup_marker(root.path(), &real_user, super::SetupMode::ProvisionOnly)?;
+    assert!(matches!(&prepared, super::PreparedSetupMarker::Retained(_)));
+    let marker = crate::setup::setup_marker_path(root.path());
+    let mut reader = std::fs::File::open(&marker)?;
+    let before = marker_snapshot(&reader)?;
+    let mut empty = Vec::new();
+    reader.read_to_end(&mut empty)?;
+    assert!(empty.is_empty());
+    namespace.validate_existing_state()?;
+    assert!(!crate::identity::sandbox_setup_is_complete(root.path()));
+    let write_error = std::fs::OpenOptions::new()
+        .write(true)
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE)
+        .open(&marker)
+        .err()
+        .expect("retained marker must reject another writer");
+    assert_eq!(
+        write_error.raw_os_error(),
+        Some(ERROR_SHARING_VIOLATION as i32)
+    );
+    let delete_error =
+        std::fs::remove_file(&marker).expect_err("retained marker must reject deletion");
+    assert_eq!(
+        delete_error.raw_os_error(),
+        Some(ERROR_SHARING_VIOLATION as i32)
+    );
+    let rename_error = std::fs::rename(&marker, marker.with_extension("renamed"))
+        .expect_err("retained marker must reject renaming");
+    assert_eq!(
+        rename_error.raw_os_error(),
+        Some(ERROR_SHARING_VIOLATION as i32)
+    );
+    let replacement = marker.with_extension("replacement");
+    std::fs::write(&replacement, b"not a marker")?;
+    let replaced = unsafe {
+        MoveFileExW(
+            to_wide(replacement.as_os_str()).as_ptr(),
+            to_wide(marker.as_os_str()).as_ptr(),
+            MOVEFILE_REPLACE_EXISTING,
+        )
+    };
+    let replacement_error = std::io::Error::last_os_error();
+    assert_eq!(replaced, 0);
+    // MoveFileExW can surface ACCESS_DENIED when replacing a target whose
+    // retained handle excludes deletion. The same operation must succeed below
+    // after commit and handle release, so an unrelated ACL failure cannot pass.
+    assert!(matches!(
+        replacement_error.raw_os_error(),
+        Some(code) if code == ERROR_SHARING_VIOLATION as i32 || code == ERROR_ACCESS_DENIED as i32
+    ));
+    assert_eq!(std::fs::read(&replacement)?, b"not a marker");
+    assert!(std::fs::read(&marker)?.is_empty());
+    assert_eq!(marker_snapshot(&reader)?, before);
+    super::commit_setup_marker(
+        prepared,
+        root.path(),
+        &namespace.key.offline(),
+        &namespace.key.online(),
+        &[8118],
+        true,
+        &namespace.key.id(),
+    )?;
+    reader.seek(SeekFrom::Start(0))?;
+    let mut committed = Vec::new();
+    reader.read_to_end(&mut committed)?;
+    let parsed: crate::setup::SetupMarker = serde_json::from_slice(&committed)?;
+    assert_eq!(
+        parsed.namespace.as_deref(),
+        Some(namespace.key.id().as_str())
+    );
+    assert_eq!(parsed.offline_username, namespace.key.offline());
+    assert_eq!(parsed.online_username, namespace.key.online());
+    assert!(parsed.version_matches());
+    assert_eq!(parsed.proxy_ports, [8118]);
+    assert!(parsed.allow_local_binding);
+    namespace.validate_existing_state()?;
+    assert_eq!(marker_snapshot(&reader)?, before);
+    assert_eq!(marker_snapshot(&std::fs::File::open(&marker)?)?, before);
+    // A committed marker alone is not complete account provisioning. No fake SAM state is made.
+    assert!(!crate::identity::sandbox_setup_is_complete(root.path()));
+    drop(reader);
+    let replaced_after_release = unsafe {
+        MoveFileExW(
+            to_wide(replacement.as_os_str()).as_ptr(),
+            to_wide(marker.as_os_str()).as_ptr(),
+            MOVEFILE_REPLACE_EXISTING,
