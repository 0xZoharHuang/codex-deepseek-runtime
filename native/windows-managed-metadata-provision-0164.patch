+    #[test]
+    fn unknown_inherited_metadata_deny_is_not_bypassed_in_native_dacl() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let home = root.path().join("home");
+        std::fs::create_dir(&home)?;
+        let namespace = SandboxNamespace::current(&home)?;
+        namespace.reserve_owner()?;
+        let directory = PinnedDirectory::open(&home)?;
+        let grant_directory = PinnedDirectory::open(&home)?;
+        let writable = directory.write_handle()?;
+        let original = metadata_fixture_snapshot(&directory)?;
+        let owner = crate::token::LocalSid::from_string(&namespace.owner_sid)?;
+        let owner_sid = unsafe {
+            std::slice::from_raw_parts(
+                owner.as_ptr().cast::<u8>(),
+                GetLengthSid(owner.as_ptr()) as usize,
+            )
+        }
+        .to_vec();
+        // Synthetic grant subject is Everyone only inside this own-temp private mechanism.
+        // The actual current-user SID is deliberately not among its classified principals.
+        // AccessCheck uses our own unchanged token, not a simulated ACE evaluator.
+        let subject = crate::resolve_sid("Everyone")?;
+        let mut owner_access = metadata_ace(&owner_sid)?;
+        owner_access[4..8]
+            .copy_from_slice(&(fs::READ_CONTROL | fs::WRITE_DAC | fs::FILE_TRAVERSE).to_le_bytes());
+        let mut legacy = metadata_ace(&subject)?;
+        legacy[4..8].copy_from_slice(&fs::FILE_READ_ATTRIBUTES.to_le_bytes());
+        let mut deny = metadata_ace(&owner_sid)?;
+        deny[0] = 1;
+        deny[1] = INHERITED_ACE as u8;
+        deny[4..8].copy_from_slice(&fs::SYNCHRONIZE.to_le_bytes());
+        write_metadata_fixture_on_held_handle(
+            &directory,
+            &writable,
+            &[owner_access, legacy, deny],
+        )?;
+        let before = metadata_fixture_snapshot(&directory)?;
+        assert!(!current_token_metadata_access(&directory)?);
+        // Prove the real Windows ACE-order hazard independently of grant planning.
+        let mut unsafe_expansion = before.1.2.clone();
+        let index = unsafe_expansion
+            .iter()
+            .position(|entry| entry[1] & INHERITED_ACE as u8 != 0)
+            .unwrap();
+        unsafe_expansion.insert(index, metadata_ace(&subject)?);
+        write_metadata_fixture_on_held_handle(&directory, &writable, &unsafe_expansion)?;
+        assert!(current_token_metadata_access(&directory)?);
+        write_metadata_fixture_on_held_handle(&directory, &writable, &before.1.2)?;
+        assert_eq!(metadata_fixture_snapshot(&directory)?, before);
+        assert!(!current_token_metadata_access(&directory)?);
+        let result = grant_pinned(&namespace, &subject, &[grant_directory], &[]);
+        let after = metadata_fixture_snapshot(&directory)?;
+        let after_access = current_token_metadata_access(&directory)?;
+        // Preserve the deny/no-mutation witness, then restore the own fixture
+        // through the handle retained before the deny was installed.
+        write_metadata_fixture_on_held_handle(&directory, &writable, &original.1.2)?;
+        assert_eq!(metadata_fixture_snapshot(&directory)?, original);
+        drop(writable);
+        drop(directory);
+        root.close()?;
+        println!(
+            "unknown inherited metadata denial: result={result:?}, before_access=false, after_access={after_access}"
+        );
+        assert!(result.as_ref().err().is_some_and(|error| {
+            error
+                .to_string()
+                .contains("unclassified ancestor metadata denial")
+        }));
+        assert_eq!(after, before);
+        assert!(!after_access);
+        assert!(exact_index(&after.1.2, &metadata_ace(&subject)?)?.is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn unclassified_metadata_denial_only_blocks_expansion_and_keeps_known_denials() -> Result<()> {
+        let root = tempfile::tempdir()?;
+        let directory = PinnedDirectory::open(root.path())?;
+        let dacl = Dacl::read(&directory)?;
+        let group = sid(1101);
+        let mut legacy = metadata_ace(&group)?;
+        legacy[4..8].copy_from_slice(&fs::FILE_READ_ATTRIBUTES.to_le_bytes());
+        for trustee in [
+            crate::winutil::sid_bytes_from_string("S-1-5-4")?,
+            crate::winutil::sid_bytes_from_string("S-1-2-0")?,
+            sid(1109),
+        ] {
+            for flags in [0, INHERITED_ACE as u8] {
+                for mask in [
+                    fs::FILE_READ_ATTRIBUTES,
+                    fs::SYNCHRONIZE,
+                    0x4000_0000,
+                    0x8000_0000,
+                    0x2000_0000,
+                    0x1000_0000,
+                ] {
+                    let mut deny = metadata_ace(&trustee)?;
+                    deny[0] = 1;
+                    deny[1] = flags;
+                    deny[4..8].copy_from_slice(&mask.to_le_bytes());
+                    assert!(
+                        already_readable(&dacl, &[legacy.clone(), deny.clone()], &[group.clone()])
+                            .is_err()
+                    );
+                    // Complete classified rights cause no new write and no newly introduced failure.
+                    assert!(already_readable(
+                        &dacl,
+                        &[metadata_ace(&group)?, deny.clone()],
+                        &[group.clone()]
+                    )?);
+                    let mut known = metadata_ace(&group)?;
+                    known[0] = 1;
+                    assert!(
+                        already_readable(
+                            &dacl,
+                            &[metadata_ace(&group)?, deny.clone(), known],
+                            &[group.clone()]
+                        )
+                        .is_err()
+                    );
+                    deny[1] |= INHERIT_ONLY_ACE as u8;
+                    assert!(!already_readable(
+                        &dacl,
+                        &[legacy.clone(), deny],
+                        &[group.clone()]
+                    )?);
+                }
+            }
+            let mut unrelated = metadata_ace(&trustee)?;
+            unrelated[0] = 1;
+            unrelated[1] = INHERITED_ACE as u8;
+            unrelated[4..8].copy_from_slice(&fs::FILE_WRITE_DATA.to_le_bytes());
+            assert!(!already_readable(
+                &dacl,
+                &[legacy.clone(), unrelated],
+                &[group.clone()]
+            )?);
+        }
+        Ok(())
+    }
