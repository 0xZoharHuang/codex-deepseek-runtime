+            let result = SetFileSecurityW(
+                to_wide(path).as_ptr(),
+                DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                descriptor,
+            );
+            LocalFree(descriptor as HLOCAL);
+            assert_ne!(result, 0, "set protected fixture DACL");
+        }
