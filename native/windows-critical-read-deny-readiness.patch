+// Full provisioning serves the dedicated offline/online accounts. These are
+// normal read principals, not the setup administrator or arbitrary capability SIDs.
+fn critical_read_acl_state(
+    root: &Path,
+    builtin_psids: &[*mut c_void],
+    sandbox_group_psid: *mut c_void,
+    target_user_psids: &[*mut c_void],
+    read_mask: u32,
+) -> Result<(bool, bool)> {
+    let (denied, builtin_has, group_has) = unsafe {
+        let (dacl, descriptor) = crate::acl::fetch_dacl_handle(root)?;
+        let denied = builtin_psids
+            .iter()
+            .chain(std::iter::once(&sandbox_group_psid))
+            .chain(target_user_psids.iter())
+            .any(|sid| crate::acl::dacl_denies_mask_for_sid(dacl, *sid, read_mask));
+        let builtin_has = crate::acl::dacl_mask_allows(dacl, builtin_psids, read_mask, true);
+        let group_has =
+            crate::acl::dacl_mask_allows(dacl, &[sandbox_group_psid], read_mask, true);
+        LocalFree(descriptor as HLOCAL);
+        (denied, builtin_has, group_has)
+    };
+    anyhow::ensure!(
+        !denied,
+        "critical read root explicitly denies a target read principal: {}",
+        root.display()
+    );
+    Ok((builtin_has, group_has))
+}
