+/// Check an effective deny for one known subject and an explicit access mask.
+///
+/// # Safety
+/// The ACL and SID pointers must remain valid for the duration of this call.
+pub(crate) unsafe fn dacl_denies_mask_for_sid(
+    p_dacl: *mut ACL,
+    psid: *mut c_void,
+    desired_mask: u32,
+) -> bool {
+    dacl_has_deny_mask(p_dacl, DenyAceScope::EffectiveForSid(psid), desired_mask)
+}
