+    // Test-only ACL capture uses READ_CONTROL without a synchronous file open.
+    // A generic-read DENY may make the production open fail closed before inspection.
+    fn critical_test_acl_entries(path: &Path) -> Vec<Vec<u8>> {
+        use windows_sys::Win32::Security::Authorization::GetNamedSecurityInfoW;
+        use windows_sys::Win32::Security::DACL_SECURITY_INFORMATION;
+        unsafe {
+            let mut acl = std::ptr::null_mut();
+            let mut descriptor = std::ptr::null_mut();
+            let code = GetNamedSecurityInfoW(
+                to_wide(path).as_ptr(),
+                1, // SE_FILE_OBJECT
+                DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                &mut acl,
+                std::ptr::null_mut(),
+                &mut descriptor,
+            );
+            assert_eq!(code, 0, "capture protected fixture DACL with READ_CONTROL");
+            assert!(!acl.is_null());
+            let entries = (0..(*acl).AceCount as u32)
+                .map(|index| {
+                    let mut entry = std::ptr::null_mut();
+                    assert_ne!(GetAce(acl, index, &mut entry), 0);
+                    let size = (*(entry as *const ACE_HEADER)).AceSize as usize;
+                    std::slice::from_raw_parts(entry.cast::<u8>(), size).to_vec()
+                })
+                .collect();
+            LocalFree(descriptor as HLOCAL);
+            entries
+        }
+    }
+
+    #[test]
+    fn critical_read_rejects_applicable_deny_without_changing_acl() {
+        let namespace_text = "S-1-5-21-915763429-1123581321-271828182-4251";
+        let offline_text = "S-1-5-21-915763429-1123581321-271828182-4252";
+        let online_text = "S-1-5-21-915763429-1123581321-271828182-4253";
+        let namespace = LocalSid::from_string(namespace_text).unwrap();
+        let offline = LocalSid::from_string(offline_text).unwrap();
+        let online = LocalSid::from_string(online_text).unwrap();
+        for subject in ["BU", "AU", "WD", namespace_text, offline_text, online_text] {
+            for denied in ["0x1", "0x20", "GR"] {
+                let temp = tempfile::tempdir().unwrap();
+                let leaf = temp.path().join("denied-readable.txt");
+                fs::write(&leaf, "synthetic").unwrap();
+                set_critical_test_dacl(
+                    &leaf,
+                    &format!("(D;;{denied};;;{subject})(A;;GRGX;;;WD)"),
+                );
+                let before = critical_test_acl_entries(&leaf);
+                let error = super::apply_critical_read_acls(
+                    &[leaf.clone()],
+                    namespace.as_ptr(),
+                    &[offline.as_ptr(), online.as_ptr()],
+                    &mut Vec::new(),
+                )
+                .expect_err("applicable read/execute deny must prevent readiness");
+                if denied == "GR" && matches!(subject, "BU" | "AU" | "WD") {
+                    assert!(error.chain().any(|cause| cause
+                        .downcast_ref::<std::io::Error>()
+                        .is_some_and(|error| error.kind() == std::io::ErrorKind::PermissionDenied)));
+                    eprintln!("critical deny {subject} {denied}: native access denied");
+                } else {
+                    assert!(error.chain().any(|cause| cause
+                        .to_string()
+                        .contains("explicitly denies a target read principal")));
+                    eprintln!("critical deny {subject} {denied}: explicit principal precheck");
+                }
+                assert_eq!(critical_test_acl_entries(&leaf), before, "never remove or override an existing deny");
+            }
+        }
+    }
+
+    #[test]
+    fn critical_read_unrelated_write_and_inherit_only_denies_do_not_block_rx() {
+        let namespace_text = "S-1-5-21-915763429-1123581321-271828182-4254";
+        let unrelated = "S-1-5-21-915763429-1123581321-271828182-4255";
+        let namespace = LocalSid::from_string(namespace_text).unwrap();
+        for deny in [
+            format!("(D;;GRGX;;;{unrelated})"),
+            "(D;;GRGX;;;S-1-15-3-1024-1-2-3-4-5-6-7-8)".to_string(),
+            "(D;;0x2;;;WD)".to_string(),
+            "(D;OIIO;GRGX;;;WD)".to_string(),
+        ] {
+            let temp = tempfile::tempdir().unwrap();
+            let leaf = temp.path().join("readable.txt");
+            fs::write(&leaf, "synthetic").unwrap();
+            set_critical_test_dacl(&leaf, &format!("{deny}(A;;GRGX;;;WD)"));
+            let before = critical_test_acl_entries(&leaf);
+            super::apply_critical_read_acls(
+                &[leaf.clone()], namespace.as_ptr(), &[], &mut Vec::new(),
+            )
+            .expect("unrelated, write-data-only and inherit-only denies do not deny this RX");
+            assert_eq!(critical_test_acl_entries(&leaf), before);
+            assert!(!path_mask_allows(&leaf, &[namespace.as_ptr()], FILE_GENERIC_READ, false).unwrap());
+        }
+    }
