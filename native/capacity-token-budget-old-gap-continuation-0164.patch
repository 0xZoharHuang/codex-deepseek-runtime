+        .or_cancel(&cancellation_token)
+        .await
+        .unwrap_or(PreCompactHookOutcome::Stopped)
+    {
+        PreCompactHookOutcome::Continue => prefix.mark_pre_compact_hook_ran(),
+        PreCompactHookOutcome::Stopped => return Err(CodexErr::TurnAborted),
+    }
+    match sess
+        .prepare_capacity_reset_for_recovery(
+            &step_context,
+            Arc::clone(&world_state),
+            prefix,
+            &cancellation_token,
+        )
+        .await
+    {
+        crate::session::CapacityResetPreparation::Ready { prefix, completion } => {
+            run_inline_capacity_reset_task(
+                sess,
+                step_context,
+                world_state,
+                prefix,
+                rejection,
+                cancellation_token.clone(),
+            )
+            .await?;
+            if cancellation_token.is_cancelled() {
+                return Err(CodexErr::TurnAborted);
+            }
+            let continuation = match completion {
+                Some(receiver) => receiver.await.ok(),
+                None => None,
+            };
+            Ok(CapacityResetOutcome::Reset(continuation))
+        }
