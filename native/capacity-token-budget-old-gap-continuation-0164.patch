+    assert!(prefix.needs_fresh_summary());
+    let before = session.clone_history().await;
+    let suffix = before.annotated_items()[prefix.prefix.len..].to_vec();
+    let before_window = session.current_window().await;
+    let before_cp = session.capacity_checkpoint_for_test().await.unwrap();
+    let token = CancellationToken::new();
