+            } else {
+                Err(CodexErr::UnexpectedStatus(rejection))
+            }
+        }
+        crate::session::CapacityResetPreparation::Invalid => {
+            if cancellation_token.is_cancelled() {
+                Err(CodexErr::TurnAborted)
+            } else {
+                Err(CodexErr::UnexpectedStatus(rejection))
+            }
+        }
+    }
