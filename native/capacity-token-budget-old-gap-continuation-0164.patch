+                drop(state);
+                if number <= 2 {
+                    let (notify, barrier) = if number == 1 { (&n1, &b1) } else { (&n2, &b2) };
+                    notify.notify_one();
+                    let (released, timed) = barrier
+                        .1
+                        .wait_timeout_while(
+                            barrier.0.lock().unwrap(),
+                            Duration::from_secs(10),
+                            |v| !*v,
+                        )
+                        .unwrap();
+                    assert!(
+                        *released && !timed.timed_out(),
+                        "actual ordinary request barrier"
+                    );
+                }
+            } else {
+                drop(state);
+            }
+            eprintln!(
+                "NATIVE_RESET_OLD_GAP_REQUEST compact={compact} images={} bytes={}",
+                images.len(),
+                decoded.len()
+            );
+            if decoded.len() > 262144 || images.len() > 6 {
+                return ResponseTemplate::new(413).set_body_json(
+                    json!({"error":{"message":"fixed byte and six-image capacity"}}),
+                );
+            }
+            let mut state = w.lock().unwrap();
+            let (text, response) = if compact {
+                assert!(
+                    body.get("tools")
+                        .is_none_or(|v| v.as_array().is_some_and(Vec::is_empty))
+                );
+                if let Some(previous) = &state.last_summary {
+                    assert!(
+                        body["input"]
+                            .as_array()
+                            .unwrap()
+                            .iter()
+                            .any(|item| item["content"].as_array().is_some_and(|parts| parts
+                                .iter()
+                                .any(|p| p["text"].as_str() == Some(previous.as_str())))),
+                        "fresh compactor must carry the exact prior successful summary"
+                    );
+                }
+                for image in images {
+                    state.accepted_images.push(image);
+                }
+                state.summaries += 1;
+                let text = format!("OLD_GAP_FRESH_{}", state.summaries);
+                state.last_summary = Some(format!("{}\n{text}", crate::compact::SUMMARY_PREFIX));
+                (text, format!("old-gap-summary-{}", state.summaries))
+            } else {
+                ("FINAL_NATIVE_DONE".into(), "ordinary-after-gap".into())
+            };
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(responses::sse(vec![
+                    responses::ev_assistant_message("native-result", &text),
+                    responses::ev_completed(&response),
+                ]))
+        })
+        .mount(&server)
+        .await;
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            vec![TurnInput::UserInput {
+                metadata: Default::default(),
+                content: vec![codex_protocol::user_input::UserInput::Text {
+                    text: "CURRENT_UNCONSUMED_CANARY".into(),
+                    text_elements: Vec::new(),
+                }],
+                client_id: None,
+            }],
+            crate::tasks::RegularTask::new(),
+        )
+        .await;
+    request_or_end(&first, &events).await?;
+    let before = session.clone_history().await;
+    let original_gap_end=before.annotated_items().iter().position(|e|
+        matches!(&e.item,ResponseItem::CustomToolCallOutput{call_id,..} if call_id=="old-gap-pair")).unwrap()+1;
+    let current = before.annotated_items()[original_gap_end..].to_vec();
+    assert!(!current.is_empty());
+    release(&first_release);
+    request_or_end(&second, &events).await?;
+    let after_reset = session.clone_history().await;
+    assert_eq!(
+        &after_reset.annotated_items()[after_reset.annotated_items().len() - current.len()..],
+        current.as_slice()
+    );
+    assert_eq!(
+        session.current_window().await.1,
+        initial_window.1 + 1,
+        "native reset must precede second ordinary 413"
+    );
+    assert_eq!(compacted_count(&session, &rollout).await?, 1);
+    let reset_cp = serde_json::to_value(session.capacity_checkpoint_for_test().await.unwrap())?;
+    assert_eq!(reset_cp["completed_epoch"], initial_cp["completed_epoch"]);
+    assert_eq!(reset_cp["response_id"], initial_cp["response_id"]);
+    assert_eq!(reset_cp["recovery_turn_id"], turn.sub_id);
+    assert_eq!(counts.pre.load(Ordering::SeqCst), 1);
+    assert_eq!(counts.post.load(Ordering::SeqCst), 1);
+    release(&second_release);
+    loop {
+        let event = events.recv().await?;
+        let value = serde_json::to_value(&event.msg)?;
+        assert_ne!(
+            value.get("call_id").and_then(Value::as_str),
+            Some("old-gap-pair"),
+            "historical tool effects cannot execute again"
+        );
+        match event.msg {
+            EventMsg::TurnComplete(_) => {
+                break;
+            }
+            EventMsg::TurnAborted(_) => anyhow::bail!("native old-gap turn aborted"),
+            _ => {}
+        }
+    }
+    let after = session.clone_history().await;
+    assert!(contains_text(&after, "FINAL_NATIVE_DONE"));
+    assert!(contains_text(&after, "CURRENT_UNCONSUMED_CANARY"));
+    assert_eq!(
+        compacted_count(&session, &rollout).await?,
+        2,
+        "one native reset and one whole fresh old-gap commit"
+    );
+    assert_eq!(session.current_window().await.1, initial_window.1 + 2);
+    assert_eq!(
+        counts.pre.load(Ordering::SeqCst),
+        2,
+        "later fresh is a new lifecycle"
+    );
+    assert_eq!(counts.post.load(Ordering::SeqCst), 2);
+    assert!(contains_text(&after, "POST_NATIVE_PREHOOK_CONTEXT_2"));
+    let state = wire.lock().unwrap();
+    assert_eq!(
+        state.ordinary, 3,
+        "real original ordinary, post-reset 413, post-fresh success"
+    );
+    assert_eq!(
+        state.accepted_images,
+        IMAGES.iter().map(|v| v.to_string()).collect::<Vec<_>>(),
+        "all exact old-gap images read once before final commit"
+    );
+    assert!(state.summaries >= 2);
+    drop(state);
+    let cp = serde_json::to_value(session.capacity_checkpoint_for_test().await.unwrap())?;
+    assert!(
+        cp["completed_epoch"].as_u64().unwrap() > initial_cp["completed_epoch"].as_u64().unwrap()
+    );
+    assert!(cp["recovery_turn_id"].is_null());
+    assert_eq!(cp["response_id"], "ordinary-after-gap");
+    finish(&session).await
+}
