+    assert!(
+        server.received_requests().await.unwrap().is_empty(),
+        "local reset/STOP sends no model request"
+    );
+    if stop {
+        assert!(
+            matches!(result,Err(ref e) if matches!(e.details(),codex_protocol::error::CodexErrorDetails::TurnAborted))
+        );
+        assert_eq!(
+            session.clone_history().await.annotated_items(),
+            before.annotated_items()
+        );
+        assert_eq!(session.current_window().await, before_window);
+        assert_eq!(
+            serde_json::to_value(session.capacity_checkpoint_for_test().await.unwrap())?,
+            serde_json::to_value(before_cp)?
+        );
+        assert_eq!(counts.post.load(Ordering::SeqCst), 0);
+        assert_eq!(compacted_count(&session, &rollout).await?, 0);
+    } else {
