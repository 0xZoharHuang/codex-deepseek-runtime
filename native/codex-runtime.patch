+//! Exercise the production native client in a child with isolated bridge settings.
+#[cfg(unix)]
+#[test]
+fn native_bridge_preserves_policy_authorization_revocation_and_proxy_context() {
+    use codex_http_client::{
+        ClientRouteClass, DestinationPolicy, HttpClientFactory, NetworkPolicyController,
+        OutboundProxyPolicy,
+    };
+    use std::{
+        io::{Read, Write},
+        net::TcpListener,
+        process::Command,
+        time::Duration,
+    };
+    if let Ok(target) = std::env::var("CODEX_DEEPSEEK_HTTP_POLICY_PROBE") {
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        runtime.block_on(async {
+            let controller = NetworkPolicyController::default();
+            let policy = controller.policy();
+            let revision = policy.revision();
+            let restricted = |host: &str| DestinationPolicy::Restricted {
+                allowed_hosts: [host.to_owned()].into(),
+            };
+            assert!(controller.publish(revision, restricted("example.invalid")));
+            let factory = HttpClientFactory::new(OutboundProxyPolicy::RespectSystemProxy)
+                .with_network_policy(policy);
+            let client = factory
+                .build_client(&target, ClientRouteClass::Api)
+                .unwrap();
+            assert!(
+                client.post(&target).send().await.is_err(),
+                "Denied destinations must fail before IPC"
+            );
+            assert!(controller.publish(revision, restricted("openrouter.ai")));
+            let mut response = client.post(&target).send().await.unwrap();
+            assert_eq!(response.status(), http::StatusCode::OK);
+            assert_eq!(response.chunk().await.unwrap().unwrap().as_ref(), b"part");
+            assert!(controller.publish(revision, restricted("example.invalid")));
+            assert!(
+                response.chunk().await.is_err(),
+                "A logical-destination permit must revoke an active IPC response"
+            );
+        });
+        return;
+    }
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let server = std::thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        stream
+            .set_read_timeout(Some(Duration::from_secs(10)))
+            .unwrap();
+        let mut request = Vec::new();
+        while !request.ends_with(b"\r\n\r\n") {
+            let mut byte = [0];
+            assert_eq!(stream.read(&mut byte).unwrap(), 1);
+            request.push(byte[0]);
+        }
+        let text = String::from_utf8(request).unwrap().to_ascii_lowercase();
+        assert!(text.contains("x-codex-deepseek-network-policy: system\r\n"));
+        stream
+            .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 10000\r\nConnection: close\r\n\r\npart")
+            .unwrap();
+        stream.flush().unwrap();
+        let mut tail = Vec::new();
+        let _ = stream.read_to_end(&mut tail);
+    });
+    let output = Command::new(std::env::current_exe().unwrap())
+        .args([
+            "--exact",
+            "native_bridge_preserves_policy_authorization_revocation_and_proxy_context",
+            "--nocapture",
+        ])
+        .env(
+            "CODEX_DEEPSEEK_HTTP_POLICY_PROBE",
+            format!("http://127.0.0.1:{port}/v1/responses"),
+        )
+        .env(
+            "CODEX_DEEPSEEK_POLICY_HOME",
+            "/tmp/codex-deepseek-policy-probe",
+        )
+        .env("CODEX_DEEPSEEK_BRIDGE_PORT", port.to_string())
+        .env("HTTP_PROXY", "http://127.0.0.1:1")
+        .env("HTTPS_PROXY", "http://127.0.0.1:1")
+        .env("NO_PROXY", "")
+        .env("no_proxy", "")
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    server.join().unwrap();
+}
+
+#[cfg(unix)]
+#[test]
+#[ignore = "requires the isolated Python gateway/upstream fixture"]
+fn native_policy_revocation_propagates_to_upstream() {
+    use codex_http_client::{
+        ClientRouteClass, DestinationPolicy, HttpClientFactory, NetworkPolicyController,
+        OutboundProxyPolicy,
+    };
+    let url = std::env::var("CODEX_DEEPSEEK_E2E_GATEWAY").expect("isolated fixture endpoint");
+    let token = std::env::var("CODEX_DEEPSEEK_E2E_TOKEN").expect("isolated fixture token");
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    runtime.block_on(async {
+        let controller=NetworkPolicyController::default();let policy=controller.policy();let revision=policy.revision();
+        assert!(controller.publish(revision,DestinationPolicy::Restricted{allowed_hosts:["openrouter.ai".to_owned()].into()}));
+        let factory=HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault).with_network_policy(policy);
+        let client=factory.build_client(&url,ClientRouteClass::Api).unwrap();
+        let mut response=client.post(&url).bearer_auth(token).json(&serde_json::json!({"model":"deepseek/deepseek-v4.1-flash-1017","input":"isolated native policy cancellation fixture","stream":true,"store":false})).send().await.unwrap();
+        assert_eq!(response.status(),http::StatusCode::OK);
+        assert!(response.chunk().await.unwrap().is_some());
+        assert!(controller.publish(revision,DestinationPolicy::Restricted{allowed_hosts:["denied.invalid".to_owned()].into()}));
+        assert!(response.chunk().await.is_err());
+        drop(response);
+    });
+}
