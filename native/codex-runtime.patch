+//! Authenticated, profile-owned native HTTP transport. It performs no tool execution or retries.
+use axum::{
+    Json, Router,
+    body::Body,
+    extract::{DefaultBodyLimit, State},
+    response::{IntoResponse, Response},
+    routing::post,
+};
+use codex_http_client::{
+    ClientRouteClass, HttpClient, HttpClientFactory, OutboundProxyPolicy, RouteAwareClientPool,
+};
+use http::{HeaderMap, StatusCode};
+use reqwest::Url;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use subtle::ConstantTimeEq;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+#[derive(Deserialize)]
+struct Startup {
+    token: String,
+    upstream: String,
+    parent_pid: u32,
+}
+#[derive(Deserialize)]
+struct Request {
+    api_key: String,
+    url: String,
+    method: String,
+    payload: Option<Value>,
+    policy: String,
+}
+struct Shared {
+    config: Startup,
+    origin: Url,
+    clients: Mutex<HashMap<String, HttpClient>>,
+}
+
+fn failure(status: StatusCode, message: &str) -> Response {
+    (
+        status,
+        Json(json!({"error":{"type":"native_transport","message":message}})),
+    )
+        .into_response()
+}
+fn authorized(headers: &HeaderMap, token: &str) -> bool {
+    if headers.contains_key("origin") {
+        return false;
+    }
+    let expected = format!("Bearer {token}");
+    let actual = headers
+        .get("authorization")
+        .map(|value| value.as_bytes())
+        .unwrap_or_default();
+    bool::from(actual.ct_eq(expected.as_bytes()))
+}
+async fn gate(
+    State(shared): State<Arc<Shared>>,
+    request: axum::extract::Request,
+    next: axum::middleware::Next,
+) -> Response {
+    if !authorized(request.headers(), &shared.config.token) {
+        return failure(StatusCode::UNAUTHORIZED, "Unauthorized");
+    }
+    next.run(request).await
+}
+async fn forward(
+    State(shared): State<Arc<Shared>>,
+    headers: HeaderMap,
+    Json(request): Json<Request>,
+) -> Response {
+    if !authorized(&headers, &shared.config.token) {
+        return failure(StatusCode::UNAUTHORIZED, "Unauthorized");
+    }
+    let Ok(url) = Url::parse(&request.url) else {
+        return failure(StatusCode::BAD_REQUEST, "Invalid upstream URL");
+    };
+    if url.origin() != shared.origin.origin()
+        || !url.username().is_empty()
+        || url.password().is_some()
+    {
+        return failure(
+            StatusCode::BAD_REQUEST,
+            "The native transport cannot change upstream origin",
+        );
+    }
+    let client = {
+        let mut clients = shared.clients.lock().unwrap();
+        if let Some(client) = clients.get(&request.policy) {
+            client.clone()
+        } else {
+            let policy = match request.policy.as_str() {
+                "default" | "default-fallback" => OutboundProxyPolicy::ReqwestDefault,
+                "system" => OutboundProxyPolicy::RespectSystemProxy,
+                _ => return failure(StatusCode::BAD_REQUEST, "Unknown native network policy"),
+            };
+            let mut factory = HttpClientFactory::new(policy);
+            if request.policy == "default-fallback" {
+                factory = factory.with_system_proxy_fallback();
+            }
+            let client = RouteAwareClientPool::new_without_redirects_or_request_logging(
+                factory,
+                ClientRouteClass::Api,
+            )
+            .into_client();
+            clients.insert(request.policy.clone(), client.clone());
+            client
+        }
+    };
+    let builder = match request.method.as_str() {
+        "POST" => client.post(url),
+        "GET" => client.get(url),
+        _ => {
+            return failure(
+                StatusCode::BAD_REQUEST,
+                "Unsupported native transport method",
+            );
+        }
+    }
+    .bearer_auth(&request.api_key)
+    .header("X-Title", "Codex DeepSeek Runtime");
+    let builder = if let Some(payload) = request.payload.as_ref() {
+        builder.json(payload)
+    } else {
+        builder
+    };
+    match builder.send().await {
+        Ok(upstream) => {
+            let mut headers = upstream.headers().clone();
+            for name in [
+                "connection",
+                "keep-alive",
+                "proxy-authenticate",
+                "proxy-authorization",
+                "te",
+                "trailer",
+                "transfer-encoding",
+                "upgrade",
+                "content-length",
+            ] {
+                headers.remove(name);
+            }
+            let status = upstream.status();
+            (status, headers, Body::from_stream(upstream.bytes_stream())).into_response()
+        }
+        Err(error) => {
+            let mut message = error
+                .to_string()
+                .replace(&request.api_key, "[REDACTED]")
+                .replace(&shared.config.token, "[REDACTED]");
+            for name in [
+                "HTTP_PROXY",
+                "HTTPS_PROXY",
+                "ALL_PROXY",
+                "http_proxy",
+                "https_proxy",
+                "all_proxy",
+            ] {
+                if let Ok(proxy) = std::env::var(name) {
+                    if !proxy.is_empty() {
+                        message = message.replace(&proxy, "[REDACTED_PROXY]");
+                    }
+                }
+            }
+            failure(StatusCode::BAD_GATEWAY, &message)
+        }
+    }
+}
+async fn run() -> Result<(), Box<dyn std::error::Error>> {
+    let mut input = Vec::new();
+    tokio::io::stdin()
+        .take(1024 * 1024)
+        .read_to_end(&mut input)
+        .await?;
+    let config: Startup = serde_json::from_slice(&input)?;
+    if config.token.len() < 32 {
+        return Err("Transport token is too short".into());
+    }
+    let origin = Url::parse(&config.upstream)?;
+    if !matches!(origin.scheme(), "http" | "https") {
+        return Err("Invalid native upstream scheme".into());
+    }
+    let parent = config.parent_pid;
+    let shared = Arc::new(Shared {
+        config,
+        origin,
+        clients: Mutex::new(HashMap::new()),
+    });
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let info = serde_json::to_vec(
+        &json!({"port":listener.local_addr()?.port(),"pid":std::process::id()}),
+    )?;
+    let mut stdout = tokio::io::stdout();
+    stdout.write_all(&info).await?;
+    stdout.write_all(b"\n").await?;
+    stdout.flush().await?;
+    let router = Router::new()
+        .route("/forward", post(forward))
+        .layer(DefaultBodyLimit::max(96 * 1024 * 1024))
+        .layer(axum::middleware::from_fn_with_state(shared.clone(), gate))
+        .with_state(shared);
+    let serving = async move { axum::serve(listener, router).await };
+    let parent_lost = async move {
+        loop {
+            #[cfg(unix)]
+            if unsafe { libc::getppid() } as u32 != parent {
+                return;
+            }
+            tokio::time::sleep(Duration::from_millis(250)).await;
+        }
+    };
+    tokio::select! { result=serving => {result?;}, _=parent_lost=>{} }
+    Ok(())
+}
+#[tokio::main]
+async fn main() {
+    if run().await.is_err() {
+        let _ = tokio::io::stderr()
+            .write_all(
+                b"Native HTTP transport failed; no credentials were written to diagnostics.\n",
+            )
+            .await;
+        std::process::exit(1);
+    }
+}
