+//! Opt-in local provider bindings for a dedicated runtime distribution.
+//! Global managed policy keeps its native precedence. Conflicts fail closed.
+use crate::RequirementSource;
+use crate::RequirementsLayerEntry;
+use crate::merge::merge_toml_values;
+use crate::overrides::build_cli_overrides_layer;
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::io;
+use std::path::Path;
+use toml::Value;
+
+fn load(home: &Path) -> io::Result<Option<(AbsolutePathBuf, Value)>> {
+    let Some(selected) = std::env::var_os("CODEX_DEEPSEEK_POLICY_HOME") else {
+        return Ok(None);
+    };
+    if std::fs::canonicalize(&selected)? != std::fs::canonicalize(home)? {
+        return Err(io::Error::other(
+            "Dedicated provider policy does not belong to this CODEX_HOME",
+        ));
+    }
+    let path = AbsolutePathBuf::from_absolute_path(home.join("runtime-policy/config.toml"))?;
+    let contents = std::fs::read_to_string(&path)?;
+    let value: Value = toml::from_str(&contents).map_err(io::Error::other)?;
+    if value.get("model_provider").and_then(Value::as_str) != Some("deepseek_runtime") {
+        return Err(io::Error::other("Invalid dedicated provider policy"));
+    }
+    Ok(Some((path, value)))
+}
+
+pub(crate) fn overrides(
+    home: &Path,
+    incoming: &[(String, Value)],
+) -> io::Result<Vec<(String, Value)>> {
+    let Some((_, pins)) = load(home)? else {
+        return Ok(incoming.to_vec());
+    };
+    let mut value = build_cli_overrides_layer(incoming);
+    merge_toml_values(&mut value, &pins);
+    Ok(value
+        .as_table()
+        .ok_or_else(|| io::Error::other("Invalid provider policy table"))?
+        .iter()
+        .map(|(key, value)| (key.clone(), value.clone()))
+        .collect())
+}
+
+pub(crate) fn defaults(home: &Path, value: Value) -> io::Result<Value> {
+    if load(home)?.is_some() {
+        isolated_defaults(value)
+    } else {
+        Ok(value)
+    }
+}
+
+fn isolated_defaults(mut value: Value) -> io::Result<Value> {
+    let table = value
+        .as_table_mut()
+        .ok_or_else(|| io::Error::other("Packaged defaults must be a table"))?;
+    table.insert("web_search".to_string(), Value::String("live".to_string()));
+    let features = table
+        .entry("features".to_string())
+        .or_insert_with(|| Value::Table(toml::Table::new()))
+        .as_table_mut()
+        .ok_or_else(|| io::Error::other("Packaged feature defaults must be a table"))?;
+    for name in [
+        "code_mode",
+        "code_mode_host",
+        "code_mode_only",
+        "multi_agent_v2",
+    ] {
+        features.insert(name.to_string(), Value::Boolean(true));
+    }
+    Ok(value)
+}
+
+pub(crate) fn requirements(home: &Path) -> io::Result<Option<RequirementsLayerEntry>> {
+    let Some((file, pins)) = load(home)? else {
+        return Ok(None);
+    };
+    let mut required = toml::Table::new();
+    for key in [
+        "model_provider",
+        "model_catalog_json",
+        "sqlite_home",
+        "log_dir",
+    ] {
+        required.insert(
+            key.to_string(),
+            pins.get(key)
+                .ok_or_else(|| io::Error::other("Incomplete dedicated provider policy"))?
+                .clone(),
+        );
+    }
+    Ok(Some(
+        RequirementsLayerEntry::from_toml_value(
+            RequirementSource::SystemRequirementsToml { file },
+            Value::Table(required),
+        )
+        .with_base_dir(AbsolutePathBuf::from_absolute_path(home)?),
+    ))
+}
+
+pub(crate) fn validate_config(home: &Path, actual: &Value) -> io::Result<()> {
+    let Some((_, pins)) = load(home)? else {
+        return Ok(());
+    };
+    for (key, expected) in pins
+        .as_table()
+        .ok_or_else(|| io::Error::other("Invalid provider policy table"))?
+    {
+        let matches = if key == "model_providers" {
+            let actual = actual
+                .get(key)
+                .and_then(|v| v.get("deepseek_runtime"))
+                .ok_or_else(|| io::Error::other("Required provider is absent"))?;
+            let expected = expected
+                .get("deepseek_runtime")
+                .ok_or_else(|| io::Error::other("Policy provider is absent"))?;
+            let mut actual: codex_model_provider_info::ModelProviderInfo =
+                actual.clone().try_into().map_err(io::Error::other)?;
+            let mut expected: codex_model_provider_info::ModelProviderInfo =
+                expected.clone().try_into().map_err(io::Error::other)?;
+            // These public settings control the native transport, not its identity.
+            for provider in [&mut actual, &mut expected] {
+                provider.request_max_retries = None;
+                provider.stream_max_retries = None;
+                provider.stream_idle_timeout_ms = None;
+                provider.websocket_connect_timeout_ms = None;
+            }
+            actual == expected
+        } else if key == "memories" {
+            expected.as_table().is_some_and(|table| {
+                table
+                    .iter()
+                    .all(|(name, wanted)| actual.get(key).and_then(|v| v.get(name)) == Some(wanted))
+            })
+        } else {
+            actual.get(key) == Some(expected)
+        };
+        if !matches {
+            return Err(io::Error::other(format!(
+                "Managed configuration conflicts with isolated provider binding {key}"
+            )));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_requirements(
+    home: &Path,
+    actual: &crate::config_requirements::ConfigRequirementsWithSources,
+) -> io::Result<()> {
+    let Some((_, pins)) = load(home)? else {
+        return Ok(());
+    };
+    if actual
+        .model_provider
+        .as_ref()
+        .map(|item| item.value.as_str())
+        != Some("deepseek_runtime")
+        || actual
+            .model_catalog_json
+            .as_ref()
+            .map(|item| item.value.as_path())
+            != pins
+                .get("model_catalog_json")
+                .and_then(Value::as_str)
+                .map(Path::new)
+        || actual.sqlite_home.as_ref().map(|item| item.value.as_path())
+            != pins
+                .get("sqlite_home")
+                .and_then(Value::as_str)
+                .map(Path::new)
+        || actual.log_dir.as_ref().map(|item| item.value.as_path())
+            != pins.get("log_dir").and_then(Value::as_str).map(Path::new)
+    {
+        return Err(io::Error::other(
+            "System or enterprise policy conflicts with the dedicated provider boundary",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn native_user_settings_override_isolated_feature_defaults() {
+        let mut defaults = isolated_defaults(Value::Table(toml::Table::new())).unwrap();
+        let user:Value = toml::from_str("web_search='disabled'\n[features]\ncode_mode=false\ncode_mode_only=false\nmulti_agent_v2=false\n").unwrap();
+        merge_toml_values(&mut defaults, &user);
+        assert_eq!(defaults["web_search"].as_str(), Some("disabled"));
+        for key in ["code_mode", "code_mode_only", "multi_agent_v2"] {
+            assert_eq!(defaults["features"][key].as_bool(), Some(false));
+        }
