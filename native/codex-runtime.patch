+//! The dedicated provider's loopback URL is IPC, not its logical API destination.
+//! Keep authorization and revocation attached to OpenRouter, while forwarding
+//! the caller's resolved native proxy settings to the native egress worker.
+use crate::{HttpClientBuilder, HttpClientFactory, OutboundProxyPolicy};
+use http::{HeaderMap, HeaderValue};
+use reqwest::Url;
+
+fn bridge_port() -> Option<u16> {
+    std::env::var_os("CODEX_DEEPSEEK_POLICY_HOME")?;
+    std::env::var("CODEX_DEEPSEEK_BRIDGE_PORT")
+        .ok()?
+        .parse()
+        .ok()
+}
+
+fn logical_for_port(url: &Url, port: Option<u16>) -> Option<Url> {
+    if url.scheme() != "http"
+        || url.host_str() != Some("127.0.0.1")
+        || url.port().is_none()
+        || url.port() != port
+    {
+        return None;
+    }
+    let suffix = url.path().strip_prefix("/v1")?;
+    let mut logical = Url::parse("https://openrouter.ai/api/v1").ok()?;
+    logical.set_path(&format!("/api/v1{suffix}"));
+    logical.set_query(url.query());
+    Some(logical)
+}
+
+pub(crate) fn logical_destination(url: &Url) -> Option<Url> {
+    logical_for_port(url, bridge_port())
+}
+
+pub(crate) fn is_bridge(value: &str) -> bool {
+    value
+        .parse::<Url>()
+        .ok()
+        .is_some_and(|url| logical_destination(&url).is_some())
+}
+
+pub(crate) fn headers(factory: &HttpClientFactory, url: &Url) -> HeaderMap {
+    let mut headers = HeaderMap::new();
+    if logical_destination(url).is_some() {
+        let value = match (
+            factory.outbound_proxy_policy(),
+            factory.allows_system_proxy_fallback(),
+        ) {
+            (OutboundProxyPolicy::ReqwestDefault, false) => "default",
+            (OutboundProxyPolicy::ReqwestDefault, true) => "default-fallback",
+            (OutboundProxyPolicy::RespectSystemProxy, _) => "system",
+        };
+        headers.insert(
+            "x-codex-deepseek-network-policy",
+            HeaderValue::from_static(value),
+        );
+    }
+    headers
+}
+
+pub(crate) fn configure(
+    mut builder: HttpClientBuilder,
+    factory: &HttpClientFactory,
+    url: &str,
+) -> HttpClientBuilder {
+    if let Ok(url) = url.parse::<Url>() {
+        let extra = headers(factory, &url);
+        if !extra.is_empty() {
+            builder
+                .default_headers
+                .get_or_insert_with(HeaderMap::new)
+                .extend(extra);
+        }
+    }
+    builder
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn logical_destination_is_exactly_the_owned_provider_origin() {
+        let url = Url::parse("http://127.0.0.1:32123/v1/responses").unwrap();
+        assert_eq!(
+            logical_for_port(&url, Some(32123)).unwrap().as_str(),
+            "https://openrouter.ai/api/v1/responses"
+        );
+        assert!(logical_for_port(&url, Some(32124)).is_none());
+        assert!(
+            logical_for_port(
+                &Url::parse("http://127.0.0.2:32123/v1/responses").unwrap(),
+                Some(32123)
+            )
+            .is_none()
+        );
+        assert!(
+            logical_for_port(
+                &Url::parse("https://example.com/v1/responses").unwrap(),
+                Some(443)
+            )
+            .is_none()
+        );
+    }
+}
